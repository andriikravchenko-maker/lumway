      "blocks": {
        "heading_yFMGAf": {
          "type": "heading",
          "name": "My Jeans Didn’t Need a Smaller Body – I Needed to Feel Comfortable in Mine",
          "settings": {
            "text": "My Jeans Didn’t Need a Smaller Body.I Needed to Feel Comfortable in Mine.",
