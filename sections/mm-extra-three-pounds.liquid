{% comment %}MM Extra Three Pounds — block based section{% endcomment %}
{%- assign sc = 'mm-etp-' | append: section.id -%}
<section id="mm-extra-three-pounds-{{ section.id }}" class="{{ sc }} mm-etp">
  <div class="mm-etp__inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <div
            class="mm-etp__heading-wrap"
            style="--order-d:{{ block.settings.order_desktop }};--order-m:{{ block.settings.order_mobile }};--max-d:{{ block.settings.max_width_desktop }}px;--max-m:{{ block.settings.max_width_mobile }}px;--align-d:{{ block.settings.align_desktop }};--align-m:{{ block.settings.align_mobile }};--color:{{ block.settings.color }};--accent:{{ block.settings.accent_color }};--size-d:{{ block.settings.size_desktop }}px;--size-m:{{ block.settings.size_mobile }}px;--weight:{{ block.settings.weight }};--line-d:{{ block.settings.line_height_desktop }};--line-m:{{ block.settings.line_height_mobile }};--mb-d:{{ block.settings.margin_bottom_desktop }}px;--mb-m:{{ block.settings.margin_bottom_mobile }}px;"
            {{ block.shopify_attributes }}
          >
            <div class="mm-etp__heading-inner">
              {%- if block.settings.heading != blank -%}
                <{{ block.settings.tag }} class="mm-etp__heading">
                  {%- if block.settings.accent_text != blank
                    and block.settings.heading contains block.settings.accent_text
                  -%}
                    {%- capture accent_markup -%}<span class="mm-etp__heading-accent">{{ block.settings.accent_text }}</span>{%- endcapture -%}
                    {{ block.settings.heading | replace: block.settings.accent_text, accent_markup }}
                  {%- else -%}
                    {{ block.settings.heading }}
                  {%- endif -%}
                </{{ block.settings.tag }}>
              {%- endif -%}
            </div>
          </div>

        {%- when 'subtitle' -%}
          <div
            class="mm-etp__subtitle-wrap"
            style="--order-d:{{ block.settings.order_desktop }};--order-m:{{ block.settings.order_mobile }};--max-d:{{ block.settings.max_width_desktop }}px;--max-m:{{ block.settings.max_width_mobile }}px;--align-d:{{ block.settings.align_desktop }};--align-m:{{ block.settings.align_mobile }};--color:{{ block.settings.color }};--size-d:{{ block.settings.size_desktop }}px;--size-m:{{ block.settings.size_mobile }}px;--weight:{{ block.settings.weight }};--line-d:{{ block.settings.line_height_desktop }};--line-m:{{ block.settings.line_height_mobile }};--mt-d:{{ block.settings.margin_top_desktop }}px;--mb-d:{{ block.settings.margin_bottom_desktop }}px;--mt-m:{{ block.settings.margin_top_mobile }}px;--mb-m:{{ block.settings.margin_bottom_mobile }}px;"
            {{ block.shopify_attributes }}
          >
            <div class="mm-etp__subtitle">{{ block.settings.text }}</div>
          </div>

        {%- when 'factor_card' -%}
          <article
            class="mm-etp__card mm-etp__card--{{ block.settings.desktop_width }}"
            style="--order-d:{{ block.settings.order_desktop }};--order-m:{{ block.settings.order_mobile }};--bg:{{ block.settings.background }};--border:{{ block.settings.border_color }};--bw:{{ block.settings.border_width }}px;--radius-d:{{ block.settings.radius_desktop }}px;--radius-m:{{ block.settings.radius_mobile }}px;--pad-d:{{ block.settings.padding_desktop }}px;--pad-m:{{ block.settings.padding_mobile }}px;--badge-bg:{{ block.settings.badge_background }};--badge-color:{{ block.settings.badge_color }};--badge-d:{{ block.settings.badge_size_desktop }}px;--badge-m:{{ block.settings.badge_size_mobile }}px;--title-color:{{ block.settings.title_color }};--title-d:{{ block.settings.title_size_desktop }}px;--title-m:{{ block.settings.title_size_mobile }}px;--title-weight:{{ block.settings.title_weight }};--text-color:{{ block.settings.text_color }};--text-d:{{ block.settings.text_size_desktop }}px;--text-m:{{ block.settings.text_size_mobile }}px;--head-gap:{{ block.settings.header_gap }}px;--body-gap:{{ block.settings.body_gap }}px;"
            {{ block.shopify_attributes }}
          >
            <div class="mm-etp__card-head">
              {%- if block.settings.number != blank -%}
                <span class="mm-etp__badge">{{ block.settings.number }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="mm-etp__card-title">{{ block.settings.title }}</h3>
              {%- endif -%}
            </div>
            {%- if block.settings.text != blank -%}
              <div class="mm-etp__card-text">{{ block.settings.text }}</div>
            {%- endif -%}
          </article>

        {%- when 'footer_text' -%}
          <div
            class="mm-etp__footer"
            style="--order-d:{{ block.settings.order_desktop }};--order-m:{{ block.settings.order_mobile }};--max-d:{{ block.settings.max_width_desktop }}px;--max-m:{{ block.settings.max_width_mobile }}px;--align-d:{{ block.settings.align_desktop }};--align-m:{{ block.settings.align_mobile }};--color:{{ block.settings.color }};--size-d:{{ block.settings.size_desktop }}px;--size-m:{{ block.settings.size_mobile }}px;--line-d:{{ block.settings.line_height_desktop }};--line-m:{{ block.settings.line_height_mobile }};--mt-d:{{ block.settings.margin_top_desktop }}px;--mt-m:{{ block.settings.margin_top_mobile }}px;"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.content }}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% style %}
  .{{ sc }}{background:{{ section.settings.background }};padding:{{ section.settings.padding_top_desktop }}px {{ section.settings.padding_horizontal_desktop }}px {{ section.settings.padding_bottom_desktop }}px}
  .{{ sc }} .mm-etp__inner{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:{{ section.settings.row_gap_desktop }}px {{ section.settings.column_gap_desktop }}px;width:100%;max-width:{{ section.settings.max_width }}px;margin:0 auto}
  .{{ sc }} .mm-etp__heading-wrap,.{{ sc }} .mm-etp__subtitle-wrap,.{{ sc }} .mm-etp__footer{grid-column:1/-1;order:var(--order-d)}
  .{{ sc }} .mm-etp__heading-wrap{margin-bottom:var(--mb-d)}
  .{{ sc }} .mm-etp__heading-inner{max-width:var(--max-d);margin:0 auto;text-align:var(--align-d)}
  .{{ sc }} .mm-etp__heading{margin:0!important;color:var(--color)!important;font-size:var(--size-d)!important;font-weight:var(--weight)!important;line-height:var(--line-d)!important;}
  .{{ sc }} .mm-etp__heading-accent{color:var(--accent)!important}
  .{{ sc }} .mm-etp__subtitle-wrap{margin:var(--mt-d) 0 var(--mb-d)}
  .{{ sc }} .mm-etp__subtitle{max-width:var(--max-d);margin:0 auto;color:var(--color);font-size:var(--size-d);font-weight:var(--weight);line-height:var(--line-d);text-align:var(--align-d);}
  .{{ sc }} .mm-etp__card{order:var(--order-d);box-sizing:border-box;min-width:0;padding:var(--pad-d);background:var(--bg);border:var(--bw) solid var(--border);border-radius:var(--radius-d)}
  .{{ sc }} .mm-etp__card--third{grid-column:span 2}.{{ sc }} .mm-etp__card--half{grid-column:span 3}.{{ sc }} .mm-etp__card--full{grid-column:1/-1}
  .{{ sc }} .mm-etp__card-head{display:flex;align-items:center;gap:var(--head-gap)}
  .{{ sc }} .mm-etp__badge{display:inline-flex;align-items:center;justify-content:center;flex:0 0 var(--badge-d);width:var(--badge-d);height:var(--badge-d);border-radius:50%;background:var(--badge-bg);color:var(--badge-color);font-weight:700;line-height:1}
  .{{ sc }} .mm-etp__card-title{margin:0!important;color:var(--title-color)!important;font-size:var(--title-d)!important;font-weight:var(--title-weight)!important;line-height:1.15!important}
  .{{ sc }} .mm-etp__card-text{margin-top:var(--body-gap)}
  .{{ sc }} .mm-etp__card-text,.{{ sc }} .mm-etp__card-text *{color:var(--text-color)!important;font-size:var(--text-d)!important;line-height:1.45!important}
  .{{ sc }} .mm-etp__card-text p{margin:0!important}
  .{{ sc }} .mm-etp__footer{max-width:var(--max-d);margin:var(--mt-d) auto 0;text-align:var(--align-d)}
  .{{ sc }} .mm-etp__footer,.{{ sc }} .mm-etp__footer *{color:var(--color)!important;font-size:var(--size-d)!important;line-height:var(--line-d)!important}
  .{{ sc }} .mm-etp__footer p{margin:0!important}
  @media(max-width:989px){
    .{{ sc }}{padding:{{ section.settings.padding_top_mobile }}px {{ section.settings.padding_horizontal_mobile }}px {{ section.settings.padding_bottom_mobile }}px}
    .{{ sc }} .mm-etp__inner{display:flex;flex-direction:column;gap:{{ section.settings.row_gap_mobile }}px}
    .{{ sc }} .mm-etp__heading-wrap,.{{ sc }} .mm-etp__subtitle-wrap,.{{ sc }} .mm-etp__card,.{{ sc }} .mm-etp__footer{order:var(--order-m);width:100%}
    .{{ sc }} .mm-etp__heading-wrap{margin-bottom:var(--mb-m)}
    .{{ sc }} .mm-etp__heading-inner{max-width:var(--max-m);text-align:var(--align-m)}
    .{{ sc }} .mm-etp__heading{font-size:var(--size-m)!important;line-height:var(--line-m)!important}
    .{{ sc }} .mm-etp__subtitle-wrap{margin:var(--mt-m) 0 var(--mb-m)}
    .{{ sc }} .mm-etp__subtitle{max-width:var(--max-m);font-size:var(--size-m);line-height:var(--line-m);text-align:var(--align-m)}
    .{{ sc }} .mm-etp__card{padding:var(--pad-m);border-radius:var(--radius-m)}
    .{{ sc }} .mm-etp__badge{flex-basis:var(--badge-m);width:var(--badge-m);height:var(--badge-m)}
    .{{ sc }} .mm-etp__card-title{font-size:var(--title-m)!important}
    .{{ sc }} .mm-etp__card-text,.{{ sc }} .mm-etp__card-text *{font-size:var(--text-m)!important}
    .{{ sc }} .mm-etp__footer{max-width:var(--max-m);margin-top:var(--mt-m);text-align:var(--align-m)}
    .{{ sc }} .mm-etp__footer,.{{ sc }} .mm-etp__footer *{font-size:var(--size-m)!important;line-height:var(--line-m)!important}
  }
{% endstyle %}

