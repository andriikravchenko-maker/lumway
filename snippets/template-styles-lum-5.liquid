{% style %}
  /* =========================================
     PRODUCT — lum-template-5-v1
  ========================================= */
                    {% if template.name == 'product' and template.suffix == 'lum-template-5-v1' %}
                #MainContent .pdl-title {
                  font-family: 'Fraunces', Georgia, serif !important;
                  color: var(--pdl-title-color, #113B34) !important;
                }
                .#MainContent {
                   background: #FFFDFA;
                }
                 #MainContent .xsl__heading,  #MainContent  .ptl__label{
                   font-family: 'Fraunces', Georgia, serif !important;
                   font-size: 20px;
                }
                     .icl__row{
                   box-shadow: 4px 4px 0 0 #FA6C56;
                   border: 1px solid #5B0D1E;
                }
                #MainContent  .ptab-product_tabs_mig .ptab__tab{
                  background: #F5F3EF !important;
                   border: 1px solid black !important;

                }
                 #MainContent  .ptab-product_tabs_mig .ptab__tab.is-active{
                    background: #ffffff !important;
                   }

                 #MainContent  .xsl__card{
                   background: #F5F3EF !important;
                }
                 #MainContent  .ptab__panel-wrap{
                      border: 1px solid black !important;
                      border-top: 0 !important;
                }
                #MainContent  .bsl__input{
                  border:  1px solid #C2C2C2 !important;
                  background: #F5F3EF  !important;
                }
                #MainContent .stats-column-container .stats-section-title, #MainContent  .custom-accent-text{
                  font-family: 'Fraunces', Georgia, serif !important;
                }
                #MainContent  .ingredient-cards__heading, #MainContent  .ingredient-cards__heading-accent{
                   font-family: 'Fraunces', Georgia, serif !important;
                }
                 #MainContent  .ingredient-card__image-wrap{
                  width: 100%;
                  border-radius: 8px;
                }
                #MainContent .ingredient-card__image{
                   border-radius: 8px;
                }
                #MainContent  .ingredient-card{
                  padding: 24px;
                   border: 1px solid #5B0D1E;
                    box-shadow: 4px 4px 0 0 #FA6C56;
                }


              {% endif %}
{% endstyle %}
