<script>
  window.publishMetaAddToCart = function ({
    value,
    currency,
    quantity,
    items
  }) {
    console.log('[Meta ATC] function called', {
      value,
      currency,
      quantity,
      items
    });

    console.trace('[Meta ATC] call source');

    if (
      !window.Shopify ||
      !Shopify.analytics ||
      typeof Shopify.analytics.publish !== 'function'
    ) {
      console.error('[Meta ATC] Shopify.analytics.publish unavailable');
      return;
    }

    const payload = {
      value: Number(value) || 0,
      currency: currency || Shopify.currency?.active || 'USD',
      quantity: Number(quantity) || 1,
      items: Array.isArray(items) ? items : []
    };

    console.log('[Meta ATC] publishing lumway:add_to_cart', payload);

    Shopify.analytics.publish('lumway:add_to_cart', payload);
  };
</script>