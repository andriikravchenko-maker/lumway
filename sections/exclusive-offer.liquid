{% comment %}
Exclusive Offer — rebuilt from the supplied design.

Assets:
- Main image
- Clinicians badge
- Sugar badge
- Certification badge
- Made in USA badge
- Eyebrow gift icon
- Shipping icon
- Gift block icon + image
- Urgency icon
- Trust item icons
- Every payment logo is a separate Payment icon block

Timer:
- Duration is configured with hours/minutes/seconds.
- End timestamp is persisted in localStorage.
- Reload/navigation does not reset it.
- When a cycle expires, the next cycle is calculated from the original cadence.
- Use the same persistence key on other pages to share the same countdown.
{% endcomment %}

<section
        id="ExclusiveOffer-{{ section.id }}"
        class="exclusive-offer"
        data-exclusive-offer
>
    <div class="exclusive-offer__container">
        <div class="exclusive-offer__frame">
            {% if section.settings.offer_label != blank %}
                <div class="exclusive-offer__label">
                    {{ section.settings.offer_label | escape }}
                </div>
            {% endif %}

            <div class="exclusive-offer__grid">
                <div class="exclusive-offer__media">
                    {% if section.settings.main_image != blank %}
                        {{
                        section.settings.main_image
                        | image_url: width: 1400
                        | image_tag:
                        loading: 'lazy',
                        widths: '480, 720, 960, 1200, 1400',
                        sizes: '(max-width: 749px) calc(100vw - 48px), 50vw',
                        class: 'exclusive-offer__main-image'
                        }}
                    {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'exclusive-offer__main-image exclusive-offer__placeholder' }}
                    {% endif %}

                    {% if section.settings.clinicians_badge != blank %}
                        <div class="exclusive-offer__media-badge exclusive-offer__media-badge--clinicians">
                            {{
                            section.settings.clinicians_badge
                            | image_url: width: 900
                            | image_tag: loading: 'lazy', class: 'exclusive-offer__media-badge-image'
                            }}
                        </div>
                    {% endif %}

                    {% if section.settings.sugar_badge != blank %}
                        <div class="exclusive-offer__media-badge exclusive-offer__media-badge--sugar">
                            {{
                            section.settings.sugar_badge
                            | image_url: width: 360
                            | image_tag: loading: 'lazy', class: 'exclusive-offer__media-badge-image'
                            }}
                        </div>
                    {% endif %}

                    {% if section.settings.certification_badge != blank %}
                        <div class="exclusive-offer__media-badge exclusive-offer__media-badge--certification">
                            {{
                            section.settings.certification_badge
                            | image_url: width: 360
                            | image_tag: loading: 'lazy', class: 'exclusive-offer__media-badge-image'
                            }}
                        </div>
                    {% endif %}

                    {% if section.settings.country_badge != blank %}
                        <div class="exclusive-offer__media-badge exclusive-offer__media-badge--country">
                            {{
                            section.settings.country_badge
                            | image_url: width: 600
                            | image_tag: loading: 'lazy', class: 'exclusive-offer__media-badge-image'
                            }}
                        </div>
                    {% endif %}
                </div>

                <div class="exclusive-offer__content">
                    {% if section.settings.eyebrow != blank %}
                        <div class="exclusive-offer__eyebrow">
                            <span class="exclusive-offer__eyebrow-line" aria-hidden="true"></span>

                            {% if section.settings.eyebrow_icon != blank %}
                                {{
                                section.settings.eyebrow_icon
                                | image_url: width: 80
                                | image_tag: loading: 'lazy', class: 'exclusive-offer__eyebrow-icon'
                                }}
                            {% endif %}

                            <span>{{ section.settings.eyebrow | escape }}</span>
                            <span class="exclusive-offer__eyebrow-line" aria-hidden="true"></span>
                        </div>
                    {% endif %}

                    <div class="exclusive-offer__headline">
                        {% if section.settings.discount_text != blank %}
                            <div class="exclusive-offer__discount">
                                {{ section.settings.discount_text | escape }}
                            </div>
                        {% endif %}

                        {% if section.settings.show_plus %}
                            <span class="exclusive-offer__plus" aria-hidden="true">+</span>
                        {% endif %}

                        {% if section.settings.shipping_text != blank %}
                            <div class="exclusive-offer__shipping">
                                {% if section.settings.shipping_icon != blank %}
                                    {{
                                    section.settings.shipping_icon
                                    | image_url: width: 80
                                    | image_tag: loading: 'lazy', class: 'exclusive-offer__shipping-icon'
                                    }}
                                {% endif %}
                                <span>{{ section.settings.shipping_text | escape }}</span>
                            </div>
                        {% endif %}
                    </div>

                    <div class="exclusive-offer__gifts">
                        {% for block in section.blocks %}
                            {% if block.type == 'gift' %}
                                <div
                                        class="exclusive-offer__gift"
                                        style="
                                                --gift-bg: {{ block.settings.background }};
                                                --gift-border: {{ block.settings.border_color }};
                                                --gift-title: {{ block.settings.title_color }};
                                                --gift-text: {{ block.settings.text_color }};
                                                --gift-icon-bg: {{ block.settings.icon_background }};
                                                --gift-icon-border: {{ block.settings.icon_border_color }};
                                                --gift-title-d: {{ block.settings.title_size_desktop }}px;
                                                --gift-title-m: {{ block.settings.title_size_mobile }}px;
                                                --gift-title-weight: {{ block.settings.title_weight }};
                                                --gift-text-d: {{ block.settings.text_size_desktop }}px;
                                                --gift-text-m: {{ block.settings.text_size_mobile }}px;
                                                --gift-text-weight: {{ block.settings.text_weight }};
                                                --gift-icon-d: {{ block.settings.icon_size_desktop }}px;
                                                --gift-icon-m: {{ block.settings.icon_size_mobile }}px;
                                                --gift-image-d: {{ block.settings.image_width_desktop }}px;
                                                --gift-image-m: {{ block.settings.image_width_mobile }}px;
                                                "
                                        {{ block.shopify_attributes }}
                                >
                                    {% if block.settings.icon != blank %}
                                        <div class="exclusive-offer__gift-icon-shell">
                                            {{
                                            block.settings.icon
                                            | image_url: width: 100
                                            | image_tag: loading: 'lazy', class: 'exclusive-offer__gift-icon'
                                            }}
                                        </div>
                                    {% endif %}

                                    {% if block.settings.image != blank %}
                                        <div class="exclusive-offer__gift-media">
                                            {{
                                            block.settings.image
                                            | image_url: width: 300
                                            | image_tag: loading: 'lazy', class: 'exclusive-offer__gift-image'
                                            }}
                                        </div>
                                    {% endif %}

                                    <div class="exclusive-offer__gift-copy">
                                        {% if block.settings.title != blank %}
                                            <div class="exclusive-offer__gift-title">
                                                {{ block.settings.title | escape }}
                                            </div>
                                        {% endif %}

                                        {% if block.settings.text != blank %}
                                            <div class="exclusive-offer__gift-text">
                                                {{ block.settings.text }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>

                    {% if section.settings.enable_countdown %}
                        <div class="exclusive-offer__countdown-wrap">
                            {% if section.settings.countdown_title != blank %}
                                <div class="exclusive-offer__countdown-title">
                                    {{ section.settings.countdown_title | escape }}
                                </div>
                            {% endif %}

                            <div
                                    class="exclusive-offer__countdown"
                                    data-exclusive-countdown
                                    data-duration-hours="{{ section.settings.timer_hours }}"
                                    data-duration-minutes="{{ section.settings.timer_minutes }}"
                                    data-duration-seconds="{{ section.settings.timer_seconds }}"
                                    data-storage-key="{{ section.settings.timer_storage_key | escape }}"
                            >
                                <div class="exclusive-offer__time">
                                    <span class="exclusive-offer__time-value" data-hours>00</span>
                                    <span class="exclusive-offer__time-label">{{ section.settings.hours_label | escape }}</span>
                                </div>

                                <div class="exclusive-offer__time">
                                    <span class="exclusive-offer__time-value" data-minutes>00</span>
                                    <span class="exclusive-offer__time-label">{{ section.settings.minutes_label | escape }}</span>
                                </div>

                                <div class="exclusive-offer__time">
                                    <span class="exclusive-offer__time-value" data-seconds>00</span>
                                    <span class="exclusive-offer__time-label">{{ section.settings.seconds_label | escape }}</span>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    {% if section.settings.urgency_text != blank or section.settings.urgency_highlight != blank %}
                        <div class="exclusive-offer__urgency">
                            {% if section.settings.urgency_icon != blank %}
                                {{
                                section.settings.urgency_icon
                                | image_url: width: 80
                                | image_tag: loading: 'lazy', class: 'exclusive-offer__urgency-icon'
                                }}
                            {% endif %}

                            {% if section.settings.urgency_text != blank %}
                                <span>{{ section.settings.urgency_text | escape }}</span>
                            {% endif %}

                            {% if section.settings.urgency_highlight != blank %}
                                <strong>{{ section.settings.urgency_highlight | escape }}</strong>
                            {% endif %}
                        </div>
                    {% endif %}

                    {% if section.settings.button_label != blank %}
                        {% if section.settings.button_link != blank %}
                            <a href="{{ section.settings.button_link }}" class="exclusive-offer__cta">
                                {{ section.settings.button_label | escape }}
                            </a>
                        {% elsif section.settings.offer_product != blank %}
                            <a href="{{ section.settings.offer_product.url }}" class="exclusive-offer__cta">
                                {{ section.settings.button_label | escape }}
                            </a>
                        {% endif %}
                    {% endif %}

                    <div class="exclusive-offer__trust">
                        {% for block in section.blocks %}
                            {% if block.type == 'trust_item' %}
                                <div
                                        class="exclusive-offer__trust-item"
                                        style="
                                                --trust-color: {{ block.settings.text_color }};
                                                --trust-size-d: {{ block.settings.text_size_desktop }}px;
                                                --trust-size-m: {{ block.settings.text_size_mobile }}px;
                                                --trust-weight: {{ block.settings.text_weight }};
                                                --trust-icon-d: {{ block.settings.icon_size_desktop }}px;
                                                --trust-icon-m: {{ block.settings.icon_size_mobile }}px;
                                                "
                                        {{ block.shopify_attributes }}
                                >
                                    {% if block.settings.icon != blank %}
                                        {{
                                        block.settings.icon
                                        | image_url: width: 80
                                        | image_tag: loading: 'lazy', class: 'exclusive-offer__trust-icon'
                                        }}
                                    {% endif %}

                                    {% if block.settings.text != blank %}
                                        <span>{{ block.settings.text | escape }}</span>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>

                    <div class="exclusive-offer__payments" aria-label="Accepted payment methods">
                        {% for block in section.blocks %}
                            {% if block.type == 'payment_icon' and block.settings.image != blank %}
                                <div
                                        class="exclusive-offer__payment"
                                        style="
                                                --payment-width-d: {{ block.settings.width_desktop }}px;
                                                --payment-width-m: {{ block.settings.width_mobile }}px;
                                                --payment-height-d: {{ block.settings.height_desktop }}px;
                                                --payment-height-m: {{ block.settings.height_mobile }}px;
                                                --payment-bg: {{ block.settings.background }};
                                                --payment-border: {{ block.settings.border_color }};
                                                "
                                        {{ block.shopify_attributes }}
                                >
                                    {{
                                    block.settings.image
                                    | image_url: width: 220
                                    | image_tag:
                                    loading: 'lazy',
                                    alt: block.settings.alt,
                                    class: 'exclusive-offer__payment-image'
                                    }}
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{% style %}
    #ExclusiveOffer-{{ section.id }} {
    --eo-section-bg: {{ section.settings.section_background }};
    --eo-frame-bg: {{ section.settings.frame_background }};
    --eo-frame-border: {{ section.settings.frame_border_color }};
    --eo-label-bg: {{ section.settings.label_background }};
    --eo-label-border: {{ section.settings.label_border_color }};
    --eo-label-text: {{ section.settings.label_text_color }};
    --eo-body-text: {{ section.settings.body_text_color }};
    --eo-eyebrow: {{ section.settings.eyebrow_color }};
    --eo-discount: {{ section.settings.discount_color }};
    --eo-shipping-bg: {{ section.settings.shipping_background }};
    --eo-shipping-border: {{ section.settings.shipping_border_color }};
    --eo-shipping-text: {{ section.settings.shipping_text_color }};
    --eo-timer-title: {{ section.settings.timer_title_color }};
    --eo-timer-bg: {{ section.settings.timer_background }};
    --eo-timer-number: {{ section.settings.timer_number_color }};
    --eo-timer-label: {{ section.settings.timer_label_color }};
    --eo-urgency-bg: {{ section.settings.urgency_background }};
    --eo-urgency-text: {{ section.settings.urgency_text_color }};
    --eo-urgency-highlight: {{ section.settings.urgency_highlight_color }};
    --eo-cta-bg: {{ section.settings.button_background }};
    --eo-cta-text: {{ section.settings.button_text_color }};

    width: 100%;
    padding: {{ section.settings.padding_top_desktop }}px 20px {{ section.settings.padding_bottom_desktop }}px;
    background: var(--eo-section-bg);
    color: var(--eo-body-text);
    }

    #ExclusiveOffer-{{ section.id }} * {
    box-sizing: border-box;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__container {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__frame {
    position: relative;
    padding: {{ section.settings.frame_padding_desktop }}px;
    border: {{ section.settings.frame_border_width }}px dashed var(--eo-frame-border);
    border-radius: {{ section.settings.frame_radius }}px;
    background: var(--eo-frame-bg);
    }
     #ExclusiveOffer-{{ section.id }} .exclusive-offer__frame {
            padding-top: 56px;
     }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__label {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 1;
    min-width: 296px;
    padding: 10px 28px;
    border: {{ section.settings.label_border_width }}px solid var(--eo-label-border);
    border-radius: {{ section.settings.label_radius }}px;
    background: var(--eo-label-bg);
    color: var(--eo-label-text);
    font-size: {{ section.settings.label_size_desktop }}px;
    font-weight: {{ section.settings.label_weight }} !important;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    transform: translate(-50%, -50%);
    }
    #ExclusiveOffer-{{ section.id }} .exclusive-offer__grid {
    display: grid;
    grid-template-columns: minmax(0, {{ section.settings.media_column }}fr) minmax(0, 1fr);
    gap: {{ section.settings.column_gap_desktop }}px;
    align-items: stretch;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__media {
    position: relative;
    overflow: hidden;
    min-width: 0;
    width: 100%;
    aspect-ratio: 1 / 1;
    align-self: center;
    border-radius: {{ section.settings.media_radius }}px;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__main-image,
    #ExclusiveOffer-{{ section.id }} .exclusive-offer__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position:
    {{ section.settings.image_position_x }}%
    {{ section.settings.image_position_y }}%;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__placeholder {
    background: #f4f4f4;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__media-badge {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__media-badge-image {
    display: block;
    width: 100%;
    height: auto;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__media-badge--clinicians {
    top: {{ section.settings.clinicians_top }}%;
    left: {{ section.settings.clinicians_left }}%;
    width: {{ section.settings.clinicians_width }}%;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__media-badge--sugar {
    top: {{ section.settings.sugar_top }}%;
    right: {{ section.settings.sugar_right }}%;
    width: {{ section.settings.sugar_width }}%;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__media-badge--certification {
    top: {{ section.settings.certification_top }}%;
    right: {{ section.settings.certification_right }}%;
    width: {{ section.settings.certification_width }}%;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__media-badge--country {
    bottom: {{ section.settings.country_bottom }}%;
    left: {{ section.settings.country_left }}%;
    width: {{ section.settings.country_width }}%;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__content {
    min-width: 0;
    padding-inline: {{ section.settings.content_padding_desktop }}px;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 25px;
    color: var(--eo-eyebrow);
    font-size: {{ section.settings.eyebrow_size_desktop }}px;
    font-weight: {{ section.settings.eyebrow_weight }} !important;
    line-height: 1.2;
    text-align: center;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__eyebrow-line {
    width: 36px;
    height: 1px;
    flex: 0 0 36px;
    background: currentColor;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__eyebrow-icon {
    display: block;
    width: {{ section.settings.eyebrow_icon_desktop }}px;
    height: {{ section.settings.eyebrow_icon_desktop }}px;
    object-fit: contain;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__headline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    margin-bottom: 38px;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__discount {
    color: var(--eo-discount);
    font-size: {{ section.settings.discount_size_desktop }}px;
    font-weight: {{ section.settings.discount_weight }} !important;
    line-height: .9;
    letter-spacing: -.045em;
    white-space: nowrap;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__plus {
    color: var(--eo-discount);
    font-size: {{ section.settings.plus_size_desktop }}px;
    font-weight: {{ section.settings.plus_weight }} !important;
    line-height: 1;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__shipping {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border: {{ section.settings.shipping_border_width }}px dashed var(--eo-shipping-border);
    border-radius: {{ section.settings.shipping_radius }}px;
    background: var(--eo-shipping-bg);
    color: var(--eo-shipping-text);
    font-size: {{ section.settings.shipping_size_desktop }}px;
    font-weight: {{ section.settings.shipping_weight }} !important;
    line-height: 1;
    white-space: nowrap;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__shipping-icon {
    display: block;
    width: {{ section.settings.shipping_icon_desktop }}px;
    height: {{ section.settings.shipping_icon_desktop }}px;
    object-fit: contain;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__gifts {
    display: grid;
    gap: 18px;
    margin-bottom: 27px;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__gift {
    position: relative;
    display: flex;
    min-height: 88px;
    align-items: center;
    gap: 15px;
    
    border: 2px dashed var(--gift-border);
    border-radius: 11px;
    background: var(--gift-bg);
    }

     #ExclusiveOffer-{{ section.id }} .exclusive-offer__gift {
        padding: 10px 16px;
        width: max-content;
  margin: 0 auto;
     }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__gift-icon-shell {
    position: absolute;
    top: 0;
    left: 50%;
    display: flex;
    width: calc(var(--gift-icon-d) + 16px);
    height: calc(var(--gift-icon-d) + 16px);
    align-items: center;
    justify-content: center;
    border: 1px solid var(--gift-icon-border);
    border-radius: 50%;
    background: var(--gift-icon-bg);
    transform: translate(-50%, -50%);
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__gift-icon {
    display: block;
    width: var(--gift-icon-d);
    height: var(--gift-icon-d);
    object-fit: contain;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__gift-media {
    width: var(--gift-image-d);
    flex: 0 0 var(--gift-image-d);
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__gift-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__gift-copy {
    min-width: 0;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__gift-title {
    margin-bottom: 3px;
    color: var(--gift-title);
    font-size: var(--gift-title-d);
    font-weight: var(--gift-title-weight) !important;
    line-height: 1.25;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__gift-text {
    color: var(--gift-text);
    font-size: var(--gift-text-d);
    font-weight: var(--gift-text-weight) !important;
    line-height: 1.4;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__gift-text p {
    margin: 0;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__countdown-wrap {
    margin-bottom: 22px;
    text-align: center;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__countdown-title {
    margin-bottom: 9px;
    color: var(--eo-timer-title);
    font-size: {{ section.settings.timer_title_size_desktop }}px;
    font-weight: {{ section.settings.timer_title_weight }} !important;
    line-height: 1.2;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__countdown {
    display: flex;
    justify-content: center;
    gap: 7px;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__time {
    width: {{ section.settings.timer_card_width_desktop }}px;
    flex: 0 0 {{ section.settings.timer_card_width_desktop }}px;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__time-value {
    display: flex;
    width: 100%;
    height: {{ section.settings.timer_card_height_desktop }}px;
    align-items: center;
    justify-content: center;
    border-radius: {{ section.settings.timer_radius }}px;
    background: var(--eo-timer-bg);
    color: var(--eo-timer-number);
    font-size: {{ section.settings.timer_number_size_desktop }}px;
    font-weight: {{ section.settings.timer_number_weight }} !important;
    line-height: 1;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__time-label {
    display: block;
    margin-top: 6px;
    color: var(--eo-timer-label);
    font-size: {{ section.settings.timer_label_size_desktop }}px;
    font-weight: {{ section.settings.timer_label_weight }} !important;
    line-height: 1.2;
    }

    #ExclusiveOffer-{{ section.id }} .exclusive-offer__urgency {
    display: flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin: 0 auto 24px;
    padding: 8px 14px;
    border-radius: {{ section.settings.urgency_radius }}px;
    background: var(--eo-urgency-bg);
