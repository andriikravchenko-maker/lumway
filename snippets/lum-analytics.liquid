{% comment %} Direct Cart Drawer → Checkout + Amplitude tracking {% endcomment %}

(function () {
function userEmail() {
if (window.__lumCustomerId) {
return String(window.__lumCustomerId);
}

var meta =
window.ShopifyAnalytics &&
window.ShopifyAnalytics.meta &&
window.ShopifyAnalytics.meta.page;

if (meta && meta.customerId) {
return String(meta.customerId);
}

return null;
}

function uniqArr(arr) {
var seen = {};
var out = [];

arr.forEach(function (value) {
if (value && !seen[value]) {
seen[value] = true;
out.push(value);
}
});

return out;
}

function newIntentId() {
return (
'ci_' +
Date.now().toString(36) +
'_' +
Math.random().toString(36).slice(2, 10)
);
}

function sleep(ms) {
return new Promise(function (resolve) {
setTimeout(resolve, ms);
});
}

// =====================================================================
// AMPLITUDE TRACK + FORCE FLUSH
// =====================================================================

async function trackAndFlush(eventName, properties) {
try {
var trackResult = track(eventName, properties);

// Amplitude Browser SDK track() usually returns an object
// containing .promise. If our wrapper exposes it, wait for it.
if (
trackResult &&
trackResult.promise &&
typeof trackResult.promise.then === 'function'
) {
await Promise.race([
trackResult.promise,
sleep(1200),
]);
} else if (
trackResult &&
typeof trackResult.then === 'function'
) {
await Promise.race([
trackResult,
sleep(1200),
]);
}

// If Amplitude SDK is globally available, force its queued
// events to be sent before leaving the storefront.
if (
window.amplitude &&
typeof window.amplitude.flush === 'function'
) {
var flushResult = window.amplitude.flush();

if (
flushResult &&
flushResult.promise &&
typeof flushResult.promise.then === 'function'
) {
await Promise.race([
flushResult.promise,
sleep(1200),
]);
} else if (
flushResult &&
typeof flushResult.then === 'function'
) {
await Promise.race([
flushResult,
sleep(1200),
]);
}
} else if (
typeof amplitude !== 'undefined' &&
amplitude &&
typeof amplitude.flush === 'function'
) {
var localFlushResult = amplitude.flush();

if (
localFlushResult &&
localFlushResult.promise &&
typeof localFlushResult.promise.then === 'function'
) {
await Promise.race([
localFlushResult.promise,
sleep(1200),
]);
} else if (
localFlushResult &&
typeof localFlushResult.then === 'function'
) {
await Promise.race([
localFlushResult,
sleep(1200),
]);
}
} else {
// Fallback for wrappers where flush is not exposed.
// Gives the transport a short chance to create the HTTP request.
await sleep(500);
}
} catch (e) {
console.error(
'[Lum Analytics] checkout tracking failed:',
e
);
}
}

// =====================================================================
// CHECKOUT INTENT
// =====================================================================

function getIntentId() {
var existing =
sessionStorage.getItem('__lum_intent');

if (existing) {
return existing;
}

var intentId = newIntentId();

sessionStorage.setItem(
'__lum_intent',
intentId
);

return intentId;
}

async function writeIntent() {
var intentId = getIntentId();

try {
await fetch('/cart/update.js', {
method: 'POST',
headers: {
'Content-Type': 'application/json',
Accept: 'application/json',
},
body: JSON.stringify({
attributes: {
lum_checkout_intent_id: intentId,
lum_checkout_click_ts: String(Date.now()),
},
}),
});
} catch (e) {}

return intentId;
}

// =====================================================================
// WRITE INTENT WHEN CART DRAWER OPENS
// =====================================================================

var drawer = document.querySelector(
'cart-drawer, #CartDrawer, #cart-drawer'
);

if (drawer && 'MutationObserver' in window) {
var wasOpen = false;

new MutationObserver(function () {
var isOpen =
drawer.classList.contains('active') ||
drawer.classList.contains('animate') ||
drawer.classList.contains('open') ||
drawer.hasAttribute('open');

if (isOpen && !wasOpen) {
writeIntent();
}

wasOpen = isOpen;
}).observe(drawer, {
attributes: true,
attributeFilter: ['class', 'open'],
});
}

// =====================================================================
// CHECKOUT CLICK
// =====================================================================

var checkoutProcessing = false;

document.addEventListener(
'click',
async function (e) {
var btn = e.target.closest(
'#CartDrawer-Checkout, [name="checkout"], .cart__checkout-button'
);

if (!btn) {
return;
}

if (checkoutProcessing) {
return;
}

// Prevent native form submit to /cart.
e.preventDefault();
e.stopPropagation();
e.stopImmediatePropagation();

checkoutProcessing = true;

var intentId = getIntentId();

// =================================================================
// MAKE SURE INTENT EXISTS IN SHOPIFY CART
// =================================================================

try {
await fetch('/cart/update.js', {
method: 'POST',
headers: {
'Content-Type': 'application/json',
Accept: 'application/json',
},
body: JSON.stringify({
attributes: {
lum_checkout_intent_id: intentId,
lum_checkout_click_ts: String(Date.now()),
},
}),
});
} catch (e) {}

// =================================================================
// GET CURRENT CART
// =================================================================

var cart;

try {
var response = await fetch('/cart.js', {
method: 'GET',
headers: {
Accept: 'application/json',
},
cache: 'no-store',
});

cart = await response.json();
} catch (e) {
cart = null;
}

// =================================================================
// BUILD + SEND EVENT
// =================================================================

if (cart) {
var lines = cart.items || [];
var original = 0;
var discounted = 0;

lines.forEach(function (line) {
original +=
(line.original_line_price != null
? line.original_line_price
: line.line_price) || 0;

discounted +=
(line.final_line_price != null
? line.final_line_price
: line.line_price) || 0;
});

var discountCents = Math.max(
0,
original - discounted
);

var uid = userEmail();

var props = {
checkout_intent_id: intentId,

cart_value:
(cart.total_price || 0) / 100,

currency:
cart.currency ||
(
window.Shopify &&
Shopify.currency &&
Shopify.currency.active
) ||
'USD',

items_number:
cart.item_count,

has_subscription:
lines.some(function (line) {
return !!line.selling_plan_allocation;
}),

product_ids:
uniqArr(
lines.map(function (line) {
return (
line.sku ||
String(line.product_id)
);
})
),

product_names:
uniqArr(
lines.map(function (line) {
return (
line.product_title ||
line.title
);
})
),

is_logged_in:
!!uid,
};

if (discountCents > 0) {
props.discount_amount =
Math.round(discountCents) / 100;

if (original > 0) {
props.discount_percent =
Math.round(
(discountCents / original) * 100
);
}
}

await trackAndFlush(
'secure_checkout_button_clicked',
props
);
} else {
await trackAndFlush(
'secure_checkout_button_clicked',
{
checkout_intent_id: intentId,
}
);
}

// =================================================================
// DIRECT CHECKOUT
// =================================================================
//
// At this point track() was called and Amplitude flush was attempted.
// Do not submit CartDrawer-Form because its action is /cart.
// =================================================================

window.location.assign('/checkout');
},
true
);

// =====================================================================
// KEEP INTENT WHEN LEAVING FOR CHECKOUT
// =====================================================================

window.addEventListener(
'pagehide',
function () {
// Keep __lum_intent for checkout correlation.
}
);
})();


// =====================================================================
// quantity_option_selected (PDP buy-box pack selector)
// =====================================================================
(function () {
if (!document.querySelector('.bsl__input')) return;

function variantsOf() {
var node = document.querySelector('.bsl-variants') || document.querySelector('.patc-variants');
try { return JSON.parse(node.textContent) || []; } catch (e) { return []; }
}
function variantById(vs, id) {
for (var i = 0; i < vs.length; i++) { if (String(vs[i].id) === String(id)) return vs[i]; }
return vs[0] || null;
}
function productName(v) {
if (!v) return undefined;
return (v.name || v.title || '').replace(/\s*-\s*\d+\s*Jars?$/i, '') || undefined;
}
function packLabel(total) {
var n = total > 0 ? total : 1;
return n + (n === 1 ? '-jar' : '-jars');
}
function offerName(card) {
var slug = card ? (card.getAttribute('data-offer') || '') : '';
return slug ? slug.replace(/-/g, '_') : undefined;
}

document.addEventListener('change', function (e) {
var t = e.target;
if (!t.classList || !t.classList.contains('bsl__input')) return;

setTimeout(function () {
var card = t.closest('.bsl__card');
var total = card ? parseInt(card.getAttribute('data-pack-total'), 10) : 0;
var vs = variantsOf();
var v = variantById(vs, t.value);
var sku = v ? (v.sku || (vs[0] && vs[0].sku)) : null;

var props = {
product_id: sku || undefined,
product_name: productName(v),
quantity: total > 0 ? total : 1,
variant_id: packLabel(total)
};
var offer = offerName(card);
if (offer) props.offer_name = offer;

track('quantity_option_selected', props);
}, 0);
}, true);
})();

