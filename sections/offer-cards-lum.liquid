<script>
  (function () {
    function init() {
      var roots = document.querySelectorAll('[data-ocl]');
      for (var i = 0; i < roots.length; i++) bind(roots[i]);
      queueSticky();
    }
    if (window.__oclBound) { if (typeof window.__oclInit === 'function') window.__oclInit(); return; }
    window.__oclBound = true;
    window.__oclInit = init;

    function post(url, body) {
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        credentials: 'same-origin',
        body: JSON.stringify(body || {})
      }).then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok && !(d && d.status), data: d }; });
      });
    }

    // Same seam as snippets/lum-analytics: a 'lum:analytics' DOM event + Amplitude. Resolves when the event is out (1.2 s at most).
    function track(name, props) {
      try { document.dispatchEvent(new CustomEvent('lum:analytics', { detail: { event: name, properties: props } })); } catch (e) {}
      try {
        var a = window.amplitude, fn = null, ctx = null;
        if (a && typeof a.track === 'function') { fn = a.track; ctx = a; }
        else if (a && a.default && typeof a.default.track === 'function') { fn = a.default.track; ctx = a.default; }
        if (!fn) return Promise.resolve();
        var res = fn.call(ctx, name, props);
        var p = res && res.promise && typeof res.promise.then === 'function' ? res.promise : (res && typeof res.then === 'function' ? res : null);
        if (!p) return Promise.resolve();
        return Promise.race([p.catch(function () {}), new Promise(function (r) { setTimeout(r, 1200); })]);
      } catch (e) { return Promise.resolve(); }
    }

    // One lock for the whole page: a page can carry two of these sections, and a click in the second one
    // while the first is still adding would put two subscriptions into the cart.
    function lock(on) {
      window.__oclBusy = on;
      var roots = document.querySelectorAll('[data-ocl]');
      for (var r = 0; r < roots.length; r++) {
        roots[r].classList.toggle('is-busy', on);
        if (on) continue;
        var all = roots[r].querySelectorAll('[data-ocl-buy]');
        for (var i = 0; i < all.length; i++) { all[i].classList.remove('is-loading'); all[i].removeAttribute('aria-disabled'); }
      }
    }
    function release() { lock(false); }

    function fail(root, btn, cfg, message) {
      var item = btn.closest('.ocl__item');
      var box = item && item.querySelector('.ocl__error');
      if (box) { box.textContent = message || cfg.errorText || ''; box.hidden = !box.textContent; }
      release();
    }

    function buy(root, cfg, btn) {
      if (window.__oclBusy || window.__oclLeaving) return;
      lock(true);
      btn.classList.add('is-loading');
      btn.setAttribute('aria-disabled', 'true');
      var errors = root.querySelectorAll('.ocl__error');
      for (var e = 0; e < errors.length; e++) { errors[e].hidden = true; errors[e].textContent = ''; }

      var base = cfg.root || '/';
      var variantId = Number(btn.getAttribute('data-variant-id'));
      var planId = btn.getAttribute('data-plan-id');
      var giftId = btn.getAttribute('data-gift-id');
      var pack = Number(btn.getAttribute('data-pack')) || 1;
      var months = btn.getAttribute('data-months');
      var main = { id: variantId, quantity: 1 };
      if (planId) main.selling_plan = Number(planId);
      var items = [main];
      if (giftId) items.push({ id: Number(giftId), quantity: 1, properties: { _lum_gift: 'true', _lum_gift_owner: String(variantId) } });

      var start = cfg.cartMode === 'replace' ? post(base + 'cart/clear.js').catch(function () { return null; }) : Promise.resolve(null);
      start
        .then(function () { return post(base + 'cart/add.js', { items: items }); })
        .then(function (res) {
          // Shopify rejects the whole request when one line cannot be added: never let a gift block the purchase.
          if (!res.ok && items.length > 1) return post(base + 'cart/add.js', { items: [main] });
          return res;
        })
        .then(function (res) {
          if (!res.ok) { fail(root, btn, cfg, (res.data && (res.data.description || res.data.message)) || ''); return null; }
          var waits = [];
          var props = {
            product_id: cfg.sku || undefined,
            product_name: cfg.productName || undefined,
            variant_id: pack + (pack === 1 ? '-jar' : '-jars'),
            price: Math.round(Number(btn.getAttribute('data-price')) || 0) / 100,
            quantity: 1,
            currency: cfg.currency || (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD',
            purchase_type: planId ? 'subscription' : 'one_time',
            offer_source: cfg.source
          };
          if (planId && months) props.subscription_type = months + '-month';
          if (cfg.placement) props.offer_placement = cfg.placement;
          waits.push(track('product_added_to_cart', props));
          try {
            document.dispatchEvent(new CustomEvent('lum:before-checkout', {
              detail: {
                source: cfg.source,
                variantId: variantId,
                wait: function (p) { if (p && typeof p.then === 'function') waits.push(p.catch(function () {})); }
              }
            }));
          } catch (e1) {}
          window.__oclLeaving = true;
          return Promise.race([Promise.all(waits), new Promise(function (r) { setTimeout(r, 2500); })]).then(function () {
            window.location.assign(base + 'checkout');
            return true;
          });
        })
        .catch(function () { fail(root, btn, cfg, ''); });
    }

    // Sticky CTA of the page (the listicle "Sticky Add to Cart" block). Its own script only knows the older landing
    // templates and the product buy box, so with the section setting on this section drives it: the button follows
    // the shopper everywhere except while an offer block is on screen, and a tap scrolls to the nearest offer block.
    var stickyBar = null, stickyTick = false, stickyAfterFirst = true;
    var stickyIo = ('IntersectionObserver' in window) ? new IntersectionObserver(queueSticky, { threshold: 0 }) : null;
    function firstOnScreen() { // the page's first content section (the hero): its own button must not sit under a sticky bar
      var hero = document.querySelector('.gut-harmony-benefits'), sec = hero ? (hero.closest('.shopify-section') || hero) : null;
      if (!sec) { var all = document.querySelectorAll('#MainContent .shopify-section'); for (var i = 0; i < all.length; i++) { if (all[i].offsetHeight > 50) { sec = all[i]; break; } } }
      return !!sec && sec.getBoundingClientRect().bottom > 0;
    }
    function offerOnScreen() {
      var roots = document.querySelectorAll('[data-ocl]');
      for (var i = 0; i < roots.length; i++) {
        var r = roots[i].getBoundingClientRect();
        if (r.height > 0 && r.bottom > 0 && r.top < window.innerHeight) return true;
      }
      return false;
    }
    function nearestOffer() {
      var roots = document.querySelectorAll('[data-ocl]'), best = null, dist = Infinity;
      for (var i = 0; i < roots.length; i++) {
        var r = roots[i].getBoundingClientRect();
        if (r.height > 0 && Math.abs(r.top) < dist) { dist = Math.abs(r.top); best = roots[i]; }
      }
      return best;
    }
    function drawerOpen() {
      var d = document.querySelector('cart-drawer');
      return !!(d && d.classList.contains('active'));
    }
    function onStickyClick(ev) {
      var el = ev.target.closest('a, button');
      if (!el || !stickyBar || !stickyBar.contains(el)) return;
      var target = nearestOffer();
      if (!target) return; // no offer block on the page: the link works as set in the block
      ev.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function stickyEl() {
      if (stickyBar && document.body.contains(stickyBar)) return stickyBar;
      stickyBar = null;
      var roots = document.querySelectorAll('[data-ocl]'), sel = '';
      for (var i = 0; i < roots.length; i++) { var c = roots[i].__oclCfg; if (c && c.sticky && c.stickySelector) { sel = c.stickySelector; stickyAfterFirst = c.stickyAfterFirst !== false; break; } }
      if (!sel) return null;
      var el = null;
      try { el = document.querySelector(sel); } catch (e) {}
      if (!el) return null;
      if (el.parentNode !== document.body) document.body.appendChild(el); // position: fixed breaks inside animated ancestors
      el.addEventListener('click', onStickyClick);
      stickyBar = el;
      return el;
    }
    function updateSticky() {
      stickyTick = false;
      var el = stickyEl();
      if (el) el.classList.toggle('is-lto-hidden', offerOnScreen() || drawerOpen() || (stickyAfterFirst && firstOnScreen()));
    }
    function queueSticky() {
      if (stickyTick) return;
      stickyTick = true;
      window.requestAnimationFrame(updateSticky);
    }
    window.addEventListener('scroll', queueSticky, { passive: true });
    window.addEventListener('resize', queueSticky);
    window.addEventListener('load', queueSticky);
    (function () {
      var d = document.querySelector('cart-drawer');
      if (d && 'MutationObserver' in window) new MutationObserver(queueSticky).observe(d, { attributes: true, attributeFilter: ['class'] });
    })();

    function bind(root) {
      if (root.__oclReady) return;
      var node = root.querySelector('[data-ocl-config]');
      if (!node) return;
      var cfg = {};
      try { cfg = JSON.parse(node.textContent) || {}; } catch (e) {}
      root.__oclReady = true;
      root.__oclCfg = cfg;
      if (stickyIo) stickyIo.observe(root);
      root.addEventListener('click', function (ev) {
        var btn = ev.target.closest('[data-ocl-buy]');
        if (!btn || !root.contains(btn)) return;
        ev.preventDefault();
        buy(root, cfg, btn);
      });
    }

    // Back from the checkout: the page may come from the back/forward cache with the buttons still locked.
    window.addEventListener('pageshow', function (ev) {
      if (!ev.persisted) return;
      window.__oclLeaving = false;
      release();
    });
    document.addEventListener('shopify:section:load', function () { setTimeout(init, 60); });
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>

{% schema %}
{
  "name": "Offer cards (Lum)",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Product", "info": "Prices and subscription plans come from this product." },
    { "type": "text", "id": "empty_text", "label": "Editor hint when no product is set", "default": "Pick a product in the section settings." },

    { "type": "header", "content": "Header" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FREE Shipping For 2 & 3 Jars" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "*For best results take consistently for at least 6–8 weeks" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, mobile", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 26 },

    { "type": "header", "content": "Price texts" },
    { "type": "text", "id": "per_pack_suffix", "label": "Per pack suffix", "default": "/pack" },
    { "type": "text", "id": "total_label", "label": "Total label", "default": "Total" },
    { "type": "text", "id": "save_prefix", "label": "Save prefix", "default": "Save", "info": "Empty hides the save pill." },
    { "type": "text", "id": "delivery_format", "label": "Delivery line", "default": "Delivery every {interval}", "info": "{interval} = the plan of the card. A card can override the whole line." },
    { "type": "text", "id": "interval_one", "label": "Interval, 1 month", "default": "month" },
    { "type": "text", "id": "interval_many", "label": "Interval, 2+ months", "default": "[n] months", "info": "[n] = number of months" },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "BUY NOW" },
    { "type": "text", "id": "sold_out_text", "label": "Sold out label", "default": "Sold out" },
    { "type": "checkbox", "id": "one_time_show", "label": "Show one-time purchase link", "default": true },
    { "type": "text", "id": "one_time_format", "label": "One-time link text", "default": "One Time Purchase {total}", "info": "{total} = one-time price of the pack" },
    { "type": "text", "id": "one_time_shipping_text", "label": "One-time shipping note", "default": "+ Shipping" },
    { "type": "select", "id": "one_time_shipping_note", "label": "Shipping note shows", "default": "single", "options": [ { "value": "single", "label": "Single pack only" }, { "value": "always", "label": "Always" }, { "value": "never", "label": "Never" } ] },
    { "type": "text", "id": "error_text", "label": "Error message", "default": "Could not add to cart. Please try again." },

    { "type": "header", "content": "Checkout" },
    { "type": "select", "id": "cart_mode", "label": "Cart before checkout", "default": "replace", "options": [ { "value": "replace", "label": "Empty the cart, then add the offer" }, { "value": "add", "label": "Keep what is in the cart" } ], "info": "Both buttons go straight to the checkout." },
    { "type": "text", "id": "checkout_source", "label": "Analytics: checkout source", "default": "offer_cards" },
    { "type": "text", "id": "placement_label", "label": "Analytics: placement", "info": "For pages with two blocks, e.g. middle and bottom." },

    { "type": "header", "content": "Sticky button" },
    { "type": "checkbox", "id": "sticky_cta", "label": "Drive the page's sticky button", "default": false, "info": "The page's Sticky Add to Cart block then shows whenever no offer block is on screen, and a tap scrolls to the nearest offer block. Leave off on pages where that block already hides and scrolls on its own." },
    { "type": "text", "id": "sticky_selector", "label": "Sticky element selector", "default": ".listicle-sticky-atc.is-sticky" },
    { "type": "checkbox", "id": "sticky_after_first", "label": "Wait until the first section is scrolled past", "default": true, "info": "Keeps the button off the first screen, where it would cover the first section's own button." },

    { "type": "header", "content": "Gift" },
    { "type": "image_picker", "id": "gift_image", "label": "Gift image" },
    { "type": "textarea", "id": "gift_text", "label": "Gift text", "default": "Craving Control Guide +\nGut Health Tracker" },
    { "type": "text", "id": "gift_label", "label": "Gift label", "default": "Free" },
    { "type": "text", "id": "gift_variant_id", "label": "Gift variant ID", "info": "$0 variant added with a subscription. Empty = shown only, not added to the cart." },
    { "type": "checkbox", "id": "gift_with_one_time", "label": "Add the gift to one-time purchases too", "default": false },

    { "type": "header", "content": "Secure checkout" },
    { "type": "checkbox", "id": "secure_show", "label": "Show secure checkout strip", "default": true },
    { "type": "text", "id": "secure_text", "label": "Strip text", "default": "🔒 Safe & Secure Checkout" },
    { "type": "text", "id": "payment_types", "label": "Payment icons", "default": "visa,master,american_express,apple_pay,google_pay,shopify_pay,paypal,discover", "info": "Comma separated Shopify payment types." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#fdf9fb" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#113b34" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#858585" },
    { "type": "color", "id": "item_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "button_bg", "label": "Button", "default": "#00724d" },
    { "type": "color", "id": "button_color", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "save_bg", "label": "Save pill", "default": "#fad356" },
    { "type": "color", "id": "save_color", "label": "Save pill text", "default": "#5b0d1e" },
    { "type": "color", "id": "gift_border", "label": "Gift text border", "default": "#5b0d1e" },
    { "type": "color", "id": "gift_label_bg", "label": "Gift label", "default": "#fa6c56" },
    { "type": "color", "id": "secure_border", "label": "Secure strip border", "default": "#fad356" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Padding top, desktop", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom, desktop", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top, mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom, mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "checkbox", "id": "load_font", "label": "Load Inter Tight here", "default": false, "info": "Turn on only when the page has no Template font section." }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "limit": 3,
      "settings": [
        { "type": "range", "id": "pack", "label": "Jars in the pack", "min": 1, "max": 6, "step": 1, "default": 1 },
        { "type": "text", "id": "variant_id", "label": "Variant ID", "info": "Empty = the variant whose name starts with the pack number." },
        { "type": "select", "id": "plan_months", "label": "Subscription plan", "default": "1", "options": [ { "value": "1", "label": "Every month" }, { "value": "2", "label": "Every 2 months" }, { "value": "3", "label": "Every 3 months" } ] },
        { "type": "text", "id": "selling_plan_id", "label": "Selling plan ID", "info": "Empty = the plan is found by its interval." },
        { "type": "text", "id": "delivery_text", "label": "Delivery line", "info": "Empty = built from the plan." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Empty = the pack image of the theme." },
        { "type": "checkbox", "id": "featured", "label": "Thick border", "default": false },
        { "type": "color", "id": "border_color", "label": "Border", "default": "#f8e3e8" },
        { "type": "text", "id": "badge_text", "label": "Badge" },
        { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#fad356" },
        { "type": "color", "id": "badge_color", "label": "Badge text", "default": "#111111" },
        { "type": "checkbox", "id": "show_gift", "label": "Show the gift", "default": true },
        { "type": "header", "content": "Trust row" },
        { "type": "select", "id": "trust_1_icon", "label": "Item 1 icon", "default": "shield", "options": [ { "value": "none", "label": "None" }, { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "check", "label": "Check" } ] },
        { "type": "text", "id": "trust_1_text", "label": "Item 1 text", "default": "30-day money-back guarantee" },
        { "type": "select", "id": "trust_2_icon", "label": "Item 2 icon", "default": "check", "options": [ { "value": "none", "label": "None" }, { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "check", "label": "Check" } ] },
        { "type": "text", "id": "trust_2_text", "label": "Item 2 text", "default": "Modify or cancel anytime" },
        { "type": "select", "id": "trust_3_icon", "label": "Item 3 icon", "default": "none", "options": [ { "value": "none", "label": "None" }, { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "check", "label": "Check" } ] },
        { "type": "text", "id": "trust_3_text", "label": "Item 3 text" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Offer cards (Lum)",
      "blocks": [
        { "type": "pack", "settings": { "pack": 1 } },
        { "type": "pack", "settings": { "pack": 2, "featured": true, "border_color": "#8d2b40", "badge_text": "BEST SELLER", "trust_1_icon": "truck", "trust_1_text": "FREE shipping", "trust_2_icon": "shield", "trust_2_text": "30-day money-back guarantee", "trust_3_icon": "check", "trust_3_text": "Modify or cancel anytime" } },
        { "type": "pack", "settings": { "pack": 3, "border_color": "#bb808c", "badge_text": "MOST SAVINGS", "badge_bg": "#00724d", "badge_color": "#ffffff", "trust_1_icon": "truck", "trust_1_text": "FREE shipping", "trust_2_icon": "shield", "trust_2_text": "30-day money-back guarantee", "trust_3_icon": "check", "trust_3_text": "Modify or cancel anytime" } }
      ]
    }
  ]
