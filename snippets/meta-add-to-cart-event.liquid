<script>
  window.publishMetaAddToCart = function ({
    value,
    currency,
    quantity,
    items
  }) {
    window.__metaAtcCount = (window.__metaAtcCount || 0) + 1;

    console.group('[Meta ATC] call #' + window.__metaAtcCount);

    console.log('payload:', {
      value,
      currency,
      quantity,
      items
    });

    console.trace('called from');

    if (
      !window.Shopify ||
      !Shopify.analytics ||
      typeof Shopify.analytics.publish !== 'function'
    ) {
      console.error('Shopify.analytics.publish unavailable');
      console.groupEnd();
      return;
    }

    const payload = {
      value: Number(value) || 0,
      currency: currency || Shopify.currency?.active || 'USD',
      quantity: Number(quantity) || 1,
      items: Array.isArray(items) ? items : []
    };

    console.log('publishing lumway:add_to_cart', payload);

    Shopify.analytics.publish(
      'lumway:add_to_cart',
      payload
    );

    console.groupEnd();
  };
</script>