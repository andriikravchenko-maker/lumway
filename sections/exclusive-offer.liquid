<script>
    (function () {
        var section = document.getElementById('ExclusiveOffer-{{ section.id }}');
        if (!section) return;

        var countdown = section.querySelector('[data-exclusive-countdown]');
        if (!countdown) return;

        var hoursNode = countdown.querySelector('[data-hours]');
        var minutesNode = countdown.querySelector('[data-minutes]');
        var secondsNode = countdown.querySelector('[data-seconds]');

        var hours = parseInt(countdown.getAttribute('data-duration-hours'), 10) || 0;
        var minutes = parseInt(countdown.getAttribute('data-duration-minutes'), 10) || 0;
        var seconds = parseInt(countdown.getAttribute('data-duration-seconds'), 10) || 0;
        var duration = ((hours * 3600) + (minutes * 60) + seconds) * 1000;

        if (duration <= 0) return;

        var persistenceKey = countdown.getAttribute('data-storage-key') || 'exclusive-offer-main';
        var storageKey = 'exclusive_offer_timer_' + persistenceKey;
        var endAt = 0;
        var intervalId = null;

        function getStoredEnd() {
            try {
                var value = parseInt(window.localStorage.getItem(storageKey), 10);
                return Number.isFinite(value) ? value : 0;
            } catch (error) {
                return 0;
            }
        }

        function storeEnd(value) {
            try {
                window.localStorage.setItem(storageKey, String(value));
            } catch (error) {}
        }

        function resolveEnd(now) {
            var storedEnd = getStoredEnd();

            if (!storedEnd) {
                endAt = now + duration;
                storeEnd(endAt);
                return;
            }

            if (storedEnd > now) {
                endAt = storedEnd;
                return;
            }

            var elapsed = now - storedEnd;
            var completedCycles = Math.floor(elapsed / duration) + 1;
            endAt = storedEnd + (completedCycles * duration);
            storeEnd(endAt);
        }

        function pad(value) {
            return String(value).padStart(2, '0');
        }

        function renderTimer() {
            var now = Date.now();

            if (!endAt || now >= endAt) {
                resolveEnd(now);
            }

            var remaining = Math.max(0, endAt - now);
            var totalSeconds = Math.ceil(remaining / 1000);

            var h = Math.floor(totalSeconds / 3600);
            var m = Math.floor((totalSeconds % 3600) / 60);
            var s = totalSeconds % 60;

            if (hoursNode) hoursNode.textContent = pad(h);
            if (minutesNode) minutesNode.textContent = pad(m);
            if (secondsNode) secondsNode.textContent = pad(s);
        }

        resolveEnd(Date.now());
        renderTimer();
        intervalId = window.setInterval(renderTimer, 1000);

        document.addEventListener('shopify:section:unload', function cleanup(event) {
            if (!event.detail || event.detail.sectionId !== '{{ section.id }}') return;
            if (intervalId) window.clearInterval(intervalId);
            document.removeEventListener('shopify:section:unload', cleanup);
        });
    })();
</script>

