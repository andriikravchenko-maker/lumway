<script>
(() => {
const section = document.getElementById(
'QuizResultSlider-{{ section.id }}'
);

if (!section || section.dataset.initialized === 'true') return;

section.dataset.initialized = 'true';

const slides = Array.from(
section.querySelectorAll('[data-quiz-slide]')
);

const continueButton = section.querySelector(
'[data-quiz-continue]'
);

const continueLabel = section.querySelector(
'[data-continue-label]'
);

const backButton = section.querySelector(
'[data-quiz-back]'
);

const resultLoader = section.querySelector('[data-result-loader]');
const resultContent = section.querySelector('[data-result-content]');
const loaderProgress = section.querySelector('[data-loader-progress]');

const params = new URLSearchParams(window.location.search);

const checkoutConfig = {
variantId: {{ checkout_variant.id | default: 0 | json }},
quantity: {{ section.settings.checkout_quantity | default: 1 | json }},
sellingPlanId: {{ checkout_selling_plan.id | default: 0 | json }},
action: {{ section.settings.checkout_action | default: 'checkout' | json }},
pdpUrl: {{ section.settings.checkout_pdp_url | json }}
};

const fallbackData = {
age: {{ section.settings.placeholder_age | json }},
heightFt: {{ section.settings.placeholder_height_ft | json }},
heightIn: {{ section.settings.placeholder_height_in | json }},
currentWeight: {{ section.settings.placeholder_current_weight | json }},
targetWeight: {{ section.settings.placeholder_target_weight | json }},
gender: {{ section.settings.default_gender | json }}
};

const urlData = {
age: parseNumber(params.get('age')),
heightFt: parseNumber(params.get('heightFt')),
heightIn: parseNumber(params.get('heightIn')),
currentWeight: parseNumber(params.get('currentWeight')),
targetWeight: parseNumber(params.get('targetWeight')),
gender: params.get('gender')
};

const data = {
age: urlData.age ?? fallbackData.age,
heightFt: urlData.heightFt ?? fallbackData.heightFt,
heightIn: urlData.heightIn ?? fallbackData.heightIn,
currentWeight: urlData.currentWeight ?? fallbackData.currentWeight,
targetWeight: urlData.targetWeight ?? fallbackData.targetWeight,
gender: urlData.gender || fallbackData.gender
};

console.log('[Quiz Result] URL data:', urlData);
console.log('[Quiz Result] Final data:', data);

let activeSlide = 0;
let isAddingToCart = false;


function parseNumber(value) {
const number = Number.parseFloat(value);

return Number.isFinite(number)
? number
: null;
}


function setText(selector, value) {
section.querySelectorAll(selector).forEach((element) => {
element.textContent =
value !== null &&
value !== undefined &&
value !== ''
? value
: '—';
});
}


function formatWeight(value) {
if (value === null) return '—';

return Math.round(value);
}


function calculateBMI() {
if (data.heightFt === null || data.heightIn === null || !data.currentWeight) return null;

const totalInches = (data.heightFt * 12) + data.heightIn;
const heightM = totalInches * 0.0254;
const weightKg = data.currentWeight * 0.45359237;

if (!heightM) return null;

return weightKg / (heightM * heightM);
}


function getBMIDescription(bmi) {
if (bmi === null) return '—';

if (bmi < 18.5) {
return 'Below the range most guidelines call healthy';
}

if (bmi < 25) {
return 'Within the range most guidelines call healthy';
}

if (bmi < 30) {
return 'Above the range most guidelines call healthy';
}

return 'Above the range most guidelines call healthy';
}


function getMetabolicAge(bmi) {
if (!data.age) return null;

if (!bmi) return data.age;

if (bmi < 25) {
return data.age;
}

if (bmi < 30) {
return data.age + 3;
}

if (bmi < 35) {
return data.age + 5;
}

return data.age + 8;
}


function getTimelineMonths() {
if (!data.currentWeight || !data.targetWeight) {
return 5;
}

const difference = Math.max(
0,
data.currentWeight - data.targetWeight
);

return Math.max(
1,
Math.ceil(difference / 8)
);
}


function formatMonth(date) {
return new Intl.DateTimeFormat('en-US', {
month: 'short',
year: 'numeric'
}).format(date);
}


function renderBasicData() {
setText(
'[data-current-weight]',
formatWeight(data.currentWeight)
);

setText(
'[data-target-weight]',
formatWeight(data.targetWeight)
);

setText(
'[data-summary-age]',
data.age ? Math.round(data.age) : null
);

setText(
'[data-summary-height]',
(data.heightFt !== null && data.heightIn !== null)
? `${Math.round(data.heightFt)}' ${Math.round(data.heightIn)}"`
: null
);

setText(
'[data-summary-weight]',
formatWeight(data.currentWeight)
);

setText(
'[data-summary-gender]',
data.gender
);

const bmi = calculateBMI();

setText(
'[data-bmi]',
bmi ? bmi.toFixed(1) : null
);

setText(
'[data-bmi-description]',
getBMIDescription(bmi)
);

setText(
'[data-metabolic-age]',
getMetabolicAge(bmi) !== null
? `${getMetabolicAge(bmi)} years`
: null
);
}


function renderTimeline() {
const now = new Date();

const targetDate = new Date(now);

targetDate.setMonth(
targetDate.getMonth() + getTimelineMonths()
);

setText(
'[data-current-month]',
formatMonth(now)
);

setText(
'[data-target-month]',
formatMonth(targetDate)
);

if (!data.currentWeight || !data.targetWeight) return;

const totalLoss = Math.max(
0,
data.currentWeight - data.targetWeight
);

const firstLoss = Math.min(
Math.max(Math.round(totalLoss * 0.4), 1),
totalLoss
);

const x1 = 125;
const y1 = 70;

const x2 = 500;
const y2 = 135;

const line = section.querySelector(
'[data-timeline-line]'
);

const area = section.querySelector(
'[data-timeline-area]'
);

const pointOne = section.querySelector(
'[data-timeline-point-one]'
);

const pointTwo = section.querySelector(
'[data-timeline-point-two]'
);

if (line) {
line.setAttribute(
'd',
`M 0 20
C 100 60, 250 105, 500 135`
);
}

if (area) {
area.setAttribute(
'd',
`M 0 20
C 100 60, 250 105, 500 135
L 500 150
L 0 150
Z`
);
}

if (pointOne) {
pointOne.setAttribute('cx', x1);
pointOne.setAttribute('cy', y1);
}

if (pointTwo) {
pointTwo.setAttribute('cx', x2);
pointTwo.setAttribute('cy', y2);
}

setText(
'[data-timeline-label-one]',
`-${firstLoss} lb`
);

setText(
'[data-timeline-label-two]',
`-${Math.round(totalLoss)} lb`
);
}


function renderMonthProgress() {
if (!data.currentWeight || !data.targetWeight) return;

const totalDifference = Math.max(
0,
data.currentWeight - data.targetWeight
);

const firstMonthLoss = Math.min(
9,
totalDifference
);

setText(
'[data-first-month-loss]',
`-${Math.round(firstMonthLoss)} lb`
);

const weeklyLoss = firstMonthLoss / 4;

const weights = Array.from(
{ length: 4 },
(_, index) => {
return data.currentWeight -
weeklyLoss * (index + 1);
}
);

weights.forEach((weight, index) => {
setText(
`[data-week-weight="${index}"]`,
`${formatWeight(weight)} lb`
);
});

const points = [
{ x: 70, y: 30 },
{ x: 236.6667, y: 74 },
{ x: 403.3333, y: 111.7143 },
{ x: 570, y: 140 }
];

const line = section.querySelector(
'[data-month-line]'
);

if (line) {
line.setAttribute(
'd',
'M 70 30 C 97.7778 37.3333, 181.1111 60.381, 236.6667 74 C 292.2222 87.619, 347.7778 100.7143, 403.3333 111.7143 C 458.8889 122.7143, 542.2222 135.2857, 570 140'
);
}

const guidesContainer = section.querySelector(
'[data-week-guides]'
);

if (guidesContainer) {
guidesContainer.innerHTML = points
.map((point) => {
return `
<line
class="quiz-month-chart__guide"
x1="${point.x}"
x2="${point.x}"
y1="${point.y + 14}"
y2="170"
/>
`;
})
.join('');
}

const pointsContainer = section.querySelector(
'[data-week-points]'
);

if (pointsContainer) {
pointsContainer.innerHTML = points
.map((point) => {
return `
<circle
class="quiz-month-chart__point"
cx="${point.x}"
cy="${point.y}"
r="10"
/>
`;
})
.join('');
}
}


function showSlide(index) {
slides.forEach((slide, slideIndex) => {
const active = slideIndex === index;

slide.hidden = !active;
slide.classList.toggle(
'is-active',
active
);
});

activeSlide = index;

if (continueLabel) {
continueLabel.textContent =
activeSlide === slides.length - 1
? '{{ section.settings.checkout_label | escape }}'
: '{{ section.settings.continue_label | escape }}';
}

section.scrollIntoView({
behavior: 'smooth',
block: 'start'
});
}


async function addProductAndCheckout() {
if (isAddingToCart) return;

const root = window.Shopify?.routes?.root || '/';

// 1. Redirect to PDP only — do not add anything to cart.
if (checkoutConfig.action === 'pdp_only') {
  if (!checkoutConfig.pdpUrl) {
    console.error('[Quiz Result] PDP redirect URL is not configured.');
    return;
  }

  window.location.assign(
    new URL(checkoutConfig.pdpUrl, window.location.origin).toString()
  );
  return;
}

// Checkout and PDP + drawer modes require a configured product variant.
if (!checkoutConfig.variantId) {
console.error('[Quiz Result] Checkout product is not configured.');
return;
}

isAddingToCart = true;
continueButton.disabled = true;

const originalLabel = continueLabel?.textContent;

if (continueLabel) {
continueLabel.textContent = 'Loading...';
}

const item = {
id: Number(checkoutConfig.variantId),
quantity: Number(checkoutConfig.quantity) || 1
};

if (
checkoutConfig.sellingPlanId &&
String(checkoutConfig.sellingPlanId).trim()
) {
item.selling_plan = Number(checkoutConfig.sellingPlanId);
}

try {
const response = await fetch(`${root}cart/add.js`, {
method: 'POST',
headers: {
'Content-Type': 'application/json',
'Accept': 'application/json'
},
body: JSON.stringify({
items: [item]
})
});

if (!response.ok) {
const error = await response.json().catch(() => null);

throw new Error(
error?.description ||
error?.message ||
'Unable to add product to cart.'
);
}

// 2. Add to cart -> redirect to PDP -> PDP script opens cart drawer.
if (checkoutConfig.action === 'pdp_cart') {
  if (!checkoutConfig.pdpUrl) {
    throw new Error('PDP redirect URL is not configured.');
  }

  const pdpUrl = new URL(
    checkoutConfig.pdpUrl,
    window.location.origin
  );

  pdpUrl.searchParams.set('openCartDrawer', '1');

  window.location.assign(pdpUrl.toString());
  return;
}

// 3. Add to cart -> direct checkout.
window.location.assign(`${root}checkout`);
} catch (error) {
console.error('[Quiz Result] Checkout error:', error);

isAddingToCart = false;
continueButton.disabled = false;

if (continueLabel) {
continueLabel.textContent =
originalLabel ||
'{{ section.settings.checkout_label | escape }}';
}
}
}


backButton?.addEventListener('click', () => {
if (activeSlide > 0) {
showSlide(activeSlide - 1);
return;
}

const backUrl = {{ section.settings.back_url | json }};

if (backUrl) {
window.location.assign(backUrl);
return;
}

window.history.back();
});


continueButton?.addEventListener('click', async () => {
if (activeSlide < slides.length - 1) {
showSlide(activeSlide + 1);
return;
}

await addProductAndCheckout();
});


renderBasicData();
renderTimeline();
renderMonthProgress();

function finishResultLoader() {
if (loaderProgress) {
loaderProgress.style.transition = 'none';
loaderProgress.style.width = '100%';
}

resultLoader?.remove();

if (resultContent) {
resultContent.hidden = false;
}

section.classList.remove('is-loading');

slides.forEach((slide, slideIndex) => {
const active = slideIndex === 0;
slide.hidden = !active;
slide.classList.toggle('is-active', active);
});

activeSlide = 0;
window.scrollTo(0, 0);
}

function startResultLoader() {
if (!resultLoader || !resultContent) {
if (resultContent) resultContent.hidden = false;
section.classList.remove('is-loading');
return;
}

const loaderDuration = {{ section.settings.loader_duration | times: 1000 | json }};

if (!loaderDuration || loaderDuration <= 0) {
finishResultLoader();
return;
}

if (loaderProgress) {
loaderProgress.style.transition = 'none';
loaderProgress.style.width = '0%';
}

const startedAt = performance.now();

function updateLoaderProgress(now) {
const elapsed = now - startedAt;
const progress = Math.min(elapsed / loaderDuration, 1);

if (loaderProgress) {
loaderProgress.style.width = `${progress * 100}%`;
}

if (progress < 1) {
requestAnimationFrame(updateLoaderProgress);
return;
}

finishResultLoader();
}

requestAnimationFrame(updateLoaderProgress);
}

startResultLoader();
})();
</script>


