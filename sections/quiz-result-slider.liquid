{% comment %}
Quiz Result Slider

Expected URL params:
?age=42
&height=165
&currentWeight=180
&targetWeight=160

Example:
/pages/gut-flow-quiz-result?age=42&height=165&currentWeight=180&targetWeight=160
{% endcomment %}

{%- liquid
assign checkout_product = section.settings.checkout_product
assign checkout_variant = checkout_product.selected_or_first_available_variant
assign checkout_selling_plan = blank

unless section.settings.checkout_plan_index == 'one_time'
assign requested_plan_index = section.settings.checkout_plan_index | plus: 0
assign current_plan_index = 0

for selling_plan_group in checkout_product.selling_plan_groups
for selling_plan in selling_plan_group.selling_plans
assign current_plan_index = current_plan_index | plus: 1

if current_plan_index == requested_plan_index
assign checkout_selling_plan = selling_plan
break
endif
endfor

if checkout_selling_plan != blank
break
endif
endfor
endunless
-%}

<section
id="QuizResultSlider-{{ section.id }}"
class="quiz-result-slider"
data-quiz-result-slider
style="
--qrs-bg: {{ section.settings.background_color }};
--qrs-card-bg: {{ section.settings.card_background }};
--qrs-text: {{ section.settings.text_color }};
--qrs-muted: {{ section.settings.muted_color }};
--qrs-accent: {{ section.settings.accent_color }};
--qrs-button-bg: {{ section.settings.button_background }};
--qrs-button-color: {{ section.settings.button_color }};
--qrs-border: {{ section.settings.border_color }};
"
>
<div class="quiz-result-slider__viewport">

<div
class="quiz-result-slider__slide is-active"
data-quiz-slide="0"
>
<div class="quiz-result-slider__container quiz-result-slider__container--timeline">

<div class="quiz-result-slider__intro">
<h2 class="quiz-result-slider__title">
{{ section.settings.timeline_heading }}
</h2>

<div class="quiz-result-slider__description">
{{ section.settings.timeline_text }}
</div>

<p class="quiz-result-slider__disclaimer quiz-result-slider__disclaimer--desktop">
{{ section.settings.timeline_disclaimer }}
</p>
</div>

<div class="quiz-timeline-card">

<h3 class="quiz-timeline-card__title">
Your estimated timeline*
</h3>

<div class="quiz-timeline-card__divider"></div>

<div class="quiz-timeline-card__dates">
<span data-current-month>—</span>
<span data-target-month>—</span>
</div>

<div class="quiz-timeline-card__weights">
<strong>
<span data-current-weight>—</span> lb
</strong>

<span class="quiz-timeline-card__arrow">→</span>

<strong>
<span data-target-weight>—</span> lb
</strong>
</div>

<div class="quiz-timeline-chart">
<svg
class="quiz-timeline-chart__svg"
viewBox="0 0 500 150"
preserveAspectRatio="none"
aria-hidden="true"
>
<line
class="quiz-chart-grid"
x1="0"
y1="0"
x2="0"
y2="150"
/>

<line
class="quiz-chart-grid"
x1="125"
y1="0"
x2="125"
y2="150"
/>

<line
class="quiz-chart-grid"
x1="250"
y1="0"
x2="250"
y2="150"
/>

<line
class="quiz-chart-grid"
x1="375"
y1="0"
x2="375"
y2="150"
/>

<line
class="quiz-chart-grid"
x1="499"
y1="0"
x2="499"
y2="150"
/>

<path
class="quiz-timeline-chart__area"
data-timeline-area
d=""
/>

<path
class="quiz-timeline-chart__line"
data-timeline-line
d=""
/>

<circle
class="quiz-timeline-chart__point"
data-timeline-point-one
r="6"
/>

<circle
class="quiz-timeline-chart__point"
data-timeline-point-two
r="6"
/>
</svg>

<span
class="quiz-timeline-chart__label quiz-timeline-chart__label--first"
data-timeline-label-one
>
—
</span>

<span
class="quiz-timeline-chart__label quiz-timeline-chart__label--last"
data-timeline-label-two
>
—
</span>
</div>

</div>

<p class="quiz-result-slider__disclaimer quiz-result-slider__disclaimer--mobile">
{{ section.settings.timeline_disclaimer }}
</p>

</div>
</div>


<div
class="quiz-result-slider__slide"
data-quiz-slide="1"
hidden
>
<div class="quiz-result-slider__container">

<div class="quiz-month-card">

<div class="quiz-month-card__content">
<h2 class="quiz-month-card__title">
{{ section.settings.month_heading }}
</h2>

<div class="quiz-month-card__description">
{{ section.settings.month_text }}
</div>
</div>

<div class="quiz-month-card__chart-wrapper">

