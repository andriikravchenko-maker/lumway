{% comment %}
Quiz Result Slider

Expected URL params:
?age=42
&heightFt=5
&heightIn=5
&currentWeight=180
&targetWeight=160
&gender=Female

Example:
/pages/gut-flow-quiz-result?age=42&heightFt=5
&heightIn=5&currentWeight=180&targetWeight=160&gender=Female
{% endcomment %}

{%- liquid
assign checkout_product = section.settings.checkout_product
assign offer_enabled = false
if section.settings.offer_enabled and checkout_product != blank and checkout_product.variants.size > 0
assign offer_enabled = true
endif
assign checkout_variant = checkout_product.selected_or_first_available_variant
assign checkout_selling_plan = blank

unless section.settings.checkout_plan_index == 'one_time'
assign requested_plan_index = section.settings.checkout_plan_index | plus: 0
assign current_plan_index = 0

for selling_plan_group in checkout_product.selling_plan_groups
for selling_plan in selling_plan_group.selling_plans
assign current_plan_index = current_plan_index | plus: 1

if current_plan_index == requested_plan_index
assign checkout_selling_plan = selling_plan
break
endif
endfor

if checkout_selling_plan != blank
break
endif
endfor
endunless
-%}

<section
id="QuizResultSlider-{{ section.id }}"
class="quiz-result-slider{% if section.settings.show_loader %} is-loading{% endif %}"
data-quiz-result-slider
style="
--qrs-bg: {{ section.settings.background_color }};
--qrs-card-bg: {{ section.settings.card_background }};
--qrs-text: {{ section.settings.text_color }};
--qrs-muted: {{ section.settings.muted_color }};
--qrs-accent: {{ section.settings.accent_color }};
--qrs-button-bg: {{ section.settings.button_background }};
--qrs-button-color: {{ section.settings.button_color }};
--qrs-border: {{ section.settings.border_color }};
--qrs-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
--qrs-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
--qrs-body-size-desktop: {{ section.settings.body_size_desktop }}px;
--qrs-body-size-mobile: {{ section.settings.body_size_mobile }}px;
