<style>

#QuizResultSlider-{{ section.id }} {
background: var(--qrs-bg);
color: var(--qrs-text);
font-family: "Fraunces", Georgia, sans-serif;
}

#QuizResultSlider-{{ section.id }} * {
box-sizing: border-box;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__content[hidden] {
display: none !important;
}

/* While the loader is active, never render the result viewport or sticky footer. */
#QuizResultSlider-{{ section.id }}.is-loading .quiz-result-slider__viewport,
#QuizResultSlider-{{ section.id }}.is-loading .quiz-result-slider__footer {
display: none !important;
}

#QuizResultSlider-{{ section.id }} .quiz-result-loader {
display: grid;
width: 100%;
min-height: 100svh;
place-items: center;
padding: 60px 24px;
background: {{ section.settings.loader_background }};
color: {{ section.settings.loader_text_color }};
text-align: center;
}
#QuizResultSlider-{{ section.id }} .quiz-result-loader__inner { width: min(100%, 650px); }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__stars { color: {{ section.settings.loader_star_color }}; font-family: Arial,sans-serif; font-size: {{ section.settings.loader_star_size_desktop }}px; letter-spacing: 3px; line-height: 1; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__review-title { margin: 22px auto 18px; max-width: 620px; color: inherit; font-family: 'Fraunces',Georgia,serif; font-size: {{ section.settings.loader_title_size_desktop }}px; line-height: 1.12; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__review-text { margin-inline:auto; max-width:620px; font-family:Arial,Helvetica,sans-serif; font-size: {{ section.settings.loader_body_size_desktop }}px; line-height:1.55; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__review-text p { margin:0; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__customer { display:flex; justify-content:center; flex-wrap:wrap; gap:7px; margin-top:20px; font-family:Arial,Helvetica,sans-serif; font-size: {{ section.settings.loader_customer_size_desktop }}px; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__progress-wrap { width:min(100%,460px); margin:76px auto 0; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__progress-wrap h3 { margin:0 0 20px; color:inherit; font-family:'Fraunces',Georgia,serif; font-size: {{ section.settings.loader_heading_size_desktop }}px; line-height:1.2; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__track { height:8px; overflow:hidden; border-radius:999px; background: {{ section.settings.loader_track_color }}; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__track span { display:block; width:0; height:100%; border-radius:inherit; background: {{ section.settings.loader_progress_color }}; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader.is-complete { animation:qrsLoaderOut-{{ section.id }} .35s ease forwards; }
@keyframes qrsLoaderOut-{{ section.id }} { to { opacity:0; visibility:hidden; } }
@media(max-width:749px){
#QuizResultSlider-{{ section.id }} .quiz-result-loader { min-height:100svh; padding:48px 24px; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__stars { font-size:{{ section.settings.loader_star_size_mobile }}px; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__review-title { font-size:{{ section.settings.loader_title_size_mobile }}px; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__review-text { font-size:{{ section.settings.loader_body_size_mobile }}px; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__customer { font-size:{{ section.settings.loader_customer_size_mobile }}px; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__progress-wrap { margin-top:60px; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__progress-wrap h3 { font-size:{{ section.settings.loader_heading_size_mobile }}px; }
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__viewport {
position: relative;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__slide {
min-height: 740px;
padding: 58px 32px 70px;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__slide[hidden] {
display: none !important;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__slide.is-active {
animation: quizResultFade-{{ section.id }} 0.35s ease;
}

@keyframes quizResultFade-{{ section.id }} {
from {
opacity: 0;
transform: translateX(12px);
}

to {
opacity: 1;
transform: translateX(0);
}
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__container {
width: min(100%, 976px);
margin-inline: auto;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__container--timeline {
display: grid;
grid-template-columns: minmax(0, 1fr) minmax(400px, 465px);
gap: 72px;
align-items: center;
padding-top: 85px;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__title,
#QuizResultSlider-{{ section.id }} .quiz-month-card__title,
#QuizResultSlider-{{ section.id }} .quiz-summary__title,
#QuizResultSlider-{{ section.id }} .quiz-comparison__title {
margin: 0;
font-family: 'Fraunces', Georgia, serif;
color: var(--qrs-text);
font-weight: 700;
line-height: 1.08;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__title {
max-width: 440px;
font-size: 48px;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__description {
max-width: 480px;
margin-top: 20px;
color: var(--qrs-muted);
font-size: 18px;
line-height: 1.6;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__description p,
#QuizResultSlider-{{ section.id }} .quiz-month-card__description p,
#QuizResultSlider-{{ section.id }} .quiz-summary__subtitle p,
#QuizResultSlider-{{ section.id }} .quiz-comparison__subtitle p {
margin: 0;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__disclaimer {
margin: 28px 0 0;
color: var(--qrs-muted);
font-size: 14px;
line-height: 1.5;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__disclaimer--desktop {
margin-top: 46px;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__disclaimer--mobile {
display: none;
}


/* Timeline */

