    "store_faq_73Kxey": {
      "type": "store-faq",
      "blocks": {
        "faq_item_9tx39V": {
          "type": "faq_item",
          "settings": {
            "question": "How do I place an order?",
            "answer": "<p>To place an order, simply browse our products, add items to your cart, and proceed to checkout. You can review your order before finalizing your purchase.</p>"
          }
        },
        "faq_item_xbJe4L": {
          "type": "faq_item",
          "settings": {
            "question": "How many gummies should I take per day?",
            "answer": "<p>Take 2 gummies daily, preferably in the morning with or without your meal. Each jar contains 60 gummies for 1 month supply.</p>"
          }
        },
        "faq_item_VLKFKE": {
          "type": "faq_item",
          "settings": {
            "question": "Is it gentle on sensitive stomachs?",
            "answer": "<p>Yes — Gut Flow is designed to be gentle and easy to tolerate. It’s free from major allergens, gluten, and artificial fillers, and uses a balanced blend of digestive-support ingredients.* If you have a medical condition or a highly sensitive gut, it’s always best to check with your doctor first.</p>"
          }
        },
        "faq_item_b6kmPh": {
          "type": "faq_item",
          "settings": {
            "question": "What does the 30-day guarantee include?",
            "answer": "<p>If you don’t feel a difference, you’re covered. We offer a 30-day money-back guarantee. Just reach out to our support team, and we’ll take care of the rest. No hassle. </p>"
          }
        },
        "faq_item_EAbEA3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I take this if I’m pregnant or nursing?",
            "answer": "<p>We recommend speaking with your healthcare provider before using any supplement during pregnancy or while nursing. </p>"
          }
        },
        "faq_item_ymA8aC": {
          "type": "faq_item",
          "settings": {
            "question": "Where are these made?",
            "answer": "<p>Gut Harmony Gummies are made in the USA in a cGMP- and NSF-certified facility. Every batch is tested for:Microbiological safetyHeavy metals So you can feel confident about what you’re taking daily.</p>"
          }
        }
      },
