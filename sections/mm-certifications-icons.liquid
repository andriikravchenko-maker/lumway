{% comment %}
  Section: MM Product Certifications / Benefits Icons
{% endcomment %}

{%- liquid
  assign section_class = 'mm-certifications-' | append: section.id
-%}

<section
  class="{{ section_class }} mm-certifications{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-up{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="mm-certifications__inner">
    {%- if section.settings.show_heading and section.settings.heading != blank -%}
      <h2 class="mm-certifications__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="mm-certifications__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          <div
            class="mm-certifications__item"
            style="
              --item-circle-bg: {{ block.settings.circle_background }};
              --item-circle-border: {{ block.settings.circle_border_color }};
              --item-icon-size-desktop: {{ block.settings.icon_size_desktop }}%;
              --item-icon-size-mobile: {{ block.settings.icon_size_mobile }}%;
              --item-full-image-width-desktop: {{ block.settings.full_image_width_desktop }}px;
              --item-full-image-width-mobile: {{ block.settings.full_image_width_mobile }}px;
              --item-full-image-radius: {{ block.settings.full_image_radius }}%;
            "
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.visual_mode == 'full_image' -%}
              <div class="mm-certifications__full-image-wrap">
                {%- if block.settings.icon != blank -%}
                  {{
                    block.settings.icon
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      class: 'mm-certifications__full-image',
                      widths: '80, 100, 120, 160, 200, 240, 300, 400, 500, 600',
                      sizes: '(max-width: 749px) 120px, 180px',
                      alt: block.settings.title
                  }}
                {%- else -%}
                  <div class="mm-certifications__full-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="mm-certifications__icon-wrap">
                {%- if block.settings.icon != blank -%}
                  {{
                    block.settings.icon
                    | image_url: width: 300
                    | image_tag:
                      loading: 'lazy',
                      class: 'mm-certifications__icon',
                      widths: '60, 80, 100, 120, 160, 200, 240, 300',
                      sizes: '(max-width: 749px) 80px, 120px',
                      alt: block.settings.title
                  }}
                {%- elsif block.settings.custom_svg != blank -%}
                  <div class="mm-certifications__svg">{{ block.settings.custom_svg }}</div>
                {%- else -%}
                  <div class="mm-certifications__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <div class="mm-certifications__label" style="color: {{ block.settings.text_color }};">
                {{ block.settings.title | newline_to_br }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  .{{ section_class }} {
  --mm-cert-bg: {{ section.settings.background_color }};
  --mm-cert-heading-color: {{ section.settings.heading_color }};
  --mm-cert-circle-size-desktop: {{ section.settings.circle_size_desktop }}px;
  --mm-cert-circle-size-mobile: {{ section.settings.circle_size_mobile }}px;
  --mm-cert-radius: {{ section.settings.circle_radius }}%;
  background: var(--mm-cert-bg);
  padding: {{ section.settings.padding_top_desktop }}px {{ section.settings.padding_right_desktop }}px {{ section.settings.padding_bottom_desktop }}px {{ section.settings.padding_left_desktop }}px;
  }

  .{{ section_class }} .mm-certifications__inner {
  width: 100%;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  }

  .{{ section_class }} .mm-certifications__heading {
  max-width: {{ section.settings.heading_max_width }}px;
  margin: {{ section.settings.heading_margin_top_desktop }}px auto {{ section.settings.heading_margin_bottom_desktop }}px;
  color: var(--mm-cert-heading-color);
  font-size: {{ section.settings.heading_size_desktop }}px;
  font-weight: {{ section.settings.heading_weight }};
  line-height: {{ section.settings.heading_line_height }};
  letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  text-align: {{ section.settings.heading_alignment }};
  }

  .{{ section_class }} .mm-certifications__grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
  column-gap: {{ section.settings.column_gap_desktop }}px;
  row-gap: {{ section.settings.row_gap_desktop }}px;
  align-items: start;
  }

  .{{ section_class }} .mm-certifications__item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: {{ section.settings.item_inner_gap_desktop }}px;
  text-align: center;
  }

  .{{ section_class }} .mm-certifications__icon-wrap {
  width: var(--mm-cert-circle-size-desktop);
  height: var(--mm-cert-circle-size-desktop);
  flex: 0 0 var(--mm-cert-circle-size-desktop);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--item-circle-bg);
  border: {{ section.settings.circle_border_width }}px solid var(--item-circle-border);
  border-radius: var(--mm-cert-radius);
  overflow: hidden;
  box-sizing: border-box;
  }

  .{{ section_class }} .mm-certifications__icon,
  .{{ section_class }} .mm-certifications__svg,
  .{{ section_class }} .mm-certifications__placeholder {
  width: var(--item-icon-size-desktop);
  height: var(--item-icon-size-desktop);
  }

  .{{ section_class }} .mm-certifications__icon {
  display: block;
  object-fit: contain;
  }

  .{{ section_class }} .mm-certifications__svg {
  display: flex;
  align-items: center;
  justify-content: center;
  }

  .{{ section_class }} .mm-certifications__svg svg,
  .{{ section_class }} .mm-certifications__placeholder svg {
  width: 100%;
  height: 100%;
  display: block;
  }

  /* Full prepared image mode:
  use this when the uploaded image already contains the circle + icon,
  like the supplied Non-GMO artwork. */
  .{{ section_class }} .mm-certifications__full-image-wrap {
  width: var(--item-full-image-width-desktop);
  max-width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  }

  .{{ section_class }} .mm-certifications__full-image {
  display: block;
  width: 100%;
  height: auto;
  border-radius: var(--item-full-image-radius);
  object-fit: contain;
  }

  .{{ section_class }} .mm-certifications__full-placeholder {
  width: 100%;
  aspect-ratio: 1 / 1;
  }

  .{{ section_class }} .mm-certifications__full-placeholder svg {
  width: 100%;
  height: 100%;
  display: block;
  }

  .{{ section_class }} .mm-certifications__label {
  margin: 0;
  max-width: {{ section.settings.label_max_width_desktop }}px;
  font-size: {{ section.settings.label_size_desktop }}px;
  font-weight: {{ section.settings.label_weight }};
  line-height: {{ section.settings.label_line_height }};
  letter-spacing: {{ section.settings.label_letter_spacing }}px;
  text-align: center;
  }

  @media screen and (max-width: 749px) {
  .{{ section_class }} {
  padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_right_mobile }}px {{ section.settings.padding_bottom_mobile }}px {{ section.settings.padding_left_mobile }}px;
  }

  .{{ section_class }} .mm-certifications__heading {
  max-width: {{ section.settings.heading_max_width_mobile }}px;
  margin: {{ section.settings.heading_margin_top_mobile }}px auto {{ section.settings.heading_margin_bottom_mobile }}px;
  font-size: {{ section.settings.heading_size_mobile }}px;
  line-height: {{ section.settings.heading_line_height_mobile }};
  letter-spacing: {{ section.settings.heading_letter_spacing_mobile }}px;
  }

  .{{ section_class }} .mm-certifications__grid {
  grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
  column-gap: {{ section.settings.column_gap_mobile }}px;
  row-gap: {{ section.settings.row_gap_mobile }}px;
  }

  .{{ section_class }} .mm-certifications__item {
  gap: {{ section.settings.item_inner_gap_mobile }}px;
  }

  .{{ section_class }} .mm-certifications__icon-wrap {
  width: var(--mm-cert-circle-size-mobile);
  height: var(--mm-cert-circle-size-mobile);
  flex-basis: var(--mm-cert-circle-size-mobile);
  }

  .{{ section_class }} .mm-certifications__icon,
  .{{ section_class }} .mm-certifications__svg,
  .{{ section_class }} .mm-certifications__placeholder {
  width: var(--item-icon-size-mobile);
  height: var(--item-icon-size-mobile);
  }

  .{{ section_class }} .mm-certifications__full-image-wrap {
  width: var(--item-full-image-width-mobile);
  }

  .{{ section_class }} .mm-certifications__label {
  max-width: {{ section.settings.label_max_width_mobile }}px;
  font-size: {{ section.settings.label_size_mobile }}px;
  line-height: {{ section.settings.label_line_height_mobile }};
  letter-spacing: {{ section.settings.label_letter_spacing_mobile }}px;
  }
  }
{% endstyle %}

