      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_text_size_mobile",
      "label": "Logo text size mobile",
      "min": 20,
      "max": 52,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "Spacing below logo",
