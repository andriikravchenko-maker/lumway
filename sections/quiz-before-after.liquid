{% comment %} Quiz Before / After {% endcomment %}
<section
  id="QuizBeforeAfter-{{ section.id }}"
  class="quiz-before-after"
  style="--qba-bg:{{ section.settings.background_color }};--qba-text:{{ section.settings.text_color }};--qba-row:{{ section.settings.row_text_color }};--qba-before-bg:{{ section.settings.before_background }};--qba-after-bg:{{ section.settings.after_background }};--qba-border:{{ section.settings.border_color }};--qba-divider:{{ section.settings.divider_color }};--qba-hd:{{ section.settings.heading_size_desktop }}px;--qba-hm:{{ section.settings.heading_size_mobile }}px;--qba-td:{{ section.settings.card_title_size_desktop }}px;--qba-tm:{{ section.settings.card_title_size_mobile }}px;--qba-rd:{{ section.settings.row_size_desktop }}px;--qba-rm:{{ section.settings.row_size_mobile }}px;--qba-radius:{{ section.settings.card_radius }}px;--qba-container:{{ section.settings.container_width }}px;--qba-img-d:{{ section.settings.image_width_desktop }}px;--qba-img-m:{{ section.settings.image_width_mobile }}px;"
>
  <div class="quiz-before-after__container">
    {% if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} class="quiz-before-after__title">
        {{- section.settings.heading -}}
      </{{ section.settings.heading_tag }}>
    {%- endif %}
    <div class="quiz-before-after__content">
      <div class="quiz-before-after__cards">
        <article class="quiz-before-after__card quiz-before-after__card--before">
          <h3 class="quiz-before-after__card-title">{{ section.settings.before_title | newline_to_br }}</h3>
          <div class="quiz-before-after__rows">
            {% for block in section.blocks -%}
              {%- if block.type == 'comparison_row' and block.settings.before_text != blank %}
                <div class="quiz-before-after__row" {{ block.shopify_attributes }}>
                  <span class="quiz-before-after__icon quiz-before-after__icon--before" aria-hidden="true">
                    {% if section.settings.before_icon_svg != blank -%}
                      <span class="quiz-before-after__custom-svg">{{ section.settings.before_icon_svg }}</span>
                    {%- elsif section.settings.before_icon != blank -%}
                      {{-
                        section.settings.before_icon
                        | image_url: width: 80
                        | image_tag: loading: 'lazy', widths: '20,40,60,80', alt: ''
                      -}}
                    {%- else -%}
                      ×
                    {%- endif %} </span
                  ><span>{{ block.settings.before_text }}</span>
                </div>
              {% endif -%}
            {%- endfor %}
          </div>
        </article>
        <article class="quiz-before-after__card quiz-before-after__card--after">
          <h3 class="quiz-before-after__card-title">{{ section.settings.after_title | newline_to_br }}</h3>
          <div class="quiz-before-after__rows">
            {% for block in section.blocks -%}
              {%- if block.type == 'comparison_row' and block.settings.after_text != blank %}
                <div class="quiz-before-after__row">
                  <span class="quiz-before-after__icon quiz-before-after__icon--after" aria-hidden="true">
                    {% if section.settings.after_icon_svg != blank -%}
                      <span class="quiz-before-after__custom-svg">{{ section.settings.after_icon_svg }}</span>
                    {%- elsif section.settings.after_icon != blank -%}
                      {{-
                        section.settings.after_icon
                        | image_url: width: 80
                        | image_tag: loading: 'lazy', widths: '20,40,60,80', alt: ''
                      -}}
                    {%- else -%}
                      ✓
                    {%- endif %} </span
                  ><span>{{ block.settings.after_text }}</span>
                </div>
              {% endif -%}
            {%- endfor %}
          </div>
        </article>
      </div>
      <div class="quiz-before-after__illustration">
        {% if section.settings.illustration != blank -%}
          {{-
            section.settings.illustration
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '240,360,480,640,800,1000,1200',
              sizes: '(max-width: 749px) 80vw, 360px',
              alt: section.settings.illustration_alt
          -}}
        {%- endif %}
      </div>
    </div>
  </div>
</section>
<style>
  #QuizBeforeAfter-{{ section.id }}{background:var(--qba-bg);color:var(--qba-text);padding:{{ section.settings.padding_top_desktop }}px 32px {{ section.settings.padding_bottom_desktop }}px}#QuizBeforeAfter-{{ section.id }} *{box-sizing:border-box}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__container{width:min(100%,var(--qba-container));margin:auto}#QuizBeforeAfter-{{ section.id }}
                                                                                                                                                                                                                                                                                                                                                                        .quiz-before-after__title{width:min(100%,{{ section.settings.heading_max_width }}px);margin:0;font-family:'Fraunces',Georgia,serif;font-size:var(--qba-hd);font-weight:{{ section.settings.heading_weight }};line-height:{{ section.settings.heading_line_height | divided_by: 100.0 }}}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__content{display:grid;grid-template-columns:minmax(0,704px) minmax(240px,1fr);gap:{{ section.settings.desktop_content_gap }}px;align-items:center;margin-top:{{ section.settings.heading_content_gap_desktop }}px}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:{{ section.settings.cards_gap }}px}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__card{padding:{{ section.settings.card_padding_y }}px {{ section.settings.card_padding_x }}px;border-radius:var(--qba-radius);overflow:hidden}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__card--before{background:var(--qba-before-bg);border:{{ section.settings.before_border_width }}px solid var(--qba-border)}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__card--after{background:var(--qba-after-bg);border:{{ section.settings.after_border_width }}px solid var(--qba-border)}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__card-title{margin:0 0 {{ section.settings.card_title_gap }}px;font-family:'Fraunces',Georgia,serif;font-size:var(--qba-td);font-weight:{{ section.settings.card_title_weight }};line-height:1.3}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__row{display:grid;grid-template-columns:{{ section.settings.icon_size }}px minmax(0,1fr);gap:{{ section.settings.icon_text_gap }}px;align-items:center;min-height:{{ section.settings.row_min_height }}px;padding:{{ section.settings.row_padding_y }}px 0;border-bottom:1px solid var(--qba-divider);color:var(--qba-row);font-family:Arial,Helvetica,sans-serif;font-size:var(--qba-rd);line-height:1.4}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__row:last-child{border-bottom:0}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__icon{display:flex;width:{{ section.settings.icon_size }}px;height:{{ section.settings.icon_size }}px;align-items:center;justify-content:center;border:1px solid currentColor;border-radius:50%;font-size:12px}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__icon--before{color:{{ section.settings.before_icon_color }}}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__icon--after{color:{{ section.settings.after_icon_color }}}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__icon:has(img),#QuizBeforeAfter-{{ section.id }} .quiz-before-after__icon:has(.quiz-before-after__custom-svg){border:0}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__icon img,#QuizBeforeAfter-{{ section.id }} .quiz-before-after__custom-svg,#QuizBeforeAfter-{{ section.id }} .quiz-before-after__custom-svg svg{display:block;width:100%;height:100%}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__icon img{object-fit:contain}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__illustration{display:flex;justify-content:center;align-items:center}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__illustration img{display:block;width:min(100%,var(--qba-img-d));height:auto}
  @media(max-width:749px){#QuizBeforeAfter-{{ section.id }}{padding:{{ section.settings.padding_top_mobile }}px 15px {{ section.settings.padding_bottom_mobile }}px}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__title{width:min(100%,{{ section.settings.heading_max_width_mobile }}px);font-size:var(--qba-hm)}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__content{display:flex;flex-direction:column;gap:0;margin-top:{{ section.settings.heading_content_gap_mobile }}px}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__illustration{order:1;width:100%;margin-bottom:{{ section.settings.image_cards_gap_mobile }}px}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__illustration img{width:min(100%,var(--qba-img-m))}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__cards{order:2;width:100%;grid-template-columns:1fr;gap:{{ section.settings.cards_gap_mobile }}px}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__card{padding:{{ section.settings.card_padding_y_mobile }}px {{ section.settings.card_padding_x_mobile }}px}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__card-title{margin-bottom:{{ section.settings.card_title_gap_mobile }}px;font-size:var(--qba-tm)}#QuizBeforeAfter-{{ section.id }} .quiz-before-after__row{min-height:{{ section.settings.row_min_height_mobile }}px;padding:{{ section.settings.row_padding_y_mobile }}px 0;font-size:var(--qba-rm)}}
</style>
{% schema %}
{
  "name": "Quiz before / after",
  "tag": "section",
  "class": "section-quiz-before-after",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "textarea",
      "id": "heading",
