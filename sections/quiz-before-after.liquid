    { "type": "color", "id": "border_color", "label": "Card border", "default": "#E7D9D0" },
    { "type": "color", "id": "divider_color", "label": "Rows divider", "default": "#E7D9D0" },
    { "type": "header", "content": "Typography" },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size — desktop",
