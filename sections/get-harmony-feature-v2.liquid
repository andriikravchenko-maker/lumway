{% comment %} Section: gut-harmony-feature — numbered feature: title + composite graphic (left) + body & testimonial (right) {% endcomment %}

{%- unless settings.enable_oswald_font -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
{%- endunless -%}
{%- unless settings.enable_league_spartan_font -%}
  <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;500;600;700&display=swap" rel="stylesheet">
{%- endunless -%}
<link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@1,500;1,700&display=swap" rel="stylesheet">

{%- liquid
  if section.settings.use_theme_colors
    assign background_color = settings.global_section_background_color
    assign title_color = settings.global_section_heading_color | default: settings.global_section_text_color
    assign text_color = settings.global_section_text_color
    assign testimonial_color = settings.global_section_text_color
  else
    assign background_color = section.settings.background_color
    assign title_color = section.settings.title_color
    assign text_color = section.settings.text_color
    assign testimonial_color = section.settings.testimonial_color
  endif

  assign image_alt = section.settings.image.alt | default: section.settings.title
-%}

{% style %}
  .section-{{ section.id }} {
    --ghf-font-heading: 'Oswald', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --ghf-font-body: 'League Spartan', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --ghf-font-quote: 'Urbanist', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --ghf-bg: {{ background_color }};
    --ghf-title-color: {{ title_color }};
    --ghf-text-color: {{ text_color }};
    --ghf-testimonial-color: {{ testimonial_color }};
    --ghf-title-size: {{ section.settings.title_size }}px;
    --ghf-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --ghf-text-size: {{ section.settings.text_size }}px;
    --ghf-testimonial-size: {{ section.settings.testimonial_size }}px;
    --ghf-testimonial-gap: {{ section.settings.testimonial_paragraph_spacing }}px;
    --ghf-image-radius: {{ section.settings.image_border_radius }}px;
    --ghf-title-gap: {{ section.settings.title_gap }}px;
    --ghf-column-gap: {{ section.settings.column_gap }}px;
    --ghf-content-gap: {{ section.settings.content_gap }}px;
    --ghf-pad-top: {{ section.settings.padding_top }}px;
    --ghf-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ghf-pad-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --ghf-pad-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --ghf-btn-bg: {{ section.settings.button_bg_color }};
    --ghf-btn-bg-hover: {{ section.settings.button_hover_bg_color }};
    --ghf-btn-text: {{ section.settings.button_text_color }};
    --ghf-btn-size: {{ section.settings.button_font_size }}px;
    --ghf-btn-radius: {{ section.settings.button_radius }}px;
    --ghf-media-width: {{ section.settings.image_width }}px;
--ghf-media-height: {{ section.settings.image_height }}px;

--ghf-media-width-mobile: {{ section.settings.image_width_mobile }}px;
--ghf-media-height-mobile: {{ section.settings.image_height_mobile }}px;

--ghf-image-fit: {{ section.settings.image_fit }};
--ghf-image-position: {{ section.settings.image_position }};
  }

  .section-{{ section.id }} {
    background-color: var(--ghf-bg);
    padding-top: var(--ghf-pad-top-mobile);
    padding-bottom: var(--ghf-pad-bottom-mobile);
  }

  .section-{{ section.id }} .gut-harmony-feature__inner {
    display: flex;
    flex-direction: column;
    gap: var(--ghf-title-gap);
    max-width: 1204px;
    margin-inline: auto;
    padding-inline: 20px;
    box-sizing: border-box;
  }

  /* theme forces h1-h6 / [class*="title"] { color: ... !important }; keep the design's dark green */
  .section-{{ section.id }} .gut-harmony-feature__title {
    margin: 0;
    font-family: var(--ghf-font-heading);
    font-weight: 700;
    line-height: 1.2;
    color: var(--ghf-title-color) !important;
    font-size: clamp(var(--ghf-title-size-mobile), 3.2vw, var(--ghf-title-size));
  }

  .section-{{ section.id }} .gut-harmony-feature__row {
    display: flex;
    flex-direction: column;
    align-items: felx-start;
    gap: var(--ghf-column-gap);
  }

.section-{{ section.id }} .gut-harmony-feature__media {
  width: min(100%, var(--ghf-media-width-mobile));
  height: var(--ghf-media-height-mobile);
  flex-shrink: 0;

  overflow: hidden;
  border-radius: var(--ghf-image-radius);
}

.section-{{ section.id }} .gut-harmony-feature__img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: var(--ghf-image-fit);
  object-position: var(--ghf-image-position);

  border-radius: inherit;
}

  .section-{{ section.id }} .gut-harmony-feature__img--placeholder {
    background-color: #eef0f1;
    fill: #b9c3c9;
  }

  .section-{{ section.id }} .gut-harmony-feature__content {
    display: flex;
    flex-direction: column;
    gap: var(--ghf-content-gap);
    width: 100%;
  }

  /* theme forces p { font-family: body !important } and font-weight: regular !important; lock to League Spartan Medium per the design */
  .section-{{ section.id }} .gut-harmony-feature__body p {
    margin: 0 0 var(--ghf-content-gap);
    font-family: var(--ghf-font-body) !important;
    font-weight: 500 !important;
    font-size: var(--ghf-text-size);
    line-height: 1.4;
    color: var(--ghf-text-color);
  }

  .section-{{ section.id }} .gut-harmony-feature__body p:last-child {
    margin-bottom: 0;
  }

  .section-{{ section.id }} .gut-harmony-feature__body strong {
    font-weight: 700 !important;
  }

  /* testimonial uses Urbanist italic in the design; override the theme's forced body font */
  .section-{{ section.id }} .gut-harmony-feature__testimonial p {
    margin: 0 0 var(--ghf-testimonial-gap);
    font-family: var(--ghf-font-quote) !important;
    font-weight: 500 !important;
    font-style: italic;
    font-size: var(--ghf-testimonial-size);
    line-height: 1.4;
    color: var(--ghf-testimonial-color);
  }

  .section-{{ section.id }} .gut-harmony-feature__testimonial p:last-child {
    margin-bottom: 0;
  }

  .section-{{ section.id }} .gut-harmony-feature__testimonial strong {
    font-weight: 700 !important;
    font-style: italic;
  }

  .section-{{ section.id }} .gut-harmony-feature__cta {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .section-{{ section.id }} .gut-harmony-feature__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    max-width: 100%;
    box-sizing: border-box;
    padding: 12px 64px;
    border: 0;
    border-radius: var(--ghf-btn-radius);
    background-color: var(--ghf-btn-bg);
    color: var(--ghf-btn-text) !important;
    font-family: var(--ghf-font-body) !important;
    font-weight: 500 !important;
    font-size: var(--ghf-btn-size);
    line-height: 1.4;
    text-transform: capitalize;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .section-{{ section.id }} .gut-harmony-feature__button-arrow {
    display: inline-block;
    line-height: 1;
    font-weight: 500 !important;
  }

  .section-{{ section.id }} .gut-harmony-feature__button:hover {
    background-color: var(--ghf-btn-bg-hover);
  }

  .section-{{ section.id }} .gut-harmony-feature__button:focus-visible {
    outline: 3px solid var(--ghf-btn-bg-hover);
    outline-offset: 3px;
  }

  #mm-gut-harmony-feature .gut-harmony-feature__title{
  display: none;
}
 #mm-gut-harmony-feature .gut-harmony-feature__row{
  gap: 24px;
 }


  @media screen and (max-width: 600px) {
    #mm-gut-harmony-feature  .gut-harmony-feature__media{
        width: 100%;
    max-width: 100%;
    height: 100%;
    margin-bottom: 24px;
    }
    #mm-gut-harmony-feature .gut-harmony-feature__row{
  gap: 0;
 }
    .section-{{ section.id }} .gut-harmony-feature__icon-list-item {
  font-size: var(--icon-list-font-size-mobile);
}

.section-{{ section.id }} .gut-harmony-feature__icon-list-icon {
  width: var(--icon-list-icon-size-mobile);
  height: var(--icon-list-icon-size-mobile);
  flex-basis: var(--icon-list-icon-size-mobile);
}

      #mm-gut-harmony-feature .gut-harmony-feature__title{
  display: flex;
font-weight: 700  !important;
font-size: 26px;
color: #111111 !important;
padding-bottom: 24px;
}
      #mm-gut-harmony-feature .gut-harmony-feature__block-heading{
  display: none;
}
     .section-{{ section.id }} .gut-harmony-feature__block-heading,

  .section-{{ section.id }} .gut-harmony-feature__block-text,

  .section-{{ section.id }} .gut-harmony-feature__block-testimonial,

  .section-{{ section.id }} .gut-harmony-feature__icon-text,

  .section-{{ section.id }} .gut-harmony-feature__emphasis {

    font-size: var(--block-size-mobile);

  }
  .section-{{ section.id }}  .gut-harmony-feature__list-item {
    align-items: center !important;
  }

  .section-{{ section.id }} .gut-harmony-feature__list {

    padding:

      var(--list-padding-y-mobile)

      var(--list-padding-x-mobile);

    font-size: var(--list-size-mobile);
   

  }

  .section-{{ section.id }} .gut-harmony-feature__icon {

    width: var(--icon-size-mobile);

    height: var(--icon-size-mobile);

    flex-basis: var(--icon-size-mobile);

  }

  .section-{{ section.id }} .gut-harmony-feature__numbered {

    font-size: var(--number-font-size-mobile);

  }

  .section-{{ section.id }} .gut-harmony-feature__highlight {

    font-size: var(--highlight-size-mobile);

  }

  .section-{{ section.id }} .gut-harmony-feature__spacer {

    height: var(--spacer-height-mobile);

  }

  .section-{{ section.id }} .gut-harmony-feature__button {

    width: 100%;

    padding: 14px 24px;

    white-space: normal;

  }
    .section-{{ section.id }} .gut-harmony-feature__button {
      width: 100%;
      padding: 14px 24px;
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }} .gut-harmony-feature__button { transition: none; }
  }

  @media screen and (min-width: 1240px) {
    .section-{{ section.id }} {
      padding-top: var(--ghf-pad-top);
      padding-bottom: var(--ghf-pad-bottom);
    }

    .section-{{ section.id }} .gut-harmony-feature__inner {
      padding-inline: 0;
    }

    .section-{{ section.id }} .gut-harmony-feature__row {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--ghf-column-gap);
    }

   .section-{{ section.id }} .gut-harmony-feature__media {

    width: var(--ghf-media-width);

    height: var(--ghf-media-height);

    max-width: none;

    flex: 0 0 var(--ghf-media-width);

  }

    .section-{{ section.id }} .gut-harmony-feature__content {
      flex: 0 0 694px;
      max-width: 694px;
    }

    /* Figma frame 133:7 is a fixed 560px-wide pill, not hug-content */
    .section-{{ section.id }} .gut-harmony-feature__button {
      min-width: 560px;
    }
  }

  /* ------------------------------
   Content blocks
------------------------------ */

.section-{{ section.id }} .gut-harmony-feature__block-heading {
  margin: 0 0 var(--block-margin-bottom);
  font-family: var(--ghf-font-heading) !important;
  font-size: var(--block-size);
  font-weight: var(--block-weight) !important;
  line-height: var(--block-line-height);
  color: var(--block-color) !important;
}

.section-{{ section.id }} .gut-harmony-feature__block-text {
  margin-bottom: var(--block-margin-bottom);
  font-family: var(--ghf-font-body) !important;
  font-size: var(--block-size);
  font-weight: var(--block-weight) !important;
  line-height: var(--block-line-height);
  color: var(--block-color);
}

.section-{{ section.id }} .gut-harmony-feature__block-text p {
  margin: 0;
  font: inherit !important;
  color: inherit;
}

.section-{{ section.id }} .gut-harmony-feature__block-text strong {
  font-weight: 700 !important;
}

.section-{{ section.id }} .gut-harmony-feature__block-testimonial {
  margin-bottom: var(--block-margin-bottom);
  font-family: var(--ghf-font-quote) !important;
  font-size: var(--block-size);
  font-weight: var(--block-weight) !important;
  font-style: italic;
  line-height: var(--block-line-height);
  color: var(--block-color);
}

.section-{{ section.id }} .gut-harmony-feature__block-testimonial p {
  margin: 0;
  font: inherit !important;
  color: inherit;
}

.section-{{ section.id }} .gut-harmony-feature__block-testimonial strong {
  font-weight: 700 !important;
}

/* List */

.section-{{ section.id }} .gut-harmony-feature__list {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: var(--block-margin-bottom);
  padding: var(--list-padding-y) var(--list-padding-x);

  background: var(--list-bg);
  border: var(--list-border-width) solid var(--list-border);
  border-radius: var(--list-radius);

  color: var(--list-color);
  font-family: var(--ghf-font-body) !important;
  font-size: var(--list-size);
  font-weight: var(--list-weight) !important;
  line-height: var(--list-line-height);
}

.section-{{ section.id }} .gut-harmony-feature__list-items {
  display: flex;
  flex-direction: column;
  gap: var(--list-gap);
  margin: 0;
  padding: 0;
  list-style: none;
}

.section-{{ section.id }} .gut-harmony-feature__list-item {
  display: flex;
  align-items: flex-start;
  gap: var(--list-bullet-gap);
}

.section-{{ section.id }} .gut-harmony-feature__list-bullet {
  display: block;
  width: var(--list-bullet-size);
  height: var(--list-bullet-size);
  flex: 0 0 var(--list-bullet-size);
  margin-top: 0.48em;
  border-radius: 50%;
  background: var(--list-bullet-color);
}

.section-{{ section.id }} .gut-harmony-feature__list-text {
  flex: 1;
  min-width: 0;
}

/* Icon + text */

.section-{{ section.id }} .gut-harmony-feature__icon-text {
  display: flex;
  align-items: flex-start;
  gap: var(--icon-gap);
  margin-bottom: var(--block-margin-bottom);

  color: var(--block-color);
  font-family: var(--ghf-font-body) !important;
  font-size: var(--block-size);
  font-weight: var(--block-weight) !important;
  line-height: var(--block-line-height);
}

.section-{{ section.id }} .gut-harmony-feature__icon {
  display: block;
  width: var(--icon-size);
  height: var(--icon-size);
  flex: 0 0 var(--icon-size);
  object-fit: contain;
}

.section-{{ section.id }} .gut-harmony-feature__icon-text-copy {
  flex: 1;
  min-width: 0;
}

.section-{{ section.id }} .gut-harmony-feature__icon-text-copy p {
  margin: 0;
  font: inherit !important;
  color: inherit;
}

/* Numbered item */

.section-{{ section.id }} .gut-harmony-feature__numbered {
  display: flex;
  align-items: flex-start;
  gap: var(--number-gap);
  margin-bottom: var(--block-margin-bottom);

  font-family: var(--ghf-font-body) !important;
  font-size: var(--number-font-size);
}

.section-{{ section.id }} .gut-harmony-feature__number {
  display: flex;
  align-items: center;
  justify-content: center;

  width: var(--number-size);
  height: var(--number-size);
  flex: 0 0 var(--number-size);

  border-radius: 50%;
  background: var(--number-bg);
  color: var(--number-color);

  font-weight: 700 !important;
  line-height: 1;
}

.section-{{ section.id }} .gut-harmony-feature__numbered-content {
  flex: 1;
  min-width: 0;
}

.section-{{ section.id }} .gut-harmony-feature__numbered-title {
  margin-bottom: 4px;
  color: var(--number-title-color);
  font-weight: 700 !important;
  line-height: 1.3;
}

.section-{{ section.id }} .gut-harmony-feature__numbered-text {
  color: var(--number-text-color);
  line-height: 1.4;
}

.section-{{ section.id }} .gut-harmony-feature__numbered-text p {
  margin: 0;
  font: inherit !important;
  color: inherit;
}

/* Highlight */

.section-{{ section.id }} .gut-harmony-feature__highlight {
  display: flex;
  align-items: flex-start;
  gap: var(--highlight-gap);

  box-sizing: border-box;
  width: 100%;
  margin-bottom: var(--block-margin-bottom);
  padding: var(--highlight-padding-y) var(--highlight-padding-x);

  border-radius: var(--highlight-radius);
  background: var(--highlight-bg);
  color: var(--highlight-color);

  font-family: var(--ghf-font-body) !important;
  font-size: var(--highlight-size);
  line-height: 1.4;
}

.section-{{ section.id }} .gut-harmony-feature__highlight-icon {
  width: var(--highlight-icon-size);
  height: var(--highlight-icon-size);
  flex: 0 0 var(--highlight-icon-size);
  object-fit: contain;
}

.section-{{ section.id }} .gut-harmony-feature__highlight-text {
  flex: 1;
  min-width: 0;
}

.section-{{ section.id }} .gut-harmony-feature__highlight-text p {
  margin: 0;
  font: inherit !important;
  color: inherit;
}

/* Emphasis */

.section-{{ section.id }} .gut-harmony-feature__emphasis {
  margin-bottom: var(--block-margin-bottom);

  color: var(--block-color);
  font-family: var(--ghf-font-body) !important;
  font-size: var(--block-size);
  font-weight: var(--block-weight) !important;
  line-height: var(--block-line-height);
}

.section-{{ section.id }} .gut-harmony-feature__emphasis--italic {
  font-style: italic;
}

/* Spacer */

.section-{{ section.id }} .gut-harmony-feature__spacer {
  height: var(--spacer-height);
}

/* Icon list item */

.section-{{ section.id }} .gut-harmony-feature__icon-list-item {
  display: flex;
  align-items: center;
  gap: var(--icon-list-gap);

  margin-bottom: var(--block-margin-bottom);

  color: var(--icon-list-text-color);
  font-family: var(--ghf-font-body) !important;
  font-size: var(--icon-list-font-size);
  font-weight: var(--icon-list-font-weight) !important;
  line-height: var(--icon-list-line-height);
}

.section-{{ section.id }} .gut-harmony-feature__icon-list-icon {
  display: block;

  width: var(--icon-list-icon-size);
  height: var(--icon-list-icon-size);
  flex: 0 0 var(--icon-list-icon-size);

  object-fit: contain;
}

.section-{{ section.id }} .gut-harmony-feature__icon-list-text {
  flex: 1;
  min-width: 0;
}

/* Numbered Highlight Box */

.section-{{ section.id }} .gut-harmony-feature__numbered-highlight {
  width: 100%;
  box-sizing: border-box;

  display: flex;
  flex-direction: column;
  gap: var(--nh-row-gap);

  margin-bottom: var(--block-margin-bottom);
  padding: var(--nh-padding-y) var(--nh-padding-x);

  background: var(--nh-bg);
  border-radius: var(--nh-radius);

  font-family: var(--ghf-font-body) !important;
}

.section-{{ section.id }} .gut-harmony-feature__numbered-highlight-item {
  display: flex;
  flex-direction: column;
  gap: var(--nh-description-gap);
}

.section-{{ section.id }} .gut-harmony-feature__numbered-highlight-heading {
  display: flex;
  align-items: center;
  gap: var(--nh-number-gap);
}

.section-{{ section.id }} .gut-harmony-feature__numbered-highlight-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  width: var(--nh-number-size);
  height: var(--nh-number-size);
  flex: 0 0 var(--nh-number-size);

  border-radius: 50%;
  background: var(--nh-number-bg);
  color: var(--nh-number-color);

  font-size: calc(var(--nh-number-size) * 0.55);
  font-weight: 500 !important;
  line-height: 1;
}

.section-{{ section.id }} .gut-harmony-feature__numbered-highlight-title {
  color: var(--nh-title-color);

  font-family: var(--ghf-font-body) !important;
  font-size: var(--nh-title-size);
  font-weight: 700 !important;
  line-height: 1.2;
}

.section-{{ section.id }} .gut-harmony-feature__numbered-highlight-text {
  color: var(--nh-text-color);

  font-family: var(--ghf-font-body) !important;
  font-size: var(--nh-text-size);
  font-weight: 400 !important;
  line-height: 1.35;
}

@media screen and (max-width: 600px) {
  .section-{{ section.id }} .gut-harmony-feature__numbered-highlight-title {
    font-size: var(--nh-title-size-mobile);
  }

  .section-{{ section.id }} .gut-harmony-feature__numbered-highlight-text {
    font-size: var(--nh-text-size-mobile);
  }
}

/* Quote Callout */

.section-{{ section.id }} .gut-harmony-feature__quote-callout {
  width: 100%;
  box-sizing: border-box;

  margin-bottom: var(--block-margin-bottom);
  padding:
    var(--quote-padding-y)
    var(--quote-padding-x);

  background: var(--quote-bg);

  border-left:
    var(--quote-border-width)
    solid
    var(--quote-border-color);

  color: var(--quote-color);

  font-family: var(--ghf-font-quote) !important;
  font-size: var(--quote-size);
  font-weight: var(--quote-weight) !important;
  font-style: italic;
  line-height: var(--quote-line-height);
}

.section-{{ section.id }} .gut-harmony-feature__quote-callout-text {
  color: inherit;
  font: inherit !important;
}

.section-{{ section.id }} .gut-harmony-feature__quote-callout-text p {
  margin: 0;
  color: inherit !important;
  font: inherit !important;
}

.section-{{ section.id }} .gut-harmony-feature__quote-callout-text strong,
.section-{{ section.id }} .gut-harmony-feature__quote-callout-text b {
  font-weight: 700 !important;
}

@media screen and (max-width: 600px) {
  .section-{{ section.id }} .gut-harmony-feature__quote-callout {
    padding:
      var(--quote-padding-y-mobile)
      var(--quote-padding-x-mobile);

    font-size: var(--quote-size-mobile);
  }
}

{% endstyle %}

<section id="mm-gut-harmony-feature"  class="gut-harmony-feature section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="gut-harmony-feature__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="gut-harmony-feature__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="gut-harmony-feature__row">
      <div class="gut-harmony-feature__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 972
            | image_tag:
              loading: 'lazy',
              widths: '300,400,486,600,800,972',
              sizes: '(min-width: 1240px) 486px, 100vw',
              alt: image_alt,
              class: 'gut-harmony-feature__img'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'gut-harmony-feature__img gut-harmony-feature__img--placeholder' }}
        {%- endif -%}
      </div>

     <div class="gut-harmony-feature__content">
  {%- if section.blocks.size > 0 -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'heading' -%}
          {%- if block.settings.text != blank -%}
            <{{ block.settings.tag }}
              class="gut-harmony-feature__block-heading"
              style="
                --block-color: {{ block.settings.color }};
                --block-size: {{ block.settings.font_size }}px;
                --block-size-mobile: {{ block.settings.font_size_mobile }}px;
                --block-weight: {{ block.settings.font_weight }};
                --block-line-height: {{ block.settings.line_height }};
                --block-margin-bottom: {{ block.settings.margin_bottom }}px;
              "
              {{ block.shopify_attributes }}
            >
              {{ block.settings.text }}
            </{{ block.settings.tag }}>
          {%- endif -%}

        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}
            <div
              class="gut-harmony-feature__block-text rte"
              style="
                --block-color: {{ block.settings.color }};
                --block-size: {{ block.settings.font_size }}px;
                --block-size-mobile: {{ block.settings.font_size_mobile }}px;
                --block-weight: {{ block.settings.font_weight }};
                --block-line-height: {{ block.settings.line_height }};
                --block-margin-bottom: {{ block.settings.margin_bottom }}px;
              "
              {{ block.shopify_attributes }}
            >
              {{ block.settings.text }}
            </div>
          {%- endif -%}

        {%- when 'testimonial' -%}
          {%- if block.settings.text != blank -%}
            <div
              class="gut-harmony-feature__block-testimonial rte"
              style="
                --block-color: {{ block.settings.color }};
                --block-size: {{ block.settings.font_size }}px;
                --block-size-mobile: {{ block.settings.font_size_mobile }}px;
                --block-weight: {{ block.settings.font_weight }};
                --block-line-height: {{ block.settings.line_height }};
                --block-margin-bottom: {{ block.settings.margin_bottom }}px;
              "
              {{ block.shopify_attributes }}
            >
              {{ block.settings.text }}
            </div>
          {%- endif -%}

        {%- when 'list' -%}
          {%- assign list_items = block.settings.items | newline_to_br | split: '<br />' -%}

          {%- if block.settings.items != blank -%}
            <div
              class="gut-harmony-feature__list"
              style="
                --list-bg: {{ block.settings.background_color }};
                --list-border: {{ block.settings.border_color }};
                --list-border-width: {{ block.settings.border_width }}px;
                --list-radius: {{ block.settings.border_radius }}px;

                --list-color: {{ block.settings.text_color }};
                --list-bullet-color: {{ block.settings.bullet_color }};

                --list-size: {{ block.settings.font_size }}px;
                --list-size-mobile: {{ block.settings.font_size_mobile }}px;
                --list-weight: {{ block.settings.font_weight }};
                --list-line-height: {{ block.settings.line_height }};

                --list-bullet-size: {{ block.settings.bullet_size }}px;
                --list-bullet-gap: {{ block.settings.bullet_gap }}px;
                --list-gap: {{ block.settings.item_gap }}px;

                --list-padding-y: {{ block.settings.padding_vertical }}px;
                --list-padding-x: {{ block.settings.padding_horizontal }}px;
                --list-padding-y-mobile: {{ block.settings.padding_vertical_mobile }}px;
                --list-padding-x-mobile: {{ block.settings.padding_horizontal_mobile }}px;

                --block-margin-bottom: {{ block.settings.margin_bottom }}px;
              "
              {{ block.shopify_attributes }}
            >
              <ul class="gut-harmony-feature__list-items">
                {%- for item in list_items -%}
                  {%- assign item_text = item | strip -%}

                  {%- if item_text != blank -%}
                    <li class="gut-harmony-feature__list-item">
                      <span class="gut-harmony-feature__list-bullet"></span>

                      <span class="gut-harmony-feature__list-text">
                        {{ item_text }}
                      </span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

        {%- when 'icon_text' -%}
          {%- if block.settings.text != blank -%}
            <div
              class="gut-harmony-feature__icon-text"
              style="
                --icon-size: {{ block.settings.icon_size }}px;
                --icon-size-mobile: {{ block.settings.icon_size_mobile }}px;

                --block-color: {{ block.settings.color }};
                --block-size: {{ block.settings.font_size }}px;
                --block-size-mobile: {{ block.settings.font_size_mobile }}px;
                --block-weight: {{ block.settings.font_weight }};
                --block-line-height: {{ block.settings.line_height }};

                --icon-gap: {{ block.settings.icon_gap }}px;
                --block-margin-bottom: {{ block.settings.margin_bottom }}px;
              "
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 120
                  | image_tag:
                    loading: 'lazy',
                    class: 'gut-harmony-feature__icon'
                }}
              {%- endif -%}

              <div class="gut-harmony-feature__icon-text-copy rte">
                {{ block.settings.text }}
              </div>
            </div>
          {%- endif -%}

          {%- when 'icon_list_item' -%}
  {%- if block.settings.text != blank -%}
    <div
      class="gut-harmony-feature__icon-list-item"
      style="
        --icon-list-icon-size: {{ block.settings.icon_size }}px;
        --icon-list-icon-size-mobile: {{ block.settings.icon_size_mobile }}px;

        --icon-list-text-color: {{ block.settings.text_color }};
        --icon-list-font-size: {{ block.settings.font_size }}px;
        --icon-list-font-size-mobile: {{ block.settings.font_size_mobile }}px;
        --icon-list-font-weight: {{ block.settings.font_weight }};
        --icon-list-line-height: {{ block.settings.line_height }};

        --icon-list-gap: {{ block.settings.gap }}px;
        --block-margin-bottom: {{ block.settings.margin_bottom }}px;
      "
      {{ block.shopify_attributes }}
    >
      {%- if block.settings.icon != blank -%}
        {{
          block.settings.icon
          | image_url: width: 120
          | image_tag:
            loading: 'lazy',
            widths: '32, 48, 64, 96, 120',
            class: 'gut-harmony-feature__icon-list-icon'
        }}
      {%- endif -%}

      <div class="gut-harmony-feature__icon-list-text">
        {{ block.settings.text }}
      </div>
    </div>
  {%- endif -%}

        {%- when 'numbered_item' -%}
          <div
            class="gut-harmony-feature__numbered"
            style="
              --number-bg: {{ block.settings.number_background }};
              --number-color: {{ block.settings.number_color }};
              --number-size: {{ block.settings.number_size }}px;

              --number-title-color: {{ block.settings.title_color }};
              --number-text-color: {{ block.settings.text_color }};

              --number-font-size: {{ block.settings.font_size }}px;
              --number-font-size-mobile: {{ block.settings.font_size_mobile }}px;
              --number-gap: {{ block.settings.gap }}px;

              --block-margin-bottom: {{ block.settings.margin_bottom }}px;
            "
            {{ block.shopify_attributes }}
          >
            <span class="gut-harmony-feature__number">
              {{ block.settings.number }}
            </span>

            <div class="gut-harmony-feature__numbered-content">
              {%- if block.settings.title != blank -%}
                <div class="gut-harmony-feature__numbered-title">
                  {{ block.settings.title }}
                </div>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="gut-harmony-feature__numbered-text rte">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
            </div>
          </div>

        {%- when 'highlight' -%}
          {%- if block.settings.text != blank -%}
            <div
              class="gut-harmony-feature__highlight"
              style="
                --highlight-bg: {{ block.settings.background_color }};
                --highlight-color: {{ block.settings.text_color }};
                --highlight-radius: {{ block.settings.border_radius }}px;

                --highlight-size: {{ block.settings.font_size }}px;
                --highlight-size-mobile: {{ block.settings.font_size_mobile }}px;

                --highlight-icon-size: {{ block.settings.icon_size }}px;
                --highlight-gap: {{ block.settings.icon_gap }}px;

                --highlight-padding-y: {{ block.settings.padding_vertical }}px;
                --highlight-padding-x: {{ block.settings.padding_horizontal }}px;

                --block-margin-bottom: {{ block.settings.margin_bottom }}px;
              "
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 120
                  | image_tag:
                    loading: 'lazy',
                    class: 'gut-harmony-feature__highlight-icon'
                }}
              {%- endif -%}

              <div class="gut-harmony-feature__highlight-text rte">
                {{ block.settings.text }}
              </div>
            </div>
          {%- endif -%}
          
          {%- when 'numbered_highlight' -%}
  {%- if block.settings.items != blank -%}
    {%- assign numbered_items = block.settings.items | newline_to_br | split: '<br />' -%}

    <div
      class="gut-harmony-feature__numbered-highlight"
      style="
        --nh-bg: {{ block.settings.background_color }};
        --nh-radius: {{ block.settings.border_radius }}px;

        --nh-number-bg: {{ block.settings.number_background }};
        --nh-number-color: {{ block.settings.number_color }};
        --nh-number-size: {{ block.settings.number_size }}px;

        --nh-title-color: {{ block.settings.title_color }};
        --nh-text-color: {{ block.settings.text_color }};

        --nh-title-size: {{ block.settings.title_font_size }}px;
        --nh-title-size-mobile: {{ block.settings.title_font_size_mobile }}px;

        --nh-text-size: {{ block.settings.text_font_size }}px;
        --nh-text-size-mobile: {{ block.settings.text_font_size_mobile }}px;

        --nh-row-gap: {{ block.settings.row_gap }}px;
        --nh-number-gap: {{ block.settings.number_gap }}px;
        --nh-description-gap: {{ block.settings.description_gap }}px;

        --nh-padding-y: {{ block.settings.padding_vertical }}px;
        --nh-padding-x: {{ block.settings.padding_horizontal }}px;

        --block-margin-bottom: {{ block.settings.margin_bottom }}px;
      "
      {{ block.shopify_attributes }}
    >
      {%- for item in numbered_items -%}
        {%- assign item_data = item | strip | split: '|' -%}

        {%- assign item_number = item_data[0] | strip -%}
        {%- assign item_title = item_data[1] | strip -%}
        {%- assign item_text = item_data[2] | strip -%}

        {%- if item_title != blank -%}
          <div class="gut-harmony-feature__numbered-highlight-item">
            <div class="gut-harmony-feature__numbered-highlight-heading">
              <span class="gut-harmony-feature__numbered-highlight-number">
                {{ item_number }}
              </span>

              <div class="gut-harmony-feature__numbered-highlight-title">
                {{ item_title }}
              </div>
            </div>

            {%- if item_text != blank -%}
              <div class="gut-harmony-feature__numbered-highlight-text">
                {{ item_text }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
        
        
        {%- when 'emphasis' -%}
          {%- if block.settings.text != blank -%}
            <div
              class="gut-harmony-feature__emphasis{% if block.settings.italic %} gut-harmony-feature__emphasis--italic{% endif %}"
              style="
                --block-color: {{ block.settings.color }};
                --block-size: {{ block.settings.font_size }}px;
                --block-size-mobile: {{ block.settings.font_size_mobile }}px;
                --block-weight: {{ block.settings.font_weight }};
                --block-line-height: {{ block.settings.line_height }};
                --block-margin-bottom: {{ block.settings.margin_bottom }}px;
              "
              {{ block.shopify_attributes }}
            >
              {{ block.settings.text }}
            </div>
          {%- endif -%}
          
          {%- when 'quote_callout' -%}
  {%- if block.settings.text != blank -%}
    <div
      class="gut-harmony-feature__quote-callout"
      style="
        --quote-bg: {{ block.settings.background_color }};
        --quote-color: {{ block.settings.text_color }};
        --quote-border-color: {{ block.settings.border_color }};
        --quote-border-width: {{ block.settings.border_width }}px;

        --quote-size: {{ block.settings.font_size }}px;
        --quote-size-mobile: {{ block.settings.font_size_mobile }}px;
        --quote-weight: {{ block.settings.font_weight }};
        --quote-line-height: {{ block.settings.line_height }};

        --quote-padding-y: {{ block.settings.padding_vertical }}px;
        --quote-padding-x: {{ block.settings.padding_horizontal }}px;

        --quote-padding-y-mobile: {{ block.settings.padding_vertical_mobile }}px;
        --quote-padding-x-mobile: {{ block.settings.padding_horizontal_mobile }}px;

        --block-margin-bottom: {{ block.settings.margin_bottom }}px;
      "
      {{ block.shopify_attributes }}
    >
      <div class="gut-harmony-feature__quote-callout-text rte">
        {{ block.settings.text }}
      </div>
    </div>
  {%- endif -%}
       
       
        {%- when 'spacer' -%}
          <div
            class="gut-harmony-feature__spacer"
            style="
              --spacer-height: {{ block.settings.height }}px;
              --spacer-height-mobile: {{ block.settings.height_mobile }}px;
            "
            {{ block.shopify_attributes }}
          ></div>

      {%- endcase -%}
    {%- endfor -%}

  {%- else -%}

    {%- comment -%}
      Legacy fallback for sections created before blocks were introduced.
    {%- endcomment -%}

    {%- if section.settings.body_text != blank -%}
      <div class="gut-harmony-feature__body">
        {{ section.settings.body_text }}
      </div>
    {%- endif -%}

    {%- if section.settings.testimonial_text != blank -%}
      <div class="gut-harmony-feature__testimonial">
        {{ section.settings.testimonial_text }}
      </div>
    {%- endif -%}

  {%- endif -%}
</div>
    </div>
    {%- if section.settings.button_text != blank -%}
      <div class="gut-harmony-feature__cta">
        <a class="gut-harmony-feature__button" href="{{ section.settings.button_link | default: '#' }}">
          <span class="gut-harmony-feature__button-text">{{ section.settings.button_text }}</span>
          {%- if section.settings.button_show_arrow -%}
            <span class="gut-harmony-feature__button-arrow" aria-hidden="true">&rarr;</span>
          {%- endif -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

