      #SubscriptionGiftsShowcase-{{ section.id }}
      .subscription-showcase__container {
        width: min(100% - 24px, {{ section.settings.container_width }}px);
      }

      #SubscriptionGiftsShowcase-{{ section.id }}
      .subscription-showcase__heading {
        margin-bottom:
                {{ section.settings.heading_bottom_spacing_mobile }}px;

        font-size: var(--sgs-heading-size-mobile);
      }

      #SubscriptionGiftsShowcase-{{ section.id }}
      .subscription-showcase__grid {
        grid-template-columns: 1fr;

        gap: var(--sgs-grid-gap-mobile);
      }

      #SubscriptionGiftsShowcase-{{ section.id }}
      .subscription-showcase__card {
        min-height: var(--sgs-card-min-height-mobile);

        padding:
                var(--sgs-card-padding-top-mobile)
                var(--sgs-card-padding-x-mobile)
                var(--sgs-card-padding-bottom-mobile);

        border-radius: var(--sgs-card-radius-mobile);
      }

      #SubscriptionGiftsShowcase-{{ section.id }}
      .subscription-showcase__plan-title {
        font-size: var(--sgs-plan-title-size-mobile);
      }

      #SubscriptionGiftsShowcase-{{ section.id }}
      .subscription-showcase__gift-title {
        font-size: var(--sgs-gift-title-size-mobile);
      }

      #SubscriptionGiftsShowcase-{{ section.id }}
      .subscription-showcase__value {
        font-size: var(--sgs-value-font-size-mobile);
      }

      #SubscriptionGiftsShowcase-{{ section.id }}
      .subscription-showcase__media {
        min-height: var(--sgs-media-min-height-mobile);
      }

      #SubscriptionGiftsShowcase-{{ section.id }}
      .subscription-showcase__image {
        max-height: var(--sgs-image-max-height-mobile);
      }

      #SubscriptionGiftsShowcase-{{ section.id }}
      .subscription-showcase__button {
        font-size: var(--sgs-button-font-size-mobile);
      }
    }
  </style>
{%- elsif request.design_mode -%}
  <div style="padding:24px;text-align:center;border:1px dashed #ccc;">
    Select a subscription product with
    <code>custom.subscription_gifts</code>
    configured.
  </div>
{%- endif -%}

