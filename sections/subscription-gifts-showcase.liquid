                  --sgs-value-gap: {{ section.settings.value_gap }}px;
                  --sgs-value-padding-y: {{ section.settings.value_padding_y }}px;
                  --sgs-value-padding-x: {{ section.settings.value_padding_x }}px;

                  --sgs-media-min-height: {{ section.settings.media_min_height }}px;
                  --sgs-media-min-height-mobile: {{ section.settings.media_min_height_mobile }}px;
                  --sgs-media-padding-top: {{ section.settings.media_padding_top }}px;
                  --sgs-media-padding-bottom: {{ section.settings.media_padding_bottom }}px;

                  --sgs-image-max-height: {{ section.settings.image_max_height }}px;
                  --sgs-image-max-height-mobile: {{ section.settings.image_max_height_mobile }}px;

                  --sgs-button-min-height: {{ section.settings.button_min_height }}px;
                  --sgs-button-font-size: {{ section.settings.button_font_size }}px;
                  --sgs-button-font-size-mobile: {{ section.settings.button_font_size_mobile }}px;
                  --sgs-button-gap: {{ section.settings.button_gap }}px;
                  --sgs-button-padding-y: {{ section.settings.button_padding_y }}px;
                  --sgs-button-padding-x: {{ section.settings.button_padding_x }}px;
                  --sgs-button-radius: {{ section.settings.button_radius }}px;
                  --sgs-button-arrow-size: {{ section.settings.button_arrow_size }}px;

                  --sgs-featured-price-bg: {{ section.settings.featured_price_badge_bg }};
                  --sgs-featured-price-bg-opacity: {{ section.settings.featured_price_badge_bg_opacity }}%;
                  --sgs-featured-price-color: {{ section.settings.featured_price_badge_color }};
                  --sgs-price-text-color: {{ section.settings.price_text_color }};
                  --sgs-free-text-color: {{ section.settings.free_text_color }};

                  --sgs-featured-price-text-color: {{ section.settings.featured_price_text_color }};
                  --sgs-featured-free-text-color: {{ section.settings.featured_free_text_color }};
