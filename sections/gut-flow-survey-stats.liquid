      "type": "range",
      "id": "circle_thickness",
      "label": "Circle thickness",
      "min": 4,
      "max": 30,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card minimum height desktop",
      "min": 140,
      "max": 300,
      "step": 2,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "card_padding_vertical",
      "label": "Card vertical padding desktop",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding_horizontal",
      "label": "Card horizontal padding desktop",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_gap",
