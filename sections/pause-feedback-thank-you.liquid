<section
        id="PauseFeedbackThankYou-{{ section.id }}"
        class="pause-feedback-thank-you"
>
    <div class="pause-feedback-thank-you__inner">

        {% if section.settings.logo != blank %}
            <div class="pause-feedback-thank-you__logo-wrap">
                {{
                section.settings.logo
                | image_url: width: 400
                | image_tag:
                loading: 'eager',
                widths: '120, 180, 240, 320, 400',
                class: 'pause-feedback-thank-you__logo',
                alt: shop.name
                }}
            </div>
        {% elsif section.settings.logo_text != blank %}
            <div class="pause-feedback-thank-you__logo-text">
                {{ section.settings.logo_text }}
            </div>
        {% endif %}

        {% if section.settings.show_icon %}
            <div class="pause-feedback-thank-you__icon">
                <svg
                        width="34"
                        height="34"
                        viewBox="0 0 34 34"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true"
                >
                    <path
                            d="M9 17.5L14.5 23L25 12"
                            stroke="currentColor"
                            stroke-width="2.7"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                    />
                </svg>
            </div>
        {% endif %}

        {% if section.settings.heading != blank %}
            <h2 class="pause-feedback-thank-you__heading">
                {{ section.settings.heading }}
            </h2>
        {% endif %}

        {% if section.settings.text != blank %}
            <div class="pause-feedback-thank-you__text rte">
                {{ section.settings.text }}
            </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
            <a
                    href="{{ section.settings.button_link | default: routes.root_url }}"
                    class="pause-feedback-thank-you__button"
            >
                {{ section.settings.button_label }}
            </a>
        {% endif %}

        {% if section.settings.bottom_text != blank %}
            <div class="pause-feedback-thank-you__bottom-text">
                {{ section.settings.bottom_text }}
            </div>
        {% endif %}

    </div>
</section>

<style>
    #PauseFeedbackThankYou-{{ section.id }} {
        background: {{ section.settings.background_color }};
        color: {{ section.settings.text_color }};
    }

    #PauseFeedbackThankYou-{{ section.id }}
    .pause-feedback-thank-you__inner {
        width: min(
                calc(100% - 32px),
      {{ section.settings.content_width }}px
        );
        margin: 0 auto;
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        text-align: center;
    }

    #PauseFeedbackThankYou-{{ section.id }}
    .pause-feedback-thank-you__logo-wrap {
        display: flex;
        justify-content: center;

        margin-bottom: {{ section.settings.logo_spacing }}px;
    }

    #PauseFeedbackThankYou-{{ section.id }}
    .pause-feedback-thank-you__logo {
        display: block;
        width: auto;
        max-width: {{ section.settings.logo_width }}px;
        height: auto;
    }

    #PauseFeedbackThankYou-{{ section.id }}
    .pause-feedback-thank-you__logo-text {
        margin-bottom: {{ section.settings.logo_spacing }}px;

        color: {{ section.settings.heading_color }};
        font-family: 'Inter Tight', system-ui, -apple-system, 'Segoe UI', sans-serif !important;
        font-size: {{ section.settings.logo_text_size }}px;
        line-height: 1;
        font-weight: 500;
    }

    #PauseFeedbackThankYou-{{ section.id }}
    .pause-feedback-thank-you__icon {
        display: grid;
        place-items: center;

        width: {{ section.settings.icon_size }}px;
        height: {{ section.settings.icon_size }}px;

        margin: 0 auto {{ section.settings.icon_spacing }}px;

        border-radius: 50%;

        background: {{ section.settings.icon_background }};
        color: {{ section.settings.icon_color }};
    }

    #PauseFeedbackThankYou-{{ section.id }}
    .pause-feedback-thank-you__heading {
        max-width: {{ section.settings.heading_width }}px;
        margin: 0 auto;
        font-family: initial !important;
        color: {{ section.settings.heading_color }};
        font-size: {{ section.settings.heading_size }}px;
        line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
        font-weight: {{ section.settings.heading_weight }};
        letter-spacing: -0.02em;
    }

    #PauseFeedbackThankYou-{{ section.id }}
    .pause-feedback-thank-you__text {
        max-width: {{ section.settings.text_width }}px;

        margin: {{ section.settings.text_spacing }}px auto 0;

        color: {{ section.settings.text_color }};

        font-size: {{ section.settings.text_size }}px;
        line-height: {{ section.settings.text_line_height | divided_by: 100.0 }};
    }

    #PauseFeedbackThankYou-{{ section.id }}
    .pause-feedback-thank-you__text p {
        margin: 0;
    }

    #PauseFeedbackThankYou-{{ section.id }}
    .pause-feedback-thank-you__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-width: {{ section.settings.button_width }}px;
        min-height: {{ section.settings.button_height }}px;

        margin-top: {{ section.settings.button_spacing }}px;
        padding: 10px 28px;

        border-radius: {{ section.settings.button_radius }}px;

        background: {{ section.settings.button_background }};
        color: {{ section.settings.button_color }};

        text-decoration: none;
        text-transform: {{ section.settings.button_text_transform }};

        font-size: {{ section.settings.button_text_size }}px;
        line-height: 1;
        font-weight: {{ section.settings.button_weight }};

        letter-spacing: {{ section.settings.button_letter_spacing | divided_by: 100.0 }}em;

        transition:
                opacity 0.2s ease,
                transform 0.2s ease;
    }

    #PauseFeedbackThankYou-{{ section.id }}
    .pause-feedback-thank-you__button:hover {
        opacity: 0.9;
    }

    #PauseFeedbackThankYou-{{ section.id }}
    .pause-feedback-thank-you__bottom-text {
        margin-top: {{ section.settings.bottom_spacing }}px;

        color: {{ section.settings.bottom_text_color }};

        font-size: {{ section.settings.bottom_text_size }}px;
        line-height: 1.4;
    }

    @media screen and (max-width: 749px) {
        #PauseFeedbackThankYou-{{ section.id }}
        .pause-feedback-thank-you__inner {
            width: min(
                    calc(100% - 28px),
        {{ section.settings.content_width }}px
            );

            padding-top: {{ section.settings.padding_top_mobile }}px;
            padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
        }

        #PauseFeedbackThankYou-{{ section.id }}
        .pause-feedback-thank-you__logo {
            max-width: {{ section.settings.logo_width_mobile }}px;
        }

        #PauseFeedbackThankYou-{{ section.id }}
        .pause-feedback-thank-you__logo-text {
            font-size: {{ section.settings.logo_text_size_mobile }}px;
        }

        #PauseFeedbackThankYou-{{ section.id }}
        .pause-feedback-thank-you__heading {
            font-size: {{ section.settings.heading_size_mobile }}px;
        }

        #PauseFeedbackThankYou-{{ section.id }}
        .pause-feedback-thank-you__text {
            font-size: {{ section.settings.text_size_mobile }}px;
        }

        #PauseFeedbackThankYou-{{ section.id }}
        .pause-feedback-thank-you__bottom-text {
            font-size: {{ section.settings.bottom_text_size_mobile }}px;
        }

    {% if section.settings.button_full_mobile %}
        #PauseFeedbackThankYou-{{ section.id }}
        .pause-feedback-thank-you__button {
            width: 100%;
            min-width: 0;
        }
    {% endif %}
    }
</style>

{% schema %}
{
