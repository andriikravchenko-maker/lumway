        "rich_text_36ymb9": {
          "type": "rich_text",
          "settings": {
            "content": "<p><strong>Eating less does not automatically mean eating better.</strong></p><p>In fact, many popular <strong>weight-loss routines unintentionally reduce</strong> some of the <strong>foods that contribute fiber.</strong><br/>You may consume <strong>fewer calories</strong> while also consuming <strong>less fiber.</strong></p><p>That can leave digestion feeling slower and bowel movements less predictable.<br/><strong>And when your digestive routine is off, you may notice:</strong></p>",
            "order_desktop": "3",
            "order_mobile": "3",
            "color": "#111111",
            "size_desktop": 18,
            "size_mobile": 16,
            "line_height_desktop": 1.4,
