<script>
(() => {
const section = document.getElementById(
'QuizResultSlider-{{ section.id }}'
);

if (!section || section.dataset.initialized === 'true') return;

section.dataset.initialized = 'true';

const slides = Array.from(
section.querySelectorAll('[data-quiz-slide]')
);

const continueButton = section.querySelector(
'[data-quiz-continue]'
);

const continueLabel = section.querySelector(
'[data-continue-label]'
);

const backButton = section.querySelector(
'[data-quiz-back]'
);

const params = new URLSearchParams(window.location.search);

const checkoutConfig = {
variantId: {{ checkout_variant.id | default: 0 | json }},
quantity: {{ section.settings.checkout_quantity | default: 1 | json }},
sellingPlanId: {{ checkout_selling_plan.id | default: 0 | json }}
};

const data = {
age: parseNumber(params.get('age')),
height: parseNumber(params.get('height')),
currentWeight: parseNumber(params.get('currentWeight')),
targetWeight: parseNumber(params.get('targetWeight')),
gender: params.get('gender') || '{{ section.settings.default_gender | escape }}'
};

let activeSlide = 0;
let isAddingToCart = false;


function parseNumber(value) {
const number = Number.parseFloat(value);

return Number.isFinite(number)
? number
: null;
}


function setText(selector, value) {
section.querySelectorAll(selector).forEach((element) => {
element.textContent =
value !== null &&
value !== undefined &&
value !== ''
? value
: '—';
});
}


function formatWeight(value) {
if (value === null) return '—';

return Math.round(value);
}


function calculateBMI() {
if (!data.height || !data.currentWeight) return null;

const weightKg = data.currentWeight * 0.45359237;
const heightM = data.height / 100;

if (!heightM) return null;

return weightKg / (heightM * heightM);
}


function getBMIDescription(bmi) {
if (bmi === null) return '—';

if (bmi < 18.5) {
return 'Below the range most guidelines call healthy';
}

if (bmi < 25) {
return 'Within the range most guidelines call healthy';
}

if (bmi < 30) {
return 'Above the range most guidelines call healthy';
}

return 'Above the range most guidelines call healthy';
}


function getMetabolicAge(bmi) {
if (!data.age) return null;

if (!bmi) return data.age;

if (bmi < 25) {
return data.age;
}

if (bmi < 30) {
return data.age + 3;
}

if (bmi < 35) {
return data.age + 5;
}

return data.age + 8;
}


function getTimelineMonths() {
if (!data.currentWeight || !data.targetWeight) {
return 5;
}

const difference = Math.max(
0,
data.currentWeight - data.targetWeight
);

return Math.max(
1,
Math.ceil(difference / 8)
);
}


function formatMonth(date) {
return new Intl.DateTimeFormat('en-US', {
month: 'short',
year: 'numeric'
}).format(date);
}


function renderBasicData() {
setText(
'[data-current-weight]',
formatWeight(data.currentWeight)
);

setText(
'[data-target-weight]',
formatWeight(data.targetWeight)
);

setText(
'[data-summary-age]',
data.age ? Math.round(data.age) : null
);

setText(
'[data-summary-height]',
data.height ? Math.round(data.height) : null
);

setText(
'[data-summary-weight]',
formatWeight(data.currentWeight)
);

setText(
'[data-summary-gender]',
data.gender
);

const bmi = calculateBMI();

setText(
'[data-bmi]',
bmi ? bmi.toFixed(1) : null
);

setText(
'[data-bmi-description]',
getBMIDescription(bmi)
);

setText(
'[data-metabolic-age]',
getMetabolicAge(bmi)
);
}


function renderTimeline() {
const now = new Date();

const targetDate = new Date(now);

targetDate.setMonth(
targetDate.getMonth() + getTimelineMonths()
);

setText(
'[data-current-month]',
formatMonth(now)
);

setText(
'[data-target-month]',
formatMonth(targetDate)
);

if (!data.currentWeight || !data.targetWeight) return;

const totalLoss = Math.max(
0,
data.currentWeight - data.targetWeight
);

const firstLoss = Math.min(
Math.max(Math.round(totalLoss * 0.4), 1),
totalLoss
);

const x1 = 125;
const y1 = 70;

const x2 = 500;
const y2 = 135;

const line = section.querySelector(
'[data-timeline-line]'
);

const area = section.querySelector(
'[data-timeline-area]'
);

const pointOne = section.querySelector(
'[data-timeline-point-one]'
);

const pointTwo = section.querySelector(
'[data-timeline-point-two]'
);

if (line) {
line.setAttribute(
'd',
`M 0 20
C 100 60, 250 105, 500 135`
);
}

if (area) {
area.setAttribute(
'd',
`M 0 20
C 100 60, 250 105, 500 135
L 500 150
L 0 150
Z`
);
}

if (pointOne) {
pointOne.setAttribute('cx', x1);
pointOne.setAttribute('cy', y1);
}

if (pointTwo) {
pointTwo.setAttribute('cx', x2);
pointTwo.setAttribute('cy', y2);
}

setText(
'[data-timeline-label-one]',
`-${firstLoss} lb`
);

setText(
'[data-timeline-label-two]',
`-${Math.round(totalLoss)} lb`
);
}


function renderMonthProgress() {
if (!data.currentWeight || !data.targetWeight) return;

const totalDifference = Math.max(
0,
data.currentWeight - data.targetWeight
);

const firstMonthLoss = Math.min(
9,
totalDifference
);

setText(
'[data-first-month-loss]',
`-${Math.round(firstMonthLoss)} lb`
);

const weeklyLoss = firstMonthLoss / 4;

const weights = Array.from(
{ length: 4 },
(_, index) => {
return data.currentWeight -
weeklyLoss * (index + 1);
}
);

weights.forEach((weight, index) => {
setText(
`[data-week-weight="${index}"]`,
`${formatWeight(weight)} lb`
);
});

const points = [
{ x: 40, y: 30 },
{ x: 190, y: 65 },
{ x: 340, y: 100 },
{ x: 480, y: 125 }
];

const line = section.querySelector(
'[data-month-line]'
);

if (line) {
line.setAttribute(
'd',
`
M ${points[0].x} ${points[0].y}
C 110 42,
135 54,
${points[1].x} ${points[1].y}
S 280 90,
${points[2].x} ${points[2].y}
S 430 125,
${points[3].x} ${points[3].y}
`
);
}

const pointsContainer = section.querySelector(
'[data-week-points]'
);

if (pointsContainer) {
pointsContainer.innerHTML = points
.map((point) => {
return `
<circle
cx="${point.x}"
cy="${point.y}"
r="6"
fill="var(--qrs-accent)"
stroke="var(--qrs-card-bg)"
stroke-width="2"
/>
`;
})
.join('');
}
}


function showSlide(index) {
slides.forEach((slide, slideIndex) => {
const active = slideIndex === index;

slide.hidden = !active;
slide.classList.toggle(
'is-active',
active
);
});

activeSlide = index;

if (continueLabel) {
continueLabel.textContent =
activeSlide === slides.length - 1
? '{{ section.settings.checkout_label | escape }}'
: '{{ section.settings.continue_label | escape }}';
}

section.scrollIntoView({
behavior: 'smooth',
block: 'start'
});
}


async function addProductAndCheckout() {
if (isAddingToCart) return;

if (!checkoutConfig.variantId) {
console.error('[Quiz Result] Checkout product is not configured.');
return;
}

isAddingToCart = true;
continueButton.disabled = true;

const originalLabel = continueLabel?.textContent;

if (continueLabel) {
continueLabel.textContent = 'Loading...';
}

const item = {
id: Number(checkoutConfig.variantId),
quantity: Number(checkoutConfig.quantity) || 1
};

if (
checkoutConfig.sellingPlanId &&
String(checkoutConfig.sellingPlanId).trim()
) {
item.selling_plan = Number(checkoutConfig.sellingPlanId);
}

try {
const root = window.Shopify?.routes?.root || '/';

const response = await fetch(`${root}cart/add.js`, {
method: 'POST',
headers: {
'Content-Type': 'application/json',
'Accept': 'application/json'
},
body: JSON.stringify({
items: [item]
})
});

if (!response.ok) {
const error = await response.json().catch(() => null);

throw new Error(
error?.description ||
error?.message ||
'Unable to add product to cart.'
);
}

window.location.assign(`${root}checkout`);
} catch (error) {
console.error('[Quiz Result] Checkout error:', error);

isAddingToCart = false;
continueButton.disabled = false;

if (continueLabel) {
continueLabel.textContent =
originalLabel ||
'{{ section.settings.checkout_label | escape }}';
}
}
}


backButton?.addEventListener('click', () => {
if (activeSlide > 0) {
showSlide(activeSlide - 1);
return;
}

const backUrl = {{ section.settings.back_url | json }};

if (backUrl) {
window.location.assign(backUrl);
return;
}

window.history.back();
});


continueButton?.addEventListener('click', async () => {
if (activeSlide < slides.length - 1) {
showSlide(activeSlide + 1);
return;
}

await addProductAndCheckout();
});


renderBasicData();
renderTimeline();
renderMonthProgress();
})();
</script>


