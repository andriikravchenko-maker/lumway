{% comment %}
  MM Gut Flow Support
  Block based section: heading, rich text, icon benefits, stat card.
{% endcomment %}

{%- assign sid = section.id -%}

<section id="mm-gut-flow-support-{{ sid }}" class="mm-gfs mm-gfs--{{ sid }}">
  <div class="mm-gfs__inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <div
            class="mm-gfs__heading-wrap mm-gfs__full"
            style="--od:{{ block.settings.order_desktop }};--om:{{ block.settings.order_mobile }};--mw-d:{{ block.settings.max_width_desktop }}px;--mw-m:{{ block.settings.max_width_mobile }}px;--ta-d:{{ block.settings.align_desktop }};--ta-m:{{ block.settings.align_mobile }};--c:{{ block.settings.color }};--ac:{{ block.settings.accent_color }};--fs-d:{{ block.settings.size_desktop }}px;--fs-m:{{ block.settings.size_mobile }}px;--fw:{{ block.settings.weight }};--lh-d:{{ block.settings.line_height_desktop }};--lh-m:{{ block.settings.line_height_mobile }};--mb-d:{{ block.settings.margin_bottom_desktop }}px;--mb-m:{{ block.settings.margin_bottom_mobile }}px;"
            {{ block.shopify_attributes }}
          >
            <div class="mm-gfs__heading-inner">
              <{{ block.settings.tag }} class="mm-gfs__heading">
                {%- if block.settings.accent_text != blank
                  and block.settings.heading contains block.settings.accent_text
                -%}
                  {%- capture accent -%}<span class="mm-gfs__accent">{{ block.settings.accent_text }}</span>{%- endcapture -%}
                  {{ block.settings.heading | replace: block.settings.accent_text, accent }}
                {%- else -%}
                  {{ block.settings.heading }}
                {%- endif -%}
              </{{ block.settings.tag }}>
            </div>
          </div>

        {%- when 'rich_text' -%}
          <div
            class="mm-gfs__rich mm-gfs__full"
            style="--od:{{ block.settings.order_desktop }};--om:{{ block.settings.order_mobile }};--mw-d:{{ block.settings.max_width_desktop }}px;--mw-m:{{ block.settings.max_width_mobile }}px;--ta-d:{{ block.settings.align_desktop }};--ta-m:{{ block.settings.align_mobile }};--c:{{ block.settings.color }};--fs-d:{{ block.settings.size_desktop }}px;--fs-m:{{ block.settings.size_mobile }}px;--lh-d:{{ block.settings.line_height_desktop }};--lh-m:{{ block.settings.line_height_mobile }};--mt-d:{{ block.settings.margin_top_desktop }}px;--mb-d:{{ block.settings.margin_bottom_desktop }}px;--mt-m:{{ block.settings.margin_top_mobile }}px;--mb-m:{{ block.settings.margin_bottom_mobile }}px;"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.content }}
          </div>

        {%- when 'icon_item' -%}
          <div
            class="mm-gfs__item"
            style="--od:{{ block.settings.order_desktop }};--om:{{ block.settings.order_mobile }};--bg:{{ block.settings.background }};--bd:{{ block.settings.border_color }};--bw:{{ block.settings.border_width }}px;--r-d:{{ block.settings.radius_desktop }}px;--r-m:{{ block.settings.radius_mobile }}px;--py-d:{{ block.settings.padding_y_desktop }}px;--px-d:{{ block.settings.padding_x_desktop }}px;--py-m:{{ block.settings.padding_y_mobile }}px;--px-m:{{ block.settings.padding_x_mobile }}px;--gap-d:{{ block.settings.gap_desktop }}px;--gap-m:{{ block.settings.gap_mobile }}px;--is-d:{{ block.settings.icon_size_desktop }}px;--is-m:{{ block.settings.icon_size_mobile }}px;--ic:{{ block.settings.icon_color }};--tc:{{ block.settings.text_color }};--ts-d:{{ block.settings.text_size_desktop }}px;--ts-m:{{ block.settings.text_size_mobile }}px;--tw:{{ block.settings.text_weight }};--tlh-d:{{ block.settings.text_line_height_desktop }};--tlh-m:{{ block.settings.text_line_height_mobile }};"
            {{ block.shopify_attributes }}
          >
            <span class="mm-gfs__icon" aria-hidden="true">
              {%- if block.settings.icon_image != blank -%}
                {{
                  block.settings.icon_image
                  | image_url: width: 160
                  | image_tag: loading: 'lazy', widths: '48,64,96,128,160', sizes: '40px', alt: ''
                }}
              {%- elsif block.settings.icon_svg != blank -%}
                {{ block.settings.icon_svg }}
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M5 12.5l4 4L19 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- endif -%}
            </span>
            <div class="mm-gfs__item-text">{{ block.settings.text }}</div>
          </div>

        {%- when 'stat_card' -%}
          {%- assign statistic_number = block.settings.statistic_number | default: 89 -%}
          {%- assign statistic_suffix = block.settings.statistic_suffix | default: '%' -%}
          {%- assign circle_percentage = block.settings.circle_percentage | default: 89 | at_least: 0 | at_most: 100 -%}

          <div
            class="mm-gfs__stat mm-gfs__full"
            data-mm-gfs-stat
            data-statistic-number="{{ statistic_number }}"
            data-statistic-suffix="{{ statistic_suffix | escape }}"
            data-circle-percentage="{{ circle_percentage }}"
            style="--od:{{ block.settings.order_desktop }};--om:{{ block.settings.order_mobile }};--bg:{{ block.settings.background }};--r-d:{{ block.settings.radius_desktop }}px;--r-m:{{ block.settings.radius_mobile }}px;--p-d:{{ block.settings.padding_desktop }}px;--p-m:{{ block.settings.padding_mobile }}px;--track:{{ block.settings.ring_track_color }};--prog:{{ block.settings.ring_progress_color }};--ring-d:{{ block.settings.ring_size_desktop }}px;--ring-m:{{ block.settings.ring_size_mobile }}px;--rw:{{ block.settings.ring_width }};--pc:{{ block.settings.percent_color }};--ps-d:{{ block.settings.percent_size_desktop }}px;--ps-m:{{ block.settings.percent_size_mobile }}px;--bc:{{ block.settings.body_color }};--bs-d:{{ block.settings.body_size_desktop }}px;--bs-m:{{ block.settings.body_size_mobile }}px;--nc:{{ block.settings.note_color }};--ns-d:{{ block.settings.note_size_desktop }}px;--ns-m:{{ block.settings.note_size_mobile }}px;--stat-gap-d:{{ block.settings.gap_desktop }}px;--stat-gap-m:{{ block.settings.gap_mobile }}px;"
            {{ block.shopify_attributes }}
          >
            <div
              class="mm-gfs__progress"
              data-mm-gfs-progress
              role="img"
              aria-label="{{ circle_percentage }} percent"
            >
              <svg
                class="mm-gfs__progress-svg"
                viewBox="0 0 100 100"
                aria-hidden="true"
                focusable="false"
              >
                <circle
                        class="mm-gfs__progress-track"
                        cx="50"
                        cy="50"
                        r="42"
                        pathLength="100"
                ></circle>
                <circle
                        class="mm-gfs__progress-value"
                        data-mm-gfs-progress-value
                        cx="50"
                        cy="50"
                        r="42"
                        pathLength="100"
                ></circle>
              </svg>
            </div>

            <div
              class="mm-gfs__percent"
              data-mm-gfs-counter
              aria-label="{{ statistic_number }}{{ statistic_suffix }}"
            >
              0{{ statistic_suffix }}
            </div>

            <div class="mm-gfs__stat-copy">
              <div class="mm-gfs__stat-body">{{ block.settings.body }}</div>
              {%- if block.settings.note != blank -%}
                <div class="mm-gfs__note">{{ block.settings.note }}</div>
              {%- endif -%}
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% style %}
  .mm-gfs--{{ sid }}{
  background:{{ section.settings.background }};
  padding:{{ section.settings.padding_top_desktop }}px {{ section.settings.padding_horizontal_desktop }}px {{ section.settings.padding_bottom_desktop }}px;
  }
  .mm-gfs--{{ sid }} .mm-gfs__inner{
  max-width:{{ section.settings.max_width }}px;
  margin:0 auto;
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:{{ section.settings.row_gap_desktop }}px {{ section.settings.column_gap_desktop }}px;
  }
  .mm-gfs--{{ sid }} .mm-gfs__full{grid-column:1/-1;}
  .mm-gfs--{{ sid }} .mm-gfs__heading-wrap,
  .mm-gfs--{{ sid }} .mm-gfs__rich,
  .mm-gfs--{{ sid }} .mm-gfs__item,
  .mm-gfs--{{ sid }} .mm-gfs__stat{order:var(--od);}

  .mm-gfs--{{ sid }} .mm-gfs__heading-wrap{margin-bottom:var(--mb-d);}
  .mm-gfs--{{ sid }} .mm-gfs__heading-inner{max-width:var(--mw-d);margin:0 auto;text-align:var(--ta-d);}
  .mm-gfs--{{ sid }} .mm-gfs__heading{margin:0!important;color:var(--c)!important;-webkit-text-fill-color:var(--c)!important;font-size:var(--fs-d)!important;font-weight:var(--fw)!important;line-height:var(--lh-d)!important;text-wrap:balance;}
  .mm-gfs--{{ sid }} .mm-gfs__accent{color:var(--ac)!important;-webkit-text-fill-color:var(--ac)!important;}

  .mm-gfs--{{ sid }} .mm-gfs__rich{max-width:var(--mw-d);margin:var(--mt-d) auto var(--mb-d);text-align:var(--ta-d);color:var(--c);font-size:var(--fs-d);line-height:var(--lh-d);}
  .mm-gfs--{{ sid }} .mm-gfs__rich,.mm-gfs--{{ sid }} .mm-gfs__rich *{color:var(--c)!important;-webkit-text-fill-color:var(--c)!important;font-size:var(--fs-d)!important;line-height:var(--lh-d)!important;}
  .mm-gfs--{{ sid }} .mm-gfs__rich p{margin:0 0 1.25em!important;}.mm-gfs--{{ sid }} .mm-gfs__rich p:last-child{margin-bottom:0!important;}

  .mm-gfs--{{ sid }} .mm-gfs__item{display:flex;align-items:center;gap:var(--gap-d);padding:var(--py-d) var(--px-d);background:var(--bg);border:var(--bw) solid var(--bd);border-radius:var(--r-d);box-sizing:border-box;min-width:0;}
  .mm-gfs--{{ sid }} .mm-gfs__icon{width:var(--is-d);height:var(--is-d);flex:0 0 var(--is-d);display:flex;align-items:center;justify-content:center;color:var(--ic);}
  .mm-gfs--{{ sid }} .mm-gfs__icon svg,.mm-gfs--{{ sid }} .mm-gfs__icon img{width:100%;height:100%;display:block;object-fit:contain;}
  .mm-gfs--{{ sid }} .mm-gfs__item-text,.mm-gfs--{{ sid }} .mm-gfs__item-text *{color:var(--tc)!important;-webkit-text-fill-color:var(--tc)!important;font-size:var(--ts-d)!important;font-weight:var(--tw)!important;line-height:var(--tlh-d)!important;}
  .mm-gfs--{{ sid }} .mm-gfs__item-text p{margin:0!important;}

  .mm-gfs--{{ sid }} .mm-gfs__stat{
  display:grid;
  grid-template-columns:var(--ring-d) auto minmax(0,1fr);
  align-items:center;
  gap:var(--stat-gap-d);
  padding:var(--p-d);
  background:var(--bg);
  border-radius:var(--r-d);
  box-sizing:border-box;
  overflow:hidden;
  }

  .mm-gfs--{{ sid }} .mm-gfs__progress{
  display:block;
  width:var(--ring-d);
  height:var(--ring-d);
  min-width:0;
  }

  .mm-gfs--{{ sid }} .mm-gfs__progress-svg{
  display:block;
  width:100%;
  height:100%;
  overflow:visible;
  transform:rotate(-90deg);
  transform-origin:50% 50%;
  }

  .mm-gfs--{{ sid }} .mm-gfs__progress-track,
  .mm-gfs--{{ sid }} .mm-gfs__progress-value{
  fill:none;
  stroke-width:var(--rw);
  }

  .mm-gfs--{{ sid }} .mm-gfs__progress-track{stroke:var(--track);}

  .mm-gfs--{{ sid }} .mm-gfs__progress-value{
  stroke:var(--prog);
  stroke-linecap:round;
  stroke-dasharray:0 100;
  stroke-dashoffset:0;
  }

  .mm-gfs--{{ sid }} .mm-gfs__percent{
  margin:0;
  color:var(--pc)!important;
  -webkit-text-fill-color:var(--pc)!important;
  font-size:var(--ps-d)!important;
  font-weight:700!important;
  line-height:.9!important;
  letter-spacing:-.055em;
  white-space:nowrap;
  }

  .mm-gfs--{{ sid }} .mm-gfs__stat-copy{min-width:0;}

  .mm-gfs--{{ sid }} .mm-gfs__stat-body,
  .mm-gfs--{{ sid }} .mm-gfs__stat-body *{
  color:var(--bc)!important;
  -webkit-text-fill-color:var(--bc)!important;
  font-size:var(--bs-d)!important;
  line-height:1.3!important;
  }

  .mm-gfs--{{ sid }} .mm-gfs__stat-body p{margin:0!important;}

  .mm-gfs--{{ sid }} .mm-gfs__note{
  margin-top:6px;
  color:var(--nc)!important;
  -webkit-text-fill-color:var(--nc)!important;
  font-size:var(--ns-d)!important;
  line-height:1.25;
  }

  @media(max-width:989px){
  .mm-gfs--{{ sid }}{padding:{{ section.settings.padding_top_mobile }}px {{ section.settings.padding_horizontal_mobile }}px {{ section.settings.padding_bottom_mobile }}px;}
  .mm-gfs--{{ sid }} .mm-gfs__inner{display:flex;flex-direction:column;gap:{{ section.settings.row_gap_mobile }}px;}
  .mm-gfs--{{ sid }} .mm-gfs__heading-wrap,
  .mm-gfs--{{ sid }} .mm-gfs__rich,
  .mm-gfs--{{ sid }} .mm-gfs__item,
  .mm-gfs--{{ sid }} .mm-gfs__stat{order:var(--om);width:100%;}
  .mm-gfs--{{ sid }} .mm-gfs__heading-wrap{margin-bottom:var(--mb-m);}
  .mm-gfs--{{ sid }} .mm-gfs__heading-inner{max-width:var(--mw-m);text-align:var(--ta-m);}
  .mm-gfs--{{ sid }} .mm-gfs__heading{font-size:var(--fs-m)!important;line-height:var(--lh-m)!important;}
  .mm-gfs--{{ sid }} .mm-gfs__rich{max-width:var(--mw-m);margin:var(--mt-m) auto var(--mb-m);text-align:var(--ta-m);}
  .mm-gfs--{{ sid }} .mm-gfs__rich,.mm-gfs--{{ sid }} .mm-gfs__rich *{font-size:var(--fs-m)!important;line-height:var(--lh-m)!important;}
  .mm-gfs--{{ sid }} .mm-gfs__item{gap:var(--gap-m);padding:var(--py-m) var(--px-m);border-radius:var(--r-m);}
  .mm-gfs--{{ sid }} .mm-gfs__icon{width:var(--is-m);height:var(--is-m);flex-basis:var(--is-m);}
  .mm-gfs--{{ sid }} .mm-gfs__item-text,.mm-gfs--{{ sid }} .mm-gfs__item-text *{font-size:var(--ts-m)!important;line-height:var(--tlh-m)!important;}
  .mm-gfs--{{ sid }} .mm-gfs__stat{
  grid-template-columns:var(--ring-m) minmax(0,1fr);
  grid-template-rows:auto auto;
  gap:8px var(--stat-gap-m);
  padding:var(--p-m);
  border-radius:var(--r-m);
  }

  .mm-gfs--{{ sid }} .mm-gfs__progress{
  grid-column:1;
  grid-row:1/3;
  width:var(--ring-m);
  height:var(--ring-m);
  align-self:center;
  }

  .mm-gfs--{{ sid }} .mm-gfs__percent{
  grid-column:2;
  grid-row:1;
  font-size:var(--ps-m)!important;
  align-self:end;
  }

  .mm-gfs--{{ sid }} .mm-gfs__stat-copy{
  grid-column:2;
  grid-row:2;
  align-self:start;
  }

  .mm-gfs--{{ sid }} .mm-gfs__stat-body,
  .mm-gfs--{{ sid }} .mm-gfs__stat-body *{font-size:var(--bs-m)!important;}

  .mm-gfs--{{ sid }} .mm-gfs__note{font-size:var(--ns-m)!important;}
  }
{% endstyle %}

<script>
    (() => {
        const sectionId = 'mm-gut-flow-support-{{ sid }}';

        const initMMGutFlowStat = () => {
            const section = document.getElementById(sectionId);

            if (!section || section.dataset.mmGfsStatInitialized === 'true') return;

            const cards = Array.from(section.querySelectorAll('[data-mm-gfs-stat]'));
            if (!cards.length) return;

            section.dataset.mmGfsStatInitialized = 'true';

            const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
            const configuredDuration = {{ section.settings.stat_animation_duration | default: 1200 }};
            const duration = Number.isFinite(Number(configuredDuration))
                ? Math.max(200, Number(configuredDuration))
                : 1200;

            let observer = null;
            let frameId = null;
            let runId = 0;
            let isInsideViewport = false;

            const clamp = (value, min, max) => {
                const parsed = Number(value);
                if (!Number.isFinite(parsed)) return min;
                return Math.min(max, Math.max(min, parsed));
            };

            const getValues = (card) => ({
                statisticNumber: clamp(card.dataset.statisticNumber, 0, 999999),
                circlePercentage: clamp(card.dataset.circlePercentage, 0, 100),
                suffix: card.dataset.statisticSuffix || ''
            });

            const updateCard = (card, currentNumber, currentCircle) => {
                const progress = card.querySelector('[data-mm-gfs-progress]');
                const circle = card.querySelector('[data-mm-gfs-progress-value]');
                const counter = card.querySelector('[data-mm-gfs-counter]');
                const values = getValues(card);

                const safeNumber = clamp(currentNumber, 0, 999999);
                const safeCircle = clamp(currentCircle, 0, 100);
                const remaining = Math.max(0, 100 - safeCircle);
                const rounded = Math.round(safeNumber);

                if (circle) {
                    circle.style.strokeDasharray = `${safeCircle.toFixed(3)} ${remaining.toFixed(3)}`;
                }

                if (progress) {
                    progress.setAttribute('aria-label', `${Math.round(safeCircle)} percent`);
                }

                if (counter) {
                    const text = `${rounded}${values.suffix}`;
                    counter.textContent = text;
                    counter.setAttribute('aria-label', text);
                }
            };

            const cancel = () => {
                runId += 1;
                if (frameId !== null) {
                    cancelAnimationFrame(frameId);
                    frameId = null;
                }
            };

            const reset = () => {
                cancel();
                cards.forEach(card => updateCard(card, 0, 0));
            };

            const setFinal = () => {
                cancel();
                cards.forEach(card => {
                    const values = getValues(card);
                    updateCard(card, values.statisticNumber, values.circlePercentage);
                });
            };

            const animate = () => {
                cancel();

                if (motionQuery.matches) {
                    setFinal();
                    return;
                }

                const activeRun = runId;
                const start = performance.now();

                cards.forEach(card => updateCard(card, 0, 0));

                const render = now => {
                    if (activeRun !== runId || !isInsideViewport) return;

                    const linear = Math.min((now - start) / duration, 1);
                    const eased = 1 - Math.pow(1 - linear, 3);

                    cards.forEach(card => {
                        const values = getValues(card);
                        updateCard(
                            card,
                            values.statisticNumber * eased,
                            values.circlePercentage * eased
                        );
                    });

                    if (linear < 1) {
                        frameId = requestAnimationFrame(render);
                    } else {
                        frameId = null;
                        cards.forEach(card => {
                            const values = getValues(card);
                            updateCard(card, values.statisticNumber, values.circlePercentage);
                        });
                    }
                };

                frameId = requestAnimationFrame(render);
            };

            reset();

            if (!('IntersectionObserver' in window)) {
                isInsideViewport = true;
                setFinal();
                return;
            }

            observer = new IntersectionObserver(entries => {
                entries.forEach(entry => {
                    if (entry.target !== section) return;

                    if (entry.isIntersecting) {
                        if (!isInsideViewport) {
                            isInsideViewport = true;
                            animate();
                        }
                    } else if (isInsideViewport) {
                        isInsideViewport = false;
                        reset();
                    }
                });
            }, {
                threshold: 0.2,
                rootMargin: '0px 0px -5% 0px'
            });

            observer.observe(section);

            section.mmGfsStatDestroy = () => {
                isInsideViewport = false;
                cancel();
                if (observer) observer.disconnect();
                observer = null;
                delete section.dataset.mmGfsStatInitialized;
                delete section.mmGfsStatDestroy;
            };
        };

        initMMGutFlowStat();

        document.addEventListener('shopify:section:load', event => {
            if (event.target && event.target.querySelector(`#${sectionId}`)) {
                initMMGutFlowStat();
            }
        });

        document.addEventListener('shopify:section:unload', event => {
            const section = document.getElementById(sectionId);
            if (
                section &&
                event.target &&
                event.target.contains(section) &&
                typeof section.mmGfsStatDestroy === 'function'
            ) {
                section.mmGfsStatDestroy();
            }
        });
    })();
</script>

{% schema %}
{
  "name": "MM Gut Flow Support",
  "settings": [
    { "type": "color", "id": "background", "label": "Section background", "default": "#FBF2F4" },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 700,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 900
    },
    { "type": "header", "content": "Desktop" },
    {
      "type": "range",
      "id": "column_gap_desktop",
      "label": "Column gap",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "label": "Row gap",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_horizontal_desktop",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    { "type": "header", "content": "Mobile" },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "Block gap",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "label": "Side padding",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    { "type": "header", "content": "Stat animation" },
    {
      "type": "range",
      "id": "stat_animation_duration",
      "label": "Stat animation duration",
      "min": 400,
      "max": 2400,
