{%- comment -%} Corporate "Who We Work With": intro + client-profile cards. Blocks via content group. {%- endcomment -%}
<section class="section" id="clients">
  <div class="container">
    <div class="section-head"><h2>{{ section.settings.heading | default: 'Who We Work With' }}</h2></div>
    <div class="clients-grid">
      {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro }}</p>{%- endif -%}
      <ul class="profile-list">
        {%- for block in section.blocks -%}
          <li data-tone="{{ block.settings.tone }}" {{ block.shopify_attributes }}>
            <span class="profile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 19 6v5c0 4.4-2.8 7.8-7 10-4.2-2.2-7-5.6-7-10V6l7-3Z"/><path d="m8.8 12 2.1 2.1 4.4-4.5"/></svg></span>
            <span>{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
{% style %}
  .lw-corp #clients{ padding-block:clamp(5rem, 10vh, 8rem); padding-bottom:clamp(1.75rem, 4vh, 3rem); }
  .lw-corp #clients .section-head{ max-width:62rem; margin-inline:auto; }
  .lw-corp #clients .section-head h2{ font-size:clamp(2.4rem, 5vw, 4.75rem); }
  .lw-corp .clients-grid{ display:block; max-width:62rem; margin-inline:auto; }
  .lw-corp .clients-grid > p{ margin:0 0 2rem; max-width:42rem; color:var(--muted-foreground); font-size:1.1rem; line-height:1.7; }
  .lw-corp .profile-list{ list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(3, 1fr); gap:1rem; }
  .lw-corp .profile-list li{ display:flex; align-items:flex-start; gap:1.25rem; padding:1.5rem; border-radius:1.25rem; background:var(--paper-card); box-shadow:0 1rem 2.5rem oklch(0.18 0.018 345 / 0.04); font-size:1.05rem; font-weight:500; line-height:1.35; }
  .lw-corp .profile-icon{ display:grid; flex:0 0 2.75rem; width:2.75rem; height:2.75rem; place-items:center; border-radius:50%; color:var(--sage); background:oklch(0.46 0.08 155 / 0.1); }
  .lw-corp .profile-list li[data-tone="plum"] .profile-icon{ color:var(--brand); background:oklch(0.42 0.09 350 / 0.1); }
  .lw-corp .profile-list li[data-tone="gold"] .profile-icon{ color:var(--gold-deep); background:oklch(0.8 0.13 82 / 0.16); }
  .lw-corp .profile-icon svg{ width:1.4rem; height:1.4rem; fill:none; stroke:currentColor; stroke-width:1.65; stroke-linecap:round; stroke-linejoin:round; }
  @media (max-width:860px){ .lw-corp .profile-list{ grid-template-columns:1fr; } }
{% endstyle %}
{% schema %}
{
  "name": "Corporate Clients",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who We Work With" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "We work with early- and growth-stage consumer health and wellness brands operating in the US market, including companies managing dietary supplement labeling and advertising compliance, entering new product categories, or evaluating manufacturing and sourcing partners." }
  ],
  "blocks": [
    { "type": "profile", "name": "Profile", "settings": [
      { "type": "select", "id": "tone", "label": "Accent", "default": "sage", "options": [
        { "value": "sage", "label": "Sage" }, { "value": "plum", "label": "Plum" }, { "value": "gold", "label": "Gold" } ] },
      { "type": "text", "id": "label", "label": "Label", "default": "Client profile" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Corporate Clients" }]
}
{% endschema %}
