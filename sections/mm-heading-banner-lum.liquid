<section
  class="mm-heading-banner-lum section-{{ section.id }}"
  style="
    --banner-bg: {{ section.settings.background_color }};
    --banner-text: {{ section.settings.text_color }};
    --banner-accent: {{ section.settings.accent_color }};
    --banner-max-width: {{ section.settings.max_width }}px;
    --banner-font-size: {{ section.settings.font_size }}px;
    --banner-font-size-mobile: {{ section.settings.font_size_mobile }}px;
    --banner-padding-top: {{ section.settings.padding_top }}px;
    --banner-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="mm-heading-banner-lum__inner">
    <h2 class="mm-heading-banner-lum__heading">
  {%- if section.settings.accent_text != blank -%}
    <span class="mm-heading-banner-lum__accent">
      {{ section.settings.accent_text | escape }}
    </span>
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <span class="mm-heading-banner-lum__text">
      {{ section.settings.heading | escape }}
    </span>
  {%- endif -%}
</h2>
  </div>
</section>

{% style %}
  .section-{{ section.id }} {
    background: var(--banner-bg);
    padding-top: var(--banner-padding-top);
    padding-bottom: var(--banner-padding-bottom);
  }

  .section-{{ section.id }} .mm-heading-banner-lum__inner {
    width: 100%;
    max-width: var(--banner-max-width);
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
    box-sizing: border-box;
  }

.section-{{ section.id }} .mm-heading-banner-lum__heading {
  margin: 0;
  font-family: 'Inter Tight', system-ui, sans-serif !important;
  font-size: var(--banner-font-size);
  font-weight: 700 !important;
  line-height: 1.1;
  letter-spacing: -0.03em;
  text-align: center;
  color: var(--banner-text) !important;
}

.section-{{ section.id }} .mm-heading-banner-lum__heading .mm-heading-banner-lum__accent {
  color: var(--banner-accent) !important;
  font-family: inherit !important;
  font-weight: inherit !important;
}

.section-{{ section.id }} .mm-heading-banner-lum__heading .mm-heading-banner-lum__text {
  color: var(--banner-text) !important;
  font-family: inherit !important;
  font-weight: inherit !important;
}

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .mm-heading-banner-lum__inner {
      padding-left: 16px;
      padding-right: 16px;
    }

    .section-{{ section.id }} .mm-heading-banner-lum__heading {
      font-size: var(--banner-font-size-mobile);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Heading banner Lum",
  "tag": "section",
  "class": "mm-section-heading-banner-lum",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "accent_text",
      "label": "Accent text",
      "default": "Feel Better in Your Jeans"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "– Without Starting Another Punishing Diet"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F8E8EB"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent text",
      "default": "#6F1020"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size desktop",
      "min": 24,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size mobile",
      "min": 20,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Heading banner Lum"
    }
  ]
}
{% endschema %}