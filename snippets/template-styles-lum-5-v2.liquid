{% style %}
    /* =========================================
       PRODUCT — lum-template-5-v2
    ========================================= */
    {% if template.name == 'product' and template.suffix == 'lum-template-5-v2' %}

      #MainContent {
        --template-heading-font: 'Gazpacho', Georgia, serif;
        --template-heading-weight: 900;
        --template-bg: #FFFDFA;
        --template-bg-v2: #F9F9F9;
        --template-bg-white: #FFFFFF;
        --template-accent: #FA6C56;
         --template-accent-black: #111111;
        --template-border: #5B0D1E;
        --template-soft-bg: #F5F3EF;
        --template-soft-pink: #FBF1F3;
        --template-border-gradient: linear-gradient(90deg, #CF6F66 0%, #FFA096 20%, #FFC7C0 36%, #FFB0A6 50%, #DB837B 64%, #E4847B 80%, #CD6E64 100%);

        background: var(--template-bg-v2);
      }
         #MainContent  .section-product-details-lum, #MainContent  .pdl__info{
         background: var( --template-bg-white);
      }
      #product-details-lum{
         background: var( --template-bg-white);
      }
      #MainContent .bsl__note{
          align-items: center;
      }
       #MainContent .lpg__item{
        aspect-ratio: 4/3;
      }

       #MainContent  .pdl-subtitle,
       #MainContent .pdl-chip__text,
       {
          color: var(--template-accent-black);
      }
      #MainContent .pdl-chip__text{
        background: var(--template-bg-v2);
      }
       #MainContent .pdl-chip__icon path g{
        fill: var(--template-accent-black) !important;
       }

        #MainContent .bsl__note-icon path{
        fill: var(--template-accent-black) !important;
       }


         #MainContent .bsl__label {
           font-family: var(--template-heading-font) !important;
            font-size: 20px;
            color: var(--template-accent-black);
          }

      #MainContent .pdl-title {
        font-family: var(--template-heading-font) !important;
        font-weight: var(--template-heading-weight)  !important;
        color: var(--pdl-title-color, #113B34) !important;
      }

      #MainContent .xsl__heading,
      #MainContent .ptl__label,
      #MainContent .stats-column-container .stats-section-title,
      #MainContent .custom-accent-text,
      #MainContent .ingredient-cards__heading,
      #MainContent .ingredient-cards__heading-accent,
      #MainContent .product-benefits-heading,
      #MainContent .product-benefits-heading span,
      #MainContent .reviews-subtitle,
      #MainContent .reviews-subtitle span,
      #MainContent .store-faq-heading,
      #MainContent .roadmap-header h2,
      #MainContent .roadmap-header span
      {
        font-family: var(--template-heading-font) !important;
      }

      #MainContent .xsl__heading,
      #MainContent .ptl__label {
        font-size: 20px;
      }

       #MainContent .ptl__label, #MainContent .bsl__note-text,#MainContent .ptl__price{
        color: var(--template-accent-black);
       }


      #MainContent .ptab-product_tabs_mig .ptab__tab {
        background: var( --template-bg-v2) !important;
        border: 1px solid #000 !important;
      }

      #MainContent .ptab-product_tabs_mig .ptab__tab.is-active {
        background: #fff !important;
      }

      #MainContent .xsl__card {
        background: var(--template-bg-v2) !important;
      }
      #MainContent  .xsl__add-label,  #MainContent  .xsl__add-icon, #MainContent  .ptab__tab-icon, #MainContent .ptab__tab-label{
        color: var(--template-accent-black);
      }
       #MainContent  .xsl__desc{
        color: #858585;
      }

      #MainContent .ptab__panel-wrap {
        border: 1px solid #000 !important;
        border-top: 0 !important;
      }

      #MainContent .bsl__input {
        border: 1px solid #C2C2C2 !important;
        background: var(--template-bg-v2) !important;
      }
       #MainContent .ptl__card{
        background: var(--template-bg-v2) !important;
      }
      #MainContent  .ptl__card.is-selected{
          border: 1px solid var(--template-accent-black) !important;
      }
      #MainContent .ingredient-card__image-wrap,
      #MainContent .ingredient-card__image {
        border-radius: 8px;
      }

      #MainContent .ingredient-card__image-wrap {
        width: 100%;
      }
      #MainContent .stats-column-item:not(:last-child) {
        border-bottom: 1px solid transparent !important;
        border-image: var(--template-border-gradient) 1 !important;
      }

      #MainContent .ingredient-card {
        padding: 24px;
        border: 1px solid transparent;
        border-radius: 12px !important;
        background:
         linear-gradient(var(--template-bg-white), var(--template-bg-white)) padding-box,
         var(--template-border-gradient) border-box;
      }
       
       #MainContent .store-faq-items-container.individual-borders,
       #MainContent .store-faq-items-container-two-columns {
      overflow: visible !important;
    }
    #MainContent .store-faq-items-container-two-columns {
      padding-right: 4px;
      padding-bottom: 4px;
      box-sizing: border-box;
    }


    #MainContent .roadmap-circle {
      border: 1px solid transparent;
      border-radius: 50%;
      background:
       linear-gradient(var(--template-soft-pink), var(--template-soft-pink)) padding-box,
       var(--template-border-gradient) border-box;
    }
    #MainContent  .roadmap-circle path{
      fill: var(--template-border) !important;
    }
   #MainContent .roadmap-timeline::before{
    left: 3.5%;
    background: #FFC6BF;
  }
  @media screen and (max-width: 749px) {
     #MainContent .ingredient-card__image-wrap img{
      width: 100%;
    }
    #MainContent .roadmap-timeline::before{
      left: 5.5%;
    }
     #MainContent .store-faq-items-container.individual-borders .store-faq-item:not(:last-child){
      margin-bottom: 10px;
    }
  }
    {% endif %}
{% endstyle %}
