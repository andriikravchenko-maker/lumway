{% comment %} Quiz Reviews {% endcomment %}
<section
  id="QuizReviews-{{ section.id }}"
  class="quiz-reviews"
  style="
    --qr-bg:{{ section.settings.background_color }};
    --qr-card:{{ section.settings.card_background }};
    --qr-text:{{ section.settings.text_color }};
    --qr-body:{{ section.settings.body_color }};
    --qr-star:{{ section.settings.star_color }};
    --qr-border:{{ section.settings.border_color }};
    --qr-container:{{ section.settings.container_width }}px;
    --qr-radius:{{ section.settings.card_radius }}px;
  "
>
  <div class="quiz-reviews__container">
    {% if section.settings.heading != blank %}
      <{{ section.settings.heading_tag }} class="quiz-reviews__heading">
        {{- section.settings.heading | newline_to_br -}}
      </{{ section.settings.heading_tag }}>
    {% endif %}
    <div class="quiz-reviews__grid">
      {% for block in section.blocks %}
        <article class="quiz-reviews__card" {{ block.shopify_attributes }}>
          <div class="quiz-reviews__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
            {% for i in (1..5) %}
              <span class="{% if i > block.settings.rating %}is-empty{% endif %}">
                {% if section.settings.star_svg != blank %}
                  <span class="quiz-reviews__star-svg">{{ section.settings.star_svg }}</span>
                {% elsif section.settings.star_image != blank %}
                  {{
                    section.settings.star_image
                    | image_url: width: 80
                    | image_tag: loading: 'lazy', widths: '20,40,60,80', alt: ''
                  }}
                {% else -%}
                  ★
                {%- endif %}
              </span>
            {% endfor %}
          </div>
          {% if block.settings.title != blank %}
            <h3 class="quiz-reviews__title">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="quiz-reviews__text">{{ block.settings.text | newline_to_br }}</div>
          {% endif %}
          {% if block.settings.author != blank %}
            <div class="quiz-reviews__author">{{ block.settings.author }}</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #QuizReviews-{{ section.id }}{background:var(--qr-bg);color:var(--qr-text);padding:{{ section.settings.padding_top_desktop }}px {{ section.settings.padding_x_desktop }}px {{ section.settings.padding_bottom_desktop }}px}
  #QuizReviews-{{ section.id }} *{box-sizing:border-box}
  #QuizReviews-{{ section.id }} .quiz-reviews__container{width:min(100%,var(--qr-container));margin:auto}
  #QuizReviews-{{ section.id }} .quiz-reviews__heading{width:min(100%,{{ section.settings.heading_max_width }}px);margin:0 auto {{ section.settings.heading_gap_desktop }}px;text-align:{{ section.settings.heading_alignment }};font-family:'Fraunces',Georgia,serif;font-size:{{ section.settings.heading_size_desktop }}px;font-weight:{{ section.settings.heading_weight }};line-height:{{ section.settings.heading_line_height | divided_by: 100.0 }};color:var(--qr-text)}
  #QuizReviews-{{ section.id }} .quiz-reviews__grid{display:grid;grid-template-columns:repeat({{ section.settings.columns_desktop }},minmax(0,1fr));gap:{{ section.settings.card_gap_desktop }}px;align-items:start}
  #QuizReviews-{{ section.id }} .quiz-reviews__card{display:flex;flex-direction:column;min-width:0;padding:{{ section.settings.card_padding_y_desktop }}px {{ section.settings.card_padding_x_desktop }}px;background:var(--qr-card);border:{{ section.settings.border_width }}px solid var(--qr-border);border-radius:var(--qr-radius)}
  #QuizReviews-{{ section.id }} .quiz-reviews__stars{display:flex;gap:{{ section.settings.star_gap }}px;margin-bottom:{{ section.settings.stars_title_gap_desktop }}px;color:var(--qr-star);font-size:{{ section.settings.star_size_desktop }}px;line-height:1}
  #QuizReviews-{{ section.id }} .quiz-reviews__stars>span{display:inline-flex;width:1em;height:1em;align-items:center;justify-content:center}
  #QuizReviews-{{ section.id }} .quiz-reviews__stars .is-empty{opacity:{{ section.settings.empty_star_opacity | divided_by: 100.0 }}}
  #QuizReviews-{{ section.id }} .quiz-reviews__stars img,#QuizReviews-{{ section.id }} .quiz-reviews__star-svg,#QuizReviews-{{ section.id }} .quiz-reviews__star-svg svg{display:block;width:1em;height:1em;object-fit:contain}
  #QuizReviews-{{ section.id }} .quiz-reviews__title{margin:0 0 {{ section.settings.title_body_gap_desktop }}px;font-family:'Fraunces',Georgia,serif;font-size:{{ section.settings.review_title_size_desktop }}px;font-weight:{{ section.settings.review_title_weight }};line-height:{{ section.settings.review_title_line_height | divided_by: 100.0 }};color:var(--qr-text)}
  #QuizReviews-{{ section.id }} .quiz-reviews__text{margin:0 0 {{ section.settings.body_author_gap_desktop }}px;font-family:Arial,Helvetica,sans-serif;font-size:{{ section.settings.body_size_desktop }}px;font-weight:{{ section.settings.body_weight }};line-height:{{ section.settings.body_line_height | divided_by: 100.0 }};color:var(--qr-body)}
  #QuizReviews-{{ section.id }} .quiz-reviews__author{margin-top:auto;font-family:Arial,Helvetica,sans-serif;font-size:{{ section.settings.author_size_desktop }}px;font-weight:{{ section.settings.author_weight }};color:var(--qr-text)}
  @media(max-width:749px){
      #QuizReviews-{{ section.id }}{padding:{{ section.settings.padding_top_mobile }}px {{ section.settings.padding_x_mobile }}px {{ section.settings.padding_bottom_mobile }}px}
      #QuizReviews-{{ section.id }} .quiz-reviews__heading{width:min(100%,{{ section.settings.heading_max_width_mobile }}px);margin-bottom:{{ section.settings.heading_gap_mobile }}px;font-size:{{ section.settings.heading_size_mobile }}px}
      #QuizReviews-{{ section.id }} .quiz-reviews__grid{grid-template-columns:1fr;gap:{{ section.settings.card_gap_mobile }}px}
      #QuizReviews-{{ section.id }} .quiz-reviews__card{padding:{{ section.settings.card_padding_y_mobile }}px {{ section.settings.card_padding_x_mobile }}px}
      #QuizReviews-{{ section.id }} .quiz-reviews__stars{margin-bottom:{{ section.settings.stars_title_gap_mobile }}px;font-size:{{ section.settings.star_size_mobile }}px}
      #QuizReviews-{{ section.id }} .quiz-reviews__title{margin-bottom:{{ section.settings.title_body_gap_mobile }}px;font-size:{{ section.settings.review_title_size_mobile }}px}
      #QuizReviews-{{ section.id }} .quiz-reviews__text{margin-bottom:{{ section.settings.body_author_gap_mobile }}px;font-size:{{ section.settings.body_size_mobile }}px}
      #QuizReviews-{{ section.id }} .quiz-reviews__author{font-size:{{ section.settings.author_size_mobile }}px}
  }
</style>

