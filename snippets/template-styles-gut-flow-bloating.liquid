{% comment %} template-styles-gut-flow-bloating.liquid {% endcomment %}
{% style %}
  /* =========================================
  PAGES — gut-flow-bloating
  ========================================= */
  {% if template.name == 'page' and template.suffix == 'gut-flow-bloating' %}
  #mm-gut-harmony-feature .gut-harmony-feature__list{
  width: max-content;
  }

  .gut-harmony-feature__content
  > .gut-harmony-feature__highlight-checklist:first-of-type {
  border: 1px solid #C2C2C2;
  }
  .gut-harmony-feature__highlight-checklist .fhc{
  font-weight: 400;
  }

  @media screen and (max-width: 749px) {
  #mm-gut-harmony-feature .gut-harmony-feature__list{
  width: 100%;
  }
  .gut-harmony-benefits__content{
  position: relative;
  padding-bottom: 16px;
  }

  .gut-harmony-benefits__content::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 100%;
  height: 1px;
  background-color: #C2C2C2;
  transform: translateX(-50%);
  }
  }
  {% endif %}
{% endstyle %}
