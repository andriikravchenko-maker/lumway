<script>
  window.publishMetaAddToCart = function ({
    value,
    currency,
    quantity,
    items
  }) {
    window.__metaAtcCount = (window.__metaAtcCount || 0) + 1;

    console.log('[Meta ATC COUNT]', window.__metaAtcCount);

    console.log('[Meta ATC PAYLOAD]', {
      value,
      currency,
      quantity,
      items
    });

    console.trace('[Meta ATC SOURCE]');

    if (
      !window.Shopify ||
      !Shopify.analytics ||
      typeof Shopify.analytics.publish !== 'function'
    ) {
      console.error('[Meta ATC] Shopify.analytics.publish unavailable');
      return;
    }

    const payload = {
      value: Number(value) || 0,
      currency: currency || Shopify.currency?.active || 'USD',
      quantity: Number(quantity) || 1,
      items: Array.isArray(items) ? items : []
    };

    console.log('[Meta ATC PUBLISH]', payload);

    Shopify.analytics.publish(
      'lumway:add_to_cart',
      payload
    );
  };
</script>