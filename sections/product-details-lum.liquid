{%- comment -%}
  Section: product-details-lum — new PDP buy box.
  Figma: gallery desktop 433:2984 / mobile 484:7021; heading blocks desktop 433:3000 / mobile 484:7029.
  Lean, mobile-first, reuses theme conventions. Old shop-product-details is untouched.
  Left column = gallery (product-gallery-lum). Right column = buy-box blocks (added per build step).
  Font = theme header font (Bricolage). CSS scoped to .section-{{ section.id }}.
  NOTE: desktop two-column metrics are provisional until the full desktop PDP frame is pulled;
  the blocks themselves are pixel-perfect.
{%- endcomment -%}

{%- liquid
  comment
    On product templates the page's product drives the section. On any other template (landing
    pages) it falls back to the product picked in the section settings, so the same buy box can
    be dropped onto a landing without duplicating code.
  endcomment
  assign pdl_product = product | default: section.settings.product
-%}
{%- if pdl_product == blank -%}
  {%- if request.design_mode -%}
    <div style="padding:24px;border:1px dashed #ccc;border-radius:8px;color:#666;font:14px sans-serif;text-align:center">
      Product Details Lum: pick a product in the section settings.
    </div>
  {%- endif -%}
{%- else -%}
  <section id="product-details-lum" class="pdl section-{{ section.id }} mm-product-details-lum">
    {%- comment -%}
      Section CSS lives at the TOP, before the markup, so nothing paints unstyled. It used
      to sit after </section>: on slow mobile the browser painted the markup with theme defaults first
      (Figma icons blown to full column width, the h1 at the theme's 40px, .pdl__info with no padding,
      fallback font) and snapped when this finally parsed. Parsing it first removes that whole flash.
      Only references section.id / section.settings / template — safe anywhere in the section.
    {%- endcomment -%}
    {%- style -%}
                        @font-face{ font-family:'Inter Tight'; font-style:normal; font-weight:400 700; font-display:swap; src:url({{ 'lum-inter-tight.woff2' | asset_url }}) format('woff2'); }

                        {% if template.name == 'product' %}
                        /* This whole PDP is Inter Tight. On product templates the section re-fonts the entire page
                           (header / footer / reused blocks) via the theme's font variables. On landings the page keeps
                           its own fonts (the section text itself is Inter Tight via --pdl-font either way). */
                        :root{
                          --font-body-family: 'Inter Tight', system-ui, sans-serif !important;
                          --font-heading-family: 'Inter Tight', system-ui, sans-serif !important;
                          --font-accent-family: 'Inter Tight', system-ui, sans-serif !important;
                        }
                        {% endif %}

                        .section-{{ section.id }}{
                          padding-top: {{ section.settings.padding_top }}px;
                          padding-bottom: {{ section.settings.padding_bottom }}px;
                          --pdl-font: 'Inter Tight', system-ui, sans-serif;
                          --pdl-ink: #113b34;
                        }
                        .section-{{ section.id }}.pdl{ display:flex; flex-direction:column; }
                        .section-{{ section.id }} .pdl__info{ display:flex; flex-direction:column; gap:16px; padding:16px; }
                        /* Bundle + Purchase type, when adjacent in the block list, share one wrapper so they can be styled/spaced as one visual unit. */
                        .section-{{ section.id }} .pdl__combo{ display:flex; flex-direction:column; gap:16px; }

                        /* Rating */
                        .section-{{ section.id }} .pdl-rating{ display:flex; align-items:center; gap:12px; }
                        .section-{{ section.id }} .pdl-rating__stars{ display:inline-flex; align-items:center; }
                        .section-{{ section.id }} .pdl-rating__star{ display:inline-flex; align-items:center; justify-content:center; width:20px; height:20px;  color: var(--pdl-rating-star-color);}
                        .section-{{ section.id }} .pdl-rating__star svg{ display:block; width:16.67px; height:15.83px;  fill: var(--pdl-rating-star-color);  color: var(--pdl-rating-star-color);}
                        .section-{{ section.id }} .pdl-rating__text{ display:inline-flex; align-items:center; min-height:20px; font-family:var(--pdl-font); font-weight:400; font-size:14px; line-height:1; letter-spacing:-0.28px;  color: var(--pdl-rating-text-color, var(--pdl-ink)) !important;}

                        /* Title */
           .section-{{ section.id }} .pdl-title {
        margin: 0;
        font-family: var(--pdl-font);
        font-weight: var(--pdl-title-weight, 700);
        font-size: 32px;
        line-height: 1.1;
        letter-spacing: -0.64px;
        color: var(--pdl-title-color, var(--pdl-ink));
        text-transform: capitalize;


      }
                  /* Title description */
                  .section-{{ section.id }} .pdl-title-description {
                    margin: 0;

                    font-family: var(--pdl-font) !important;
                    font-weight: var(--pdl-desc-weight) !important;
                    font-size: var(--pdl-desc-size);
                    line-height: var(--pdl-desc-line-height);
                    letter-spacing: var(--pdl-desc-letter-spacing);

                    color: var(--pdl-desc-color) ;
                  }

                  .section-{{ section.id }} .pdl-title-description p {
                    margin: 0;
                    font: inherit !important;
                    color: inherit !important;
                  }

                  @media (max-width: 989px) {
                    .section-{{ section.id }} .pdl-title-description {
                      font-size: var(--pdl-desc-size-mobile);
                      line-height: var(--pdl-desc-line-height-mobile);
                    }
                  }
                        /* Subtitle (8px under the title per Figma, 16px from neighbours) */
                        .section-{{ section.id }} .pdl-subtitle{ font-family:var(--pdl-font); font-weight:400; font-size:14px; line-height:1.2; letter-spacing:-0.28px; color:var(--pdl-ink); }
                        .section-{{ section.id }} .pdl-subtitle p{ margin:0; }
                        .section-{{ section.id }} .pdl-title + .pdl-subtitle{ margin-top:-8px; }

                        /* Benefit chips */
                        .section-{{ section.id }} .pdl-labels{ list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:8px; }
                        .section-{{ section.id }} .pdl-chip{ display:inline-flex; align-items:center; gap:4px; height:32px; padding:0 12px; background:#f4f4f2; border-radius:28px; box-sizing:border-box; }
                        .section-{{ section.id }} .pdl-chip__icon{ display:inline-flex; width:12px; height:12px; flex:0 0 12px; }
                        .section-{{ section.id }} .pdl-chip__icon svg{ display:block; width:100%; height:100%; }
                        .section-{{ section.id }} .pdl-chip__text{ font-family:var(--pdl-font); font-weight:400; font-size:14px; line-height:1.2; letter-spacing:-0.28px; color:var(--pdl-ink); white-space:nowrap; }


                        /* Theme re-fonts these text nodes with its own font; force Inter Tight (beats the theme rules) */
                        .section-{{ section.id }} .pdl-rating__text,
                        .section-{{ section.id }} .pdl-title,
                        .section-{{ section.id }} .pdl-subtitle,
                        .section-{{ section.id }} .pdl-subtitle p,
                        .section-{{ section.id }} .pdl-chip__text{ font-family:var(--pdl-font) !important; }

                       


                        @media (min-width:990px){
                          .section-{{ section.id }}.pdl{ flex-direction:row; align-items:flex-start; gap:28px; max-width:1440px; margin:0 auto; padding:40px 48px; box-sizing:border-box; }
                          .section-{{ section.id }} .pdl__media{ flex:1 1 0; min-width:0; }
                          .section-{{ section.id }} .pdl__info{ flex:1 1 0; min-width:0; padding:0; gap:24px; }
                          .section-{{ section.id }} .pdl-title{ font-size:36px; letter-spacing:-0.72px; }
                        }
    {%- endstyle -%}
    <div class="pdl__media">
      {%- render 'product-gallery-lum', product: pdl_product -%}
    </div>

    <div class="pdl__info">
      {%- assign pdl_combo_open = false -%}
      {%- for block in section.blocks -%}
        {%- assign pdl_next_type = '' -%}
        {%- assign pdl_next_index = forloop.index0 | plus: 1 -%}
        {%- if pdl_next_index < section.blocks.size -%}
          {%- assign pdl_next_type = section.blocks[pdl_next_index].type -%}
        {%- endif -%}
        {%- case block.type -%}
          {%- when 'rating' -%}
           <div

  class="pdl-rating"

  style="

    --pdl-rating-star-color: {{ block.settings.star_color }};

    --pdl-rating-text-color: {{ block.settings.text_color }};

  "

  {{ block.shopify_attributes }}

>
              {%- if block.settings.stars > 0 -%}
                <span class="pdl-rating__stars" aria-hidden="true">
                  {%- for i in (1..block.settings.stars) -%}
                    <span class="pdl-rating__star">{{ 'lum-icon-star.svg' | inline_asset_content }}</span>
                  {%- endfor -%}
                </span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <span class="pdl-rating__text">{{ block.settings.text | escape }}</span>
              {%- endif -%}
            </div>

          {%- when 'title' -%}
            {%- assign pdl_heading = block.settings.heading | default: pdl_product.title -%}

            <h1
              class="pdl-title"
              style="
                --pdl-title-color: {{ block.settings.text_color }};
                --pdl-title-weight: {{ block.settings.font_weight }};
              "
              {{ block.shopify_attributes }}
            >
              {{ pdl_heading | escape }}
            </h1>

          {%- when 'title_description' -%}
            {%- if block.settings.text != blank -%}
              <div
                class="pdl-title-description"
                style="
                  --pdl-desc-color: {{ block.settings.text_color }};
                  --pdl-desc-size: {{ block.settings.font_size }}px;
                  --pdl-desc-size-mobile: {{ block.settings.font_size_mobile }}px;
                  --pdl-desc-weight: {{ block.settings.font_weight }};
                  --pdl-desc-line-height: {{ block.settings.line_height }};
                  --pdl-desc-line-height-mobile: {{ block.settings.line_height_mobile }};
                  --pdl-desc-letter-spacing: {{ block.settings.letter_spacing | divided_by: 100.0 }}em;

                  margin-top: {{ block.settings.margin_top }}px;
                  margin-bottom: {{ block.settings.margin_bottom }}px;
                "
                {{ block.shopify_attributes }}
              >
                {{ block.settings.text }}
              </div>
            {%- endif -%}

          {%- when 'subtitle' -%}
            {%- if block.settings.text != blank -%}
              <div class="pdl-subtitle" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'labels' -%}
            <ul class="pdl-labels" {{ block.shopify_attributes }}>
              {%- for i in (1..6) -%}
                {%- assign sk = 'chip_' | append: i | append: '_show' -%}
                {%- assign tk = 'chip_' | append: i | append: '_text' -%}
                {%- if block.settings[sk] and block.settings[tk] != blank -%}
                  <li class="pdl-chip">
                    <span class="pdl-chip__icon">{{ 'lum-icon-tick.svg' | inline_asset_content }}</span
                    ><span class="pdl-chip__text">{{ block.settings[tk] | escape }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'bundle' -%}
            {%- render 'bundle-selector-lum', block: block, product: pdl_product -%}

          {%- when 'purchase_type' -%}
            {%- render 'mm-purchase-type-lum', block: block, product: pdl_product -%}

          {%- when 'purchase_plans' -%}
            {%- render 'purchase-plans-lum', block: block, product: pdl_product -%}

          {%- when 'mm_bundle_select' -%}
            {%- if pdl_next_type == 'mm_purchase_plan' -%}
              {%- assign pdl_combo_open = true -%}
              <div class="pdl__combo">
            {%- endif -%}
            {%- render 'mm-bundle-select-lum', block: block, product: pdl_product -%}

          {%- when 'mm_purchase_plan' -%}
            {%- render 'mm-purchase-plan-lum', block: block, product: pdl_product -%}
            {%- if pdl_combo_open -%}
              </div>
              {%- assign pdl_combo_open = false -%}
            {%- endif -%}

          {%- when 'add_to_cart' -%}
            {%- render 'mm-add-to-cart-lum-speed', block: block, product: pdl_product -%}

          {%- when 'info_cards' -%}
            {%- render 'info-cards-lum', block: block -%}

          {% comment %}
          {% render 'subscription-welcome-gifts',
                  product: product,
                  block: block
          %}
        {% endcomment %}

          {%- when 'cross_sell' -%}
            {%- render 'pdl-cross-sell', block: block -%}

          {%- when 'product_tabs' -%}
            {%- render 'pdl-tabs', block: block -%}

          {%- when '@app' -%}
            {%- render block -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

