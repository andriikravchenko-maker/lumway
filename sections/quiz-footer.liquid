<div
        id="QuizFooter-{{ section.id }}"
        class="quiz-footer"
        style="
                --qf-bg: {{ section.settings.background_color }};
                --qf-heading: {{ section.settings.heading_color }};
                --qf-text: {{ section.settings.text_color }};
                --qf-link: {{ section.settings.link_color }};
                --qf-link-hover: {{ section.settings.link_hover_color }};
                --qf-divider: {{ section.settings.divider_color }};
                --qf-container: {{ section.settings.container_width }}px;
                --qf-logo-d: {{ section.settings.logo_width_desktop }}px;
                --qf-logo-m: {{ section.settings.logo_width_mobile }}px;
                --qf-menu-title-d: {{ section.settings.menu_title_size_desktop }}px;
                --qf-menu-title-m: {{ section.settings.menu_title_size_mobile }}px;
                --qf-link-d: {{ section.settings.link_size_desktop }}px;
                --qf-link-m: {{ section.settings.link_size_mobile }}px;
                --qf-legal-d: {{ section.settings.legal_size_desktop }}px;
                --qf-legal-m: {{ section.settings.legal_size_mobile }}px;
                "
>
    <div class="quiz-footer__container">
        <div class="quiz-footer__top">
            <div class="quiz-footer__brand">
                {% if section.settings.logo != blank %}
                    {% if section.settings.logo_link != blank %}
                        <a href="{{ section.settings.logo_link }}" class="quiz-footer__logo-link" aria-label="{{ shop.name }}">
                    {% endif %}

                    {{
                    section.settings.logo
                    | image_url: width: 600
                    | image_tag:
                    class: 'quiz-footer__logo',
                    loading: 'lazy',
                    widths: '120, 180, 240, 360, 480, 600',
                    alt: shop.name
                    }}

                    {% if section.settings.logo_link != blank %}
                        </a>
                    {% endif %}
                {% endif %}
            </div>

            <div class="quiz-footer__menus">
                {% for block in section.blocks %}
                    {% if block.type == 'menu_column' %}
                        <div class="quiz-footer__menu-column" {{ block.shopify_attributes }}>
                            {% if block.settings.title != blank %}
                                <h3 class="quiz-footer__menu-title">{{ block.settings.title }}</h3>
                            {% endif %}

                            {% if block.settings.menu != blank %}
                                <ul class="quiz-footer__menu" role="list">
                                    {% for link in block.settings.menu.links %}
                                        <li>
                                            <a href="{{ link.url }}">{{ link.title }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <div class="quiz-footer__divider"></div>

        <div class="quiz-footer__legal">
            {% if section.settings.research_text != blank %}
                <div class="quiz-footer__research">
                    {{ section.settings.research_text }}
                </div>
            {% endif %}

            {% if section.settings.disclaimer_text != blank %}
                <div class="quiz-footer__disclaimer">
                    {% if section.settings.disclaimer_title != blank %}
                        <strong>{{ section.settings.disclaimer_title }}</strong>
                    {% endif %}
                    {{ section.settings.disclaimer_text }}
                </div>
            {% endif %}

            {% if section.settings.auto_copyright %}
                <div class="quiz-footer__copyright">
                    {{ shop.name | upcase }} {{ 'now' | date: '%Y' }} © {{ section.settings.copyright_suffix }}
                </div>
            {% elsif section.settings.copyright_text != blank %}
                <div class="quiz-footer__copyright">
                    {{ section.settings.copyright_text }}
                </div>
            {% endif %}
        </div>
    </div>
</div>


<style>
    #QuizFooter-{{ section.id }},
    #shopify-section-{{ section.id }} {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
    }

    #QuizFooter-{{ section.id }} {
        position: relative;
        width: 100%;
        min-height: 1px;
    }
</style>

<style>
    #QuizFooter-{{ section.id }} {
        background: var(--qf-bg);
        color: var(--qf-text);
        padding:
                {{ section.settings.padding_top_desktop }}px
{{ section.settings.padding_x_desktop }}px
{{ section.settings.padding_bottom_desktop }}px;
    }

    #QuizFooter-{{ section.id }} * {
        box-sizing: border-box;
    }

    #QuizFooter-{{ section.id }} .quiz-footer__container {
        width: min(100%, var(--qf-container));
        margin-inline: auto;
    }

    #QuizFooter-{{ section.id }} .quiz-footer__top {
        display: grid;
        grid-template-columns: minmax(220px, {{ section.settings.logo_column_width }}px) 1fr;
        gap: {{ section.settings.logo_menus_gap }}px;
        align-items: start;
    }

    #QuizFooter-{{ section.id }} .quiz-footer__brand {
        display: flex;
        align-items: flex-start;
    }

    #QuizFooter-{{ section.id }} .quiz-footer__logo-link {
        display: inline-flex;
    }

    #QuizFooter-{{ section.id }} .quiz-footer__logo {
        display: block;
        width: {{ section.settings.logo_width_desktop }}px;
        max-width: 100%;
        height: auto;
    }

    #QuizFooter-{{ section.id }} .quiz-footer__menus {
        display: grid;
        grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
        gap: {{ section.settings.menu_columns_gap }}px;
    }

    #QuizFooter-{{ section.id }} .quiz-footer__menu-title {
        margin: 0 0 {{ section.settings.menu_title_gap_desktop }}px;
        color: var(--qf-heading);
        font-family: Arial, Helvetica, sans-serif;
        font-size: var(--qf-menu-title-d);
        font-weight: {{ section.settings.menu_title_weight }};
        line-height: 1.25;
    }

    #QuizFooter-{{ section.id }} .quiz-footer__menu {
        display: flex;
        flex-direction: column;
        gap: {{ section.settings.link_gap_desktop }}px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    #QuizFooter-{{ section.id }} .quiz-footer__menu a {
        color: var(--qf-link);
        text-decoration: none;
        font-family: Arial, Helvetica, sans-serif;
        font-size: var(--qf-link-d);
        font-weight: {{ section.settings.link_weight }};
        line-height: 1.4;
        transition: color .2s ease;
    }

    #QuizFooter-{{ section.id }} .quiz-footer__menu a:hover {
        color: var(--qf-link-hover);
    }

    #QuizFooter-{{ section.id }} .quiz-footer__divider {
        display: block;
        width: 100%;
        height: 0;
        margin: {{ section.settings.divider_top_desktop }}px 0 {{ section.settings.divider_bottom_desktop }}px;
        border: 0;
        border-top: {{ section.settings.divider_width }}px solid {{ section.settings.divider_color }};
    }

    #QuizFooter-{{ section.id }} .quiz-footer__legal {
        width: min(100%, {{ section.settings.legal_max_width }}px);
        color: var(--qf-text);
        font-family: Arial, Helvetica, sans-serif;
        font-size: var(--qf-legal-d);
        font-weight: {{ section.settings.legal_weight }};
        line-height: {{ section.settings.legal_line_height | divided_by: 100.0 }};
    }

    #QuizFooter-{{ section.id }} .quiz-footer__research {
        margin-bottom: {{ section.settings.research_gap }}px;
    }

    #QuizFooter-{{ section.id }} .quiz-footer__disclaimer {
        margin-bottom: {{ section.settings.disclaimer_gap }}px;
    }

    #QuizFooter-{{ section.id }} .quiz-footer__disclaimer strong {
        color: var(--qf-heading);
        font-weight: {{ section.settings.disclaimer_title_weight }};
    }

    #QuizFooter-{{ section.id }} .quiz-footer__copyright {
        color: var(--qf-text);
    }

    @media screen and (max-width: 749px) {
        #QuizFooter-{{ section.id }} {
            padding:
                    {{ section.settings.padding_top_mobile }}px
{{ section.settings.padding_x_mobile }}px
{{ section.settings.padding_bottom_mobile }}px;
        }

        #QuizFooter-{{ section.id }} .quiz-footer__top {
            display: block;
        }

        #QuizFooter-{{ section.id }} .quiz-footer__logo {
            width: {{ section.settings.logo_width_mobile }}px !important;
            max-width: 100%;
            height: auto;
        }

        #QuizFooter-{{ section.id }} .quiz-footer__menus {
            grid-template-columns: 1fr;
            gap: {{ section.settings.menu_columns_gap_mobile }}px;
            margin-top: {{ section.settings.logo_menus_gap_mobile }}px;
        }

        #QuizFooter-{{ section.id }} .quiz-footer__menu-title {
            margin-bottom: {{ section.settings.menu_title_gap_mobile }}px;
            font-size: var(--qf-menu-title-m);
        }

        #QuizFooter-{{ section.id }} .quiz-footer__menu {
            gap: {{ section.settings.link_gap_mobile }}px;
        }

        #QuizFooter-{{ section.id }} .quiz-footer__menu a {
            font-size: var(--qf-link-m);
        }

        #QuizFooter-{{ section.id }} .quiz-footer__divider {
            margin:
                    {{ section.settings.divider_top_mobile }}px
                    0
{{ section.settings.divider_bottom_mobile }}px;
        }

        #QuizFooter-{{ section.id }} .quiz-footer__legal {
            width: 100%;
            font-size: var(--qf-legal-m);
        }

        #QuizFooter-{{ section.id }} .quiz-footer__research {
            margin-bottom: {{ section.settings.research_gap_mobile }}px;
        }

        #QuizFooter-{{ section.id }} .quiz-footer__disclaimer {
            margin-bottom: {{ section.settings.disclaimer_gap_mobile }}px;
        }
    }
</style>

{% schema %}
