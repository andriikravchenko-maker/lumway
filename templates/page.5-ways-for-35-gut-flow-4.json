    "get_harmony_feature_v2_7yt7ni": {
      "type": "get-harmony-feature-v2",
      "blocks": {
        "heading_4G9Ftc": {
          "type": "heading",
          "settings": {
            "text": "Why Restricting More Doesn’t Work",
