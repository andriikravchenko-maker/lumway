<script>
    (function () {
        var section = document.querySelector('.{{ section_class }}');
        if (!section || section.__gfhScrollBound) return;
        section.__gfhScrollBound = true;

        var button = section.querySelector('[data-gfh-scroll-button]');
        if (!button) return;

        function getTarget(selector) {
            if (!selector) return null;

            try {
                return document.querySelector(selector);
            } catch (error) {
                console.warn('[Gut Flow Hero] Invalid CTA target selector:', selector);
                return null;
            }
        }

        function getOffset() {
            var isMobile = window.matchMedia('(max-width: 749px)').matches;
            var value = isMobile
                ? button.getAttribute('data-scroll-offset-mobile')
                : button.getAttribute('data-scroll-offset-desktop');

            return parseInt(value || '0', 10) || 0;
        }

        button.addEventListener('click', function () {
            var selector = button.getAttribute('data-scroll-selector');
            var target = getTarget(selector);

            if (!target) {
                console.warn('[Gut Flow Hero] CTA target was not found:', selector);
                return;
            }

            var behavior = button.getAttribute('data-scroll-behavior') === 'auto' ? 'auto' : 'smooth';
            var offset = getOffset();
            var targetY = target.getBoundingClientRect().top + window.pageYOffset - offset;

            window.scrollTo({
                top: Math.max(0, targetY),
                behavior: behavior
            });
        });
    })();
</script>

