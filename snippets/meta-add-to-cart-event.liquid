<script>
  window.publishMetaAddToCart = function ({
    value,
    currency,
    quantity,
    items
  }) {
    console.log('[Meta ATC] function called', {
      value,
      currency,
      quantity,
      items
    });

    if (!window.Shopify || !Shopify.analytics || !Shopify.analytics.publish) {
      console.error('[Meta ATC] Shopify.analytics.publish unavailable');
      return;
    }

    console.log('[Meta ATC] publishing lumway:add_to_cart');

    Shopify.analytics.publish('lumway:add_to_cart', {
  value: Number(value) || 0,
  currency: currency || Shopify.currency?.active || 'USD',
  quantity: Number(quantity) || 1,
  items: Array.isArray(items) ? items : []
})
.then(function(result) {
  console.log('[Meta ATC] publish result:', result);
})
.catch(function(error) {
  console.error('[Meta ATC] publish error:', error);
});
  };
</script>