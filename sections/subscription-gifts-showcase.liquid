  >
    <div class="subscription-showcase__container">
      {%- if heading != blank -%}
        <h2 class="subscription-showcase__heading">
          {{ heading | escape }}
        </h2>
      {%- endif -%}

      <div class="subscription-showcase__grid">
        {%- for gift in subscription_gifts -%}
          {%- liquid
            assign gift_product = gift.gift_product.value
            assign gift_variant = gift_product.selected_or_first_available_variant
            assign gift_image = gift_product.featured_image
            assign target_selling_plan_id = gift.selling_plan_id.value | append: ''

            assign matched_selling_plan = nil

            for selling_plan_group in selected_product.selling_plan_groups
              for selling_plan in selling_plan_group.selling_plans
                assign current_selling_plan_id = selling_plan.id | append: ''

                if current_selling_plan_id == target_selling_plan_id
                  assign matched_selling_plan = selling_plan
                  break
                endif
              endfor

              if matched_selling_plan != nil
                break
              endif
            endfor

            assign main_variant = selected_product.variants[forloop.index0]

            assign gift_value = gift_variant.compare_at_price

            if gift_value == blank or gift_value <= 0
              assign gift_value = gift_variant.price
            endif

            assign is_featured = false

            if forloop.index == featured_position
              assign is_featured = true
            endif

            assign custom_plan_title = blank
            assign custom_gift_title = blank
            assign custom_free_label = blank
            assign custom_button_label = blank
            assign custom_value_override = blank
            assign pack_total = forloop.index

            case forloop.index
              when 1
                assign custom_plan_title = section.settings.card_1_plan_title
                assign custom_gift_title = section.settings.card_1_gift_title
                assign custom_free_label = section.settings.card_1_free_label
                assign custom_button_label = section.settings.card_1_button_label
                assign custom_value_override = section.settings.card_1_value_override
                assign pack_total = section.settings.card_1_pack_total | default: 1
              when 2
                assign custom_plan_title = section.settings.card_2_plan_title
                assign custom_gift_title = section.settings.card_2_gift_title
                assign custom_free_label = section.settings.card_2_free_label
                assign custom_button_label = section.settings.card_2_button_label
                assign custom_value_override = section.settings.card_2_value_override
                assign pack_total = section.settings.card_2_pack_total | default: 2
              when 3
                assign custom_plan_title = section.settings.card_3_plan_title
                assign custom_gift_title = section.settings.card_3_gift_title
                assign custom_free_label = section.settings.card_3_free_label
                assign custom_button_label = section.settings.card_3_button_label
                assign custom_value_override = section.settings.card_3_value_override
                assign pack_total = section.settings.card_3_pack_total | default: 3
            endcase

            if custom_plan_title == blank
              assign custom_plan_title = matched_selling_plan.name
            endif

            if custom_gift_title == blank
              assign custom_gift_title = gift_product.title
            endif

            if custom_free_label == blank
              assign custom_free_label = free_label
            endif

            if custom_button_label == blank
              assign custom_button_label = button_label
            endif

            assign subscription_price = main_variant.price

            if main_variant != blank and matched_selling_plan != nil
              for allocation in main_variant.selling_plan_allocations
                assign allocation_plan_id = allocation.selling_plan.id | append: ''

                if allocation_plan_id == target_selling_plan_id
                  assign subscription_price = allocation.price
                  break
                endif
              endfor
            endif

            assign compare_total = base_compare | times: pack_total
            assign bsl_save = compare_total | minus: subscription_price

            if bsl_save < 0
              assign bsl_save = 0
            endif

            assign calculated_value = gift_value | plus: bsl_save

            assign rounded_calculated_value = calculated_value | plus: 99 | divided_by: 100 | times: 100
          -%}

          {%- if gift_product != blank and matched_selling_plan != nil -%}
            <article
                    class="subscription-showcase__card{% if is_featured %} is-featured{% endif %}"
                    data-subscription-card
                    data-selling-plan-id="{{ matched_selling_plan.id }}"
                    data-bundle-index="{{ forloop.index0 }}"
                    data-main-variant-id="{{ main_variant.id }}"
                    data-pack-total="{{ pack_total }}"
                    data-base-compare="{{ base_compare }}"
                    data-subscription-price="{{ subscription_price }}"
                    data-bsl-save="{{ bsl_save }}"
                    data-gift-value="{{ gift_value }}"
                    data-calculated-value="{{ calculated_value }}"
            >
              {%- if is_featured and section.settings.featured_badge != blank -%}
                <span class="subscription-showcase__featured-badge">
{{ featured_badge_label | escape }}
</span>
              {%- endif -%}

              <div class="subscription-showcase__content">
                <h3 class="subscription-showcase__plan-title">
                  {{ custom_plan_title | escape }}
                </h3>

                <p class="subscription-showcase__gift-title">
                  {{ custom_gift_title | escape }}
                </p>

                <div class="subscription-showcase__value">
                  {%- if custom_value_override != blank -%}
                    <s>{{ custom_value_override | escape }}</s>
                  {%- elsif rounded_calculated_value > 0 -%}
                    <s>{{ rounded_calculated_value | money_without_trailing_zeros }}</s>
                  {%- endif -%}

                  <strong>{{ custom_free_label | escape }}</strong>
                </div>
              </div>

              <div class="subscription-showcase__media">
                {%- if gift_image != blank -%}
                  {{
                  gift_image
                  | image_url: width: 800
                  | image_tag:
                  loading: 'lazy',
                  widths: '240, 360, 480, 640, 800',
                  sizes: '(max-width: 749px) 85vw, 30vw',
                  class: 'subscription-showcase__image',
                  alt: gift_product.title
                  }}
                {%- endif -%}
              </div>

              <a
                      class="subscription-showcase__button"
                      href="#product-details-lum"
                      data-choose-subscription-plan
                      data-bundle-index="{{ forloop.index0 }}"
                      data-selling-plan-id="{{ matched_selling_plan.id }}"
                      aria-label="{{ custom_button_label | escape }} — {{ custom_plan_title | escape }}"
              >
                <span>{{ custom_button_label | escape }}</span>

                <span
                        class="subscription-showcase__button-arrow"
                        aria-hidden="true"
                >
→
</span>
              </a>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>


  <script>
    (function () {
      var section = document.getElementById(
              'SubscriptionGiftsShowcase-{{ section.id }}'
      );

      if (!section || section.__subscriptionPlanNavigationBound) {
        return;
      }

      section.__subscriptionPlanNavigationBound = true;

      function getProductDetails() {
        return document.getElementById('product-details-lum');
      }

      function getBundleRoot() {
        var productDetails = getProductDetails();

        if (!productDetails) {
          return null;
        }

        return productDetails.querySelector('.bsl');
      }

      function getTargetBundleInput(bundleIndex) {
        var bundleRoot = getBundleRoot();

        if (!bundleRoot) {
          return null;
        }


        var inputs = bundleRoot.querySelectorAll('.bsl__input');

        return inputs[bundleIndex] || null;
      }

      function selectBundle(bundleIndex) {
        var targetInput = getTargetBundleInput(bundleIndex);

        if (!targetInput) {
          return false;
        }

        targetInput.click();

        return true;
      }

      function scrollToSelectedBundle() {
        var bundleRoot = getBundleRoot();
        var productDetails = getProductDetails();
        var target = bundleRoot || productDetails;

        if (!target) {
          return;
        }

        target.scrollIntoView({
          behavior: 'smooth',
          block: 'center'
        });
      }

      function focusSelectedBundle(bundleIndex) {
        var targetInput = getTargetBundleInput(bundleIndex);

        if (!targetInput) {
          return;
        }

        try {
          targetInput.focus({
            preventScroll: true
          });
        } catch (error) {
          targetInput.focus();
        }
      }

      section.addEventListener('click', function (event) {
        var button = event.target.closest(
                '[data-choose-subscription-plan]'
        );

        if (!button || !section.contains(button)) {
          return;
        }

        var bundleIndex = parseInt(
                button.getAttribute('data-bundle-index'),
                10
        );

        if (Number.isNaN(bundleIndex)) {
          return;
        }

        var productDetails = getProductDetails();

        if (!productDetails) {
          var sellingPlanId =
                  button.getAttribute('data-selling-plan-id') || '';

          button.href =
                  {{ selected_product.url | json }} +
                          '?selling_plan=' +
                  encodeURIComponent(sellingPlanId) +
                  '#product-details-lum';

          return;
        }

        event.preventDefault();

        var wasSelected = selectBundle(bundleIndex);

        scrollToSelectedBundle();

        if (wasSelected) {
          window.setTimeout(function () {
            focusSelectedBundle(bundleIndex);
          }, 450);
        }
      });
    })();
  </script>

