{% render 'font-fraunces' %}
{% style %}
    /* =========================================
    PAGES — gut-flow-quiz-start
    ========================================= */
    {% if template.name == 'page' and template.suffix == 'gut-flow-quiz-start' %}
        html {

        scroll-behavior: smooth;

        }

        #quiz-gender {

        scroll-margin-top: 40px;

        }
        #MainContent {
        --template-heading-font: "Fraunces", sans-serif;
        --template-btn-font: "League Spartan", Arial, sans-serif;
        --template-bg: #fffdfa;
        --template-accent: #fa6c56;
        --template-border: #5b0d1e;
        --template-soft-bg: #f5f3ef;
        --template-accent-black: #111111;
        --template-border-teal: #0a776133;
        --template-shadow-color: #113b340d;
        --template-btn-bg: #8d2b40;
        }

        #MainContent .quiz-before-after__container h2{
        font-family: var(--template-heading-font) !important;
        font-weight: 400 !important;
        }
        .mm-fiber-steps__header h2{
        font-family: var(--template-heading-font) !important;
        font-weight: 400 !important;
        width: max-content;
        }
        .mm-fiber-steps__number{
        font-family: var(--template-heading-font) !important;
        font-weight: 400 !important;
        }
        #MainContent .mm-fiber-steps__description p{
        font-weight: 300 !important;
        }
        .mm-fiber-steps__card-text p{
        font-weight: 300 !important;
        }
        #MainContent .quiz-before-after__card h3{
        font-family: var(--template-heading-font) !important;
        font-weight: 400 !important;
        }
        .quiz-before-after__row span{
        font-weight: 300 !important;
        }

        footer{
        display: none;
        }
        #MainContent .mm-quiz-hero__benefit {
        width: max-content;
        }
        #MainContent .mm-quiz-hero__benefits{
        width: max-content;
        }
        #MainContent .quiz-reviews__heading {
        font-family: var(--template-heading-font) !important;
        font-weight: 400 !important;
        }
        #MainContent .quiz-reviews__card h3 {
        font-family: var(--template-heading-font) !important;
        font-weight: 400 !important;
        }
        #MainContent .quiz-reviews__text{
        font-weight: 300 !important;
        }
        #MainContent  .quiz-footer__menu a{
        font-weight: 300 !important;
        }
        #MainContent .quiz-footer__disclaimer{
        font-weight: 300 !important;
        }
        #MainContent  .quiz-footer__copyright{
        font-weight: 300 !important;
        }
        #MainContent   .quiz-footer__research{
        font-weight: 300 !important;
        }
        @media screen and (max-width: 749px) {
        #MainContent .mm-quiz-hero{
                padding-bottom: 0;
        }

        #MainContent  .quiz-footer__menu a{
        font-weight: 300 !important;
        }
        #MainContent .quiz-footer__disclaimer{
        font-weight: 300 !important;
        }
        #MainContent  .quiz-footer__copyright{
        font-weight: 300 !important;
        }
        #MainContent   .quiz-footer__research{
        font-weight: 300 !important;
        }
        #MainContent .quiz-footer__divider{
            margin: 30px 0px !important;
        }
        #MainContent  .mm-quiz-hero__button--2{
        background: #f8ece3 !important;
        }
        .mm-quiz-hero__description p {
        font-size: 16px !important;
        font-weight: 300 !important;
        }
        .mm-quiz-hero__note--mob{
        font-size: 16px !important;
        font-weight: 300 !important;
        }
        #MainContent .mm-fiber-steps__description p{
        font-size: 18px !important;
        }


        #MainContent .mm-quiz-hero__content h1{
            font-size: 30px !important;
        }
        .quiz-before-after__title{
        font-size: 30px !important;
        }
        #MainContent .mm-fiber-steps{
        padding-top: 20px;
        }
        #MainContent .quiz-before-after__card h3{
        font-size: 20px !important;
        }
        .mm-fiber-steps__header h2{
        width: 100%;
        font-size: 30px !important;
        }
        }


    {% endif %}
{% endstyle %}