class="quiz-month-chart__svg"
viewBox="0 0 500 170"
preserveAspectRatio="none"
aria-hidden="true"
>
<path
class="quiz-month-chart__line"
data-month-line
d=""
/>

<g data-week-points></g>
</svg>

<div class="quiz-month-chart__labels">
<div>
<strong data-week-weight="0">—</strong>
<span>WEEK 1</span>
</div>

<div>
<strong data-week-weight="1">—</strong>
<span>WEEK 2</span>
</div>

<div>
<strong data-week-weight="2">—</strong>
<span>WEEK 3</span>
</div>

<div>
<strong data-week-weight="3">—</strong>
<span>WEEK 4</span>
</div>
</div>

</div>
</div>

</div>

<p class="quiz-result-slider__disclaimer">
{{ section.settings.month_disclaimer }}
</p>

</div>
</div>


<div
class="quiz-result-slider__slide"
data-quiz-slide="2"
hidden
>
<div class="quiz-result-slider__container">

<div class="quiz-summary">

<div class="quiz-summary__header">
<h2 class="quiz-summary__title">
{{ section.settings.summary_heading }}
</h2>

<div class="quiz-summary__subtitle">
{{ section.settings.summary_text }}
</div>
</div>

<div class="quiz-summary__stats">

<div class="quiz-summary-stat">
<div class="quiz-summary-stat__icon">♀</div>

<div>
<span>Gender</span>
<strong data-summary-gender>
{{ section.settings.default_gender }}
</strong>
</div>
</div>

<div class="quiz-summary-stat">
<div class="quiz-summary-stat__icon">♙</div>

<div>
<span>Age</span>
<strong data-summary-age>—</strong>
</div>
</div>

<div class="quiz-summary-stat">
<div class="quiz-summary-stat__icon">↕</div>

<div>
<span>Height</span>
<strong>
<span data-summary-height>—</span>
<small>cm</small>
</strong>
</div>
</div>

<div class="quiz-summary-stat">
<div class="quiz-summary-stat__icon">▣</div>

<div>
<span>Weight, lb</span>
<strong data-summary-weight>—</strong>
</div>
</div>

</div>

<div class="quiz-summary__bmi">

<div class="quiz-summary__bmi-icon">
◴
</div>

<div class="quiz-summary__bmi-value">
<span>Your BMI</span>
<strong data-bmi>—</strong>
</div>

<p data-bmi-description>
—
</p>

</div>

<div class="quiz-summary__cards">

<div class="quiz-summary-info-card">
<div class="quiz-summary-info-card__icon">
♨
</div>

<div>
<span>Metabolic age</span>

<strong>
<span data-metabolic-age>—</span> years
</strong>

<p>
{{ section.settings.metabolic_text }}
</p>
</div>
</div>

<div class="quiz-summary-info-card">
<div class="quiz-summary-info-card__icon">
◉
</div>

<div>
<span>Bowel movement</span>

<strong>
{{ section.settings.bowel_value }}
</strong>

<p>
{{ section.settings.bowel_text }}
</p>
</div>
</div>

</div>

</div>

</div>
</div>


<div
class="quiz-result-slider__slide"
data-quiz-slide="3"
hidden
>
<div class="quiz-result-slider__container">

<div class="quiz-comparison">

<div class="quiz-comparison__header">
<h2 class="quiz-comparison__title">
{{ section.settings.comparison_heading }}
</h2>

<div class="quiz-comparison__subtitle">
{{ section.settings.comparison_text }}
</div>
</div>

<div class="quiz-comparison__table">

<div class="quiz-comparison__column quiz-comparison__column--product">

<h3>
{{ section.settings.product_column_title }}
</h3>

{% for block in section.blocks %}
{% if block.type == 'comparison' %}
<div
class="quiz-comparison__row"
{{ block.shopify_attributes }}
>
<span class="quiz-comparison__status quiz-comparison__status--yes">
✓
</span>

<span>
{{ block.settings.product_text }}
</span>
</div>
{% endif %}
{% endfor %}

</div>

<div class="quiz-comparison__column quiz-comparison__column--other">

<h3>
{{ section.settings.other_column_title }}
</h3>

{% for block in section.blocks %}
{% if block.type == 'comparison' %}
<div class="quiz-comparison__row">

<span
class="
quiz-comparison__status
{% if block.settings.other_status == 'warning' %}
quiz-comparison__status--warning
{% else %}
quiz-comparison__status--no
{% endif %}
"
>
{% if block.settings.other_status == 'warning' %}
!
{% else %}
×
{% endif %}
</span>

<span>
{{ block.settings.other_text }}
</span>

</div>
{% endif %}
{% endfor %}

</div>

</div>

</div>

</div>
</div>

</div>


<div class="quiz-result-slider__footer">

{% if section.settings.show_back_button %}
<button
type="button"
class="quiz-result-slider__back"
data-quiz-back
>
<span aria-hidden="true">←</span>
<span>{{ section.settings.back_label }}</span>
</button>
{% endif %}

<button
type="button"
class="quiz-result-slider__continue"
data-quiz-continue
{% if checkout_variant == blank %}
disabled
{% elsif section.settings.checkout_plan_index != 'one_time' and checkout_selling_plan == blank %}
disabled
{% endif %}
>
<span data-continue-label>
{{ section.settings.continue_label }}
</span>
</button>
</div>

{% if request.design_mode and checkout_product %}
<div style="display:none;" data-quiz-checkout-debug>
Selected product: {{ checkout_product.title }}
Selected variant: {{ checkout_variant.title }} ({{ checkout_variant.id }})
{% if checkout_selling_plan %}
Selected selling plan: {{ checkout_selling_plan.name }} ({{ checkout_selling_plan.id }})
{% else %}
Selected selling plan: One-time / none
{% endif %}
</div>
{% endif %}

</section>


<style>
#QuizResultSlider-{{ section.id }} {
background: var(--qrs-bg);
color: var(--qrs-text);
font-family: Arial, Helvetica, sans-serif;
}

#QuizResultSlider-{{ section.id }} * {
box-sizing: border-box;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__viewport {
position: relative;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__slide {
min-height: 740px;
padding: 58px 32px 70px;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__slide[hidden] {
display: none !important;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__slide.is-active {
animation: quizResultFade-{{ section.id }} 0.35s ease;
}

@keyframes quizResultFade-{{ section.id }} {
from {
opacity: 0;
transform: translateX(12px);
}

to {
opacity: 1;
transform: translateX(0);
}
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__container {
width: min(100%, 976px);
margin-inline: auto;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__container--timeline {
display: grid;
grid-template-columns: minmax(0, 1fr) minmax(400px, 465px);
gap: 72px;
align-items: center;
padding-top: 85px;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__title,
#QuizResultSlider-{{ section.id }} .quiz-month-card__title,
#QuizResultSlider-{{ section.id }} .quiz-summary__title,
#QuizResultSlider-{{ section.id }} .quiz-comparison__title {
margin: 0;
font-family: 'Fraunces', Georgia, serif;
color: var(--qrs-text);
font-weight: 700;
line-height: 1.08;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__title {
max-width: 440px;
font-size: 48px;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__description {
max-width: 480px;
margin-top: 20px;
color: var(--qrs-muted);
font-size: 18px;
line-height: 1.6;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__description p,
#QuizResultSlider-{{ section.id }} .quiz-month-card__description p,
#QuizResultSlider-{{ section.id }} .quiz-summary__subtitle p,
#QuizResultSlider-{{ section.id }} .quiz-comparison__subtitle p {
margin: 0;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__disclaimer {
margin: 28px 0 0;
color: var(--qrs-muted);
font-size: 14px;
line-height: 1.5;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__disclaimer--desktop {
margin-top: 46px;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__disclaimer--mobile {
display: none;
}


/* Timeline */

