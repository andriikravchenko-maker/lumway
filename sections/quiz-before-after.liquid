    { "type": "color", "id": "text_color", "label": "Heading / title color", "default": "#302522" },
    { "type": "color", "id": "row_text_color", "label": "Row text color", "default": "#302522" },
    { "type": "color", "id": "before_background", "label": "Before card background", "default": "#FFFFFF" },
