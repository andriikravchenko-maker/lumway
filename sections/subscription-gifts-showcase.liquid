{%- comment -%}
  Subscription welcome gifts.

  Usage:
  {% render 'subscription-welcome-gifts', product: product, block: block %}

  Gift display mode:
  - 'selector' — only the gift for the selected bundle is unlocked
  - 'all' — all gifts are shown unlocked

  Change `gifts_display_mode` below to quickly switch the UI behavior.
{%- endcomment -%}

{%- liquid
    assign subscription_gifts = product.metafields.custom.subscription_gifts.value

    assign gifts_display_mode = 'selector'

    assign gifts_heading = block.settings.gifts_heading | default: 'Limited Time Free Welcome Gifts'
    assign gifts_save_prefix = block.settings.gifts_save_prefix | default: 'Save'
-%}

{%- liquid
    assign subscription_gifts = product.metafields.custom.subscription_gifts.value

    assign gifts_display_mode = 'selector'

    assign gifts_heading = block.settings.gifts_heading | default: 'Limited Time Free Welcome Gifts'
    assign gifts_save_prefix = block.settings.gifts_save_prefix | default: 'Save'
-%}


{%- if subscription_gifts != blank -%}
    <span
            class="subscription-gifts__divider"
            style="
                    --sg-divider-color: {{ block.settings.gifts_divider_color | default: '#C2C2C2' }};
                    "
    ></span>

    <div
            class="subscription-gifts"
            data-subscription-gifts
            data-display-mode="{{ gifts_display_mode }}"
            style="
                    --sg-heading-color: {{ block.settings.gifts_heading_color | default: '#6F1020' }};
                    --sg-title-color: {{ block.settings.gifts_title_color | default: '#111111' }};
                    --sg-card-bg: {{ block.settings.gifts_card_bg | default: '#F9F9F9' }};
                    --sg-card-active-bg: {{ block.settings.gifts_card_active_bg | default: '#FFFFFF' }};
                    --sg-lock-color: {{ block.settings.gifts_lock_color | default: '#858585' }};
                    --sg-save-bg: {{ block.settings.gifts_save_bg | default: '#FFD34E' }};
                    --sg-save-color: {{ block.settings.gifts_save_color | default: '#111111' }};

                    --sg-margin-top: {{ block.settings.gifts_margin_top | default: 0 }}px;
                    --sg-margin-bottom: {{ block.settings.gifts_margin_bottom | default: 24 }}px;

                    --sg-margin-top-mobile: {{ block.settings.gifts_margin_top_mobile | default: 5 }}px;
                    --sg-margin-bottom-mobile: {{ block.settings.gifts_margin_bottom_mobile | default: 15 }}px;

                    --sg-header-bottom: {{ block.settings.gifts_header_bottom | default: 16 }}px;
                    "
    >
        <div class="subscription-gifts__header">
            <h3 class="subscription-gifts__heading">
                {{ gifts_heading | escape }}
            </h3>
        </div>

        <div class="subscription-gifts__grid">
            {%- for gift in subscription_gifts -%}
                {%- liquid
                    assign gift_product = gift.gift_product.value
                    assign gift_variant = gift_product.selected_or_first_available_variant
                    assign gift_image = gift_product.featured_image

                    assign gift_value = gift_variant.compare_at_price

                    if gift_value == blank or gift_value <= 0
                        assign gift_value = gift_variant.price
                    endif
                -%}

                {%- if gift_product != blank and gift_variant != blank -%}
                    <article
                            class="subscription-gifts__item"
                            data-subscription-gift
                            data-selling-plan-id="{{ gift.selling_plan_id.value | escape }}"
                            data-gift-product-id="{{ gift_product.id }}"
                            data-gift-variant-id="{{ gift_variant.id }}"
                            data-gift-price="{{ gift_variant.price }}"
                            data-gift-value="{{ gift_value }}"
                    >
                        <h4 class="subscription-gifts__title">
                            {{ gift_product.title }}
                        </h4>

                        <div class="subscription-gifts__media">
                            {%- if gift_image != blank -%}
                                {{
                                gift_image
                                | image_url: width: 300
                                | image_tag:
                                loading: 'lazy',
                                widths: '100, 150, 200, 300',
                                sizes: '(max-width: 749px) 30vw, 180px',
                                class: 'subscription-gifts__image',
                                alt: gift_product.title
                                }}
                            {%- endif -%}

                            <div
                                    class="subscription-gifts__lock"
                                    data-gift-lock
                            >
                <span
                        class="subscription-gifts__lock-icon"
                        aria-hidden="true"
                >
                  {% render 'icon-mdi-password' %}
                </span>

                                {%- if gift.unlock_label.value != blank -%}
                                    <span class="subscription-gifts__lock-label">
                    {{ gift.unlock_label.value }}
                  </span>
                                {%- endif -%}
                            </div>
                        </div>

                        <div class="subscription-gifts__saving">
                            <span>{{ gifts_save_prefix | escape }}</span>

                            <span
                                    data-gift-saving
                                    data-gift-base-value="{{ gift_value }}"
                            >
                {{ gift_value | money }}
              </span>
                        </div>
                    </article>
                {%- endif -%}
            {%- endfor -%}
        </div>
    </div>

    <script>
        (function () {
            var giftsRoot = document.querySelector(
                '[data-subscription-gifts]'
            );

            if (!giftsRoot || giftsRoot.__giftSavingsBound) {
                return;
            }

            giftsRoot.__giftSavingsBound = true;

            var currentPurchaseType = 'subscribe';

            function getBundleRoot() {
                return document.querySelector('.bsl, .mmbsl');
            }

            function formatMoney(cents) {
                return '$' + Math.ceil(cents / 100);
            }

            function getBundleSaving(card) {
                if (!card) {
                    return 0;
                }

                var compareTotal = parseInt(
                    card.getAttribute('data-compare-total') || '0',
                    10
                );

                var variantPrice = parseInt(
                    card.getAttribute('data-price') || '0',
                    10
                );

                var variantId = card.getAttribute(
                    'data-variant'
                );

                var subscriptionMap =
                    window.__lumSubByVariant || {};

                var subscriptionPrice =
                    subscriptionMap[String(variantId)];

                var effectivePrice = variantPrice;

                if (
                    currentPurchaseType === 'subscribe' &&
                    subscriptionPrice !== undefined &&
                    subscriptionPrice !== null
                ) {
                    effectivePrice = parseInt(
                        subscriptionPrice,
                        10
                    );
                }

                return Math.max(
                    compareTotal - effectivePrice,
                    0
                );
            }

            function getSelectedBundleIndex(bundleCards) {
                var selectedIndex = -1;

                bundleCards.forEach(function (card, index) {
                    if (
                        card.classList.contains('is-selected')
                    ) {
                        selectedIndex = index;
                    }
                });

                return selectedIndex;
            }

            function updateGiftSavings() {
                var bundleRoot = getBundleRoot();

                if (!bundleRoot) {
                    return;
                }

                var giftItems =
                    giftsRoot.querySelectorAll(
                        '[data-subscription-gift]'
                    );

                var bundleCards =
                    bundleRoot.querySelectorAll(
                        '.bsl__card, .mmbsl__card'
                    );

                giftItems.forEach(function (giftItem, index) {
                    var bundleCard = bundleCards[index];

                    if (!bundleCard) {
                        return;
                    }

                    var giftValue = parseInt(
                        giftItem.getAttribute(
                            'data-gift-value'
                        ) || '0',
                        10
                    );

                    var bundleSaving =
                        getBundleSaving(bundleCard);

                    var totalSaving =
                        giftValue + bundleSaving;

                    var savingElement =
                        giftItem.querySelector(
                            '[data-gift-saving]'
                        );

                    if (!savingElement) {
                        return;
                    }

                    savingElement.textContent =
                        formatMoney(totalSaving);
                });
            }

            function updateGiftLocks() {
                var giftItems =
                    giftsRoot.querySelectorAll(
                        '[data-subscription-gift]'
                    );

                var displayMode =
                    giftsRoot.getAttribute(
                        'data-display-mode'
                    ) || 'selector';

                if (displayMode === 'all') {
                    giftItems.forEach(function (giftItem) {
                        giftItem.classList.add('is-unlocked');
                        giftItem.classList.remove('is-locked');
                    });

                    return;
                }

                var bundleRoot = getBundleRoot();

                if (!bundleRoot) {
                    return;
                }

                var bundleCards =
                    bundleRoot.querySelectorAll(
                        '.bsl__card, .mmbsl__card'
                    );

                var selectedIndex =
                    getSelectedBundleIndex(bundleCards);

                giftItems.forEach(function (giftItem, index) {
                    var isUnlocked =
                        index === selectedIndex;

                    giftItem.classList.toggle(
                        'is-unlocked',
                        isUnlocked
                    );

                    giftItem.classList.toggle(
                        'is-locked',
                        !isUnlocked
                    );
                });
            }

            function updateGifts() {
                updateGiftSavings();
                updateGiftLocks();
            }

            document.addEventListener(
                'lum:atc-price',
                function (event) {
                    var type =
                        event &&
                        event.detail &&
                        event.detail.type;

                    if (type) {
                        currentPurchaseType = type;
                    }

                    updateGifts();
                }
            );

            document.addEventListener(
                'variant:change',
                function () {
                    requestAnimationFrame(updateGifts);
                }
            );

            document.addEventListener(
                'simple-variant-picker:variantChange',
                function () {
                    requestAnimationFrame(updateGifts);
                }
            );

            var bundleRoot = getBundleRoot();

            if (bundleRoot) {
                bundleRoot.addEventListener(
                    'change',
                    function (event) {
                        if (
                            !event.target.classList ||
                            (!event.target.classList.contains('bsl__input') &&
                                !event.target.classList.contains('mmbsl__input'))
                        ) {
                            return;
                        }

                        requestAnimationFrame(updateGifts);
                    }
                );
            }

            function init() {
                updateGifts();
            }

            if (document.readyState === 'loading') {
                document.addEventListener(
                    'DOMContentLoaded',
                    init
                );
            } else {
                init();
            }

            window.addEventListener(
                'load',
                init
            );

            [200, 600, 1200, 2500].forEach(
                function (delay) {
                    setTimeout(init, delay);
                }
            );

            document.addEventListener(
                'shopify:section:load',
                function () {
                    setTimeout(init, 60);
                }
            );
        })();
    </script>

    <style>
        .subscription-gifts {
            margin-top: var(--sg-margin-top);
            margin-bottom: var(--sg-margin-bottom);
        }

        .subscription-gifts__divider {
            display: block;
            width: 100%;
            height: 1px;
            background: var(--sg-divider-color);
        }

        .subscription-gifts__header {
            margin-bottom: var(--sg-header-bottom);
        }

        .subscription-gifts__heading {
            margin: 0;
            text-align: center;
            text-transform: uppercase;
            font-size: 16px;
            font-weight: 700;
            line-height: 1.2;
            color: var(--sg-heading-color) !important;
        }

        .subscription-gifts__grid {
            display: grid;
            grid-template-columns:
        repeat(3, minmax(0, 1fr));
            gap: 20px;
        }

        .subscription-gifts__item {
            position: relative;
            display: flex;
            flex-direction: column;
            min-width: 0;
            min-height: 208px;
            padding: 14px 14px 30px;
            text-align: center;
            border-radius: 12px;
            background: var(--sg-card-bg);
            box-sizing: border-box;
            transition:
                    background-color 0.2s ease;
        }

        .subscription-gifts__item.is-unlocked {
            background: var(--sg-card-active-bg);
        }

        .subscription-gifts__title {
            position: relative;
            z-index: 3;
            margin: 0;
            font-size: 15px;
            font-weight: 600;
            line-height: 1.2;

            color: var(--sg-title-color);
        }

        .subscription-gifts__media {
            position: relative;
            display: flex;
            flex: 1;
            align-items: center;
            justify-content: center;
            min-height: auto;
            padding: 12px 8px;
            overflow: hidden;
            background: transparent;
            box-sizing: border-box;
        }

        .subscription-gifts__image {
            display: block;

            width: auto;
            max-width: 100%;
            height: 100px;

            object-fit: contain;

            opacity: 1;
            visibility: visible;

            transition:
                    opacity 0.2s ease,
                    visibility 0.2s ease;
        }

        .subscription-gifts__item.is-locked
        .subscription-gifts__image {
            opacity: 0;
            visibility: hidden;
        }

        .subscription-gifts__lock {
            position: absolute;
            inset: 0;
            z-index: 2;

            display: flex;
            flex-direction: column;

            align-items: center;
            justify-content: center;

            gap: 5px;

            color: var(--sg-lock-color);

            opacity: 1;
            visibility: visible;

            pointer-events: none;

            transition:
                    opacity 0.2s ease,
                    visibility 0.2s ease;
        }

        .subscription-gifts__item.is-unlocked
        .subscription-gifts__lock {
            opacity: 0;
            visibility: hidden;
        }

        .subscription-gifts__lock-icon {
            font-size: 22px;
            line-height: 1;
        }

        .subscription-gifts__lock-label {
            font-size: 12px;
            font-weight: 500;
            line-height: 1.2;

            color: var(--sg-lock-color);
        }

        .subscription-gifts__saving {
            position: absolute;
            left: 50%;
            bottom: 6%;
            z-index: 4;
            transform: translateX(-50%);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            min-height: 32px;
            padding: 6px 11px;
            border-radius: 999px;
            background: var(--sg-save-bg);
            color: var(--sg-save-color);
            font-size: 16px;
            font-weight: 500;
            line-height: 1;

            white-space: nowrap;
        }

        @media screen and (max-width: 749px) {
            .subscription-gifts {
                margin-top: var(--sg-margin-top-mobile);
                margin-bottom: var(--sg-margin-bottom-mobile);
            }

            .subscription-gifts__heading {
                font-size: 14px;
            }

            .subscription-gifts__grid {
                gap: 6px;
            }

            .subscription-gifts__item {
                min-height: 180px;
                padding: 10px 6px 26px;
                border-radius: 12px;
            }

            .subscription-gifts__title {
                font-size: 11px;
            }

            .subscription-gifts__media {
                min-height: 120px;

                padding: 8px 4px;
            }

            .subscription-gifts__image {
                height: 72px;
            }

            .subscription-gifts__lock-icon {
                font-size: 18px;
            }

            .subscription-gifts__lock-label {
                font-size: 10px;
            }

            .subscription-gifts__saving {
                bottom: 6%;
                min-height: 28px;
                padding: 5px 8px;
                font-size: 10px;
            }
        }
    </style>
{%- endif -%}