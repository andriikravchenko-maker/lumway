{% comment %} template-styles-page-5-ways-for-35-gut-f-3-n2 {% endcomment %}
{% style %}
/* =========================================
PAGES — 5-ways-for-35-gut-f-3-n2
========================================= */
{% if template.name == 'page' and template.suffix == '5-ways-for-35-gut-f-3-n2' %}
#MainContent {
--template-heading-font: "Fraunces", Georgia, sans-serif;
--template-btn-font: "League Spartan", Arial, sans-serif;
--template-bg: #fffdfa;
--template-accent: #fa6c56;
--template-border: #5b0d1e;
--template-soft-bg: #f5f3ef;
--template-accent-black: #111111;
--template-border-teal: #0a776133;
--template-shadow-color: #113b340d;
--template-btn-bg: #8d2b40;
--template-bg-v2: #F9F9F9;
}

.bsl__card, .ptl__card {
background: var(--template-bg-v2) !important;
}
#MainContent .pdl-subtitle,
#MainContent .pdl-rating__text{
color: var(--template-accent-black);
}
#MainContent .xsl__save, #MainContent .xsl__add-label{
color: var(--template-border) !important;
}
#MainContent .xsl__compare{
color: #858585;
}


#MainContent .pdl-chip__text {
color: var(--template-accent-black) !important;
}

#MainContent #tick-circle path {
fill: var(--template-accent-black) !important;
}
#MainContent .bsl__label {
font-size: 20px;
color: var(--template-accent-black);
}


#MainContent .ptl__label,
#MainContent .bsl__note-text,
#MainContent .ptl__price {
color: var(--template-accent-black);
}


#MainContent .ptl__compare,
#MainContent .gclum__text {
color: #11111166;
}
#MainContent .ptl__benefits li span {
color: var(--template-accent-black) !important;
}
#MainContent .gclum__aside span:nth-of-type(2) {
color: #11111166 !important;
}
#MainContent .gclum__aside span:first-child {
color: white !important;
}

#MainContent .xsl__inline-price {
color: var(--template-accent-black);
}
#MainContent .bsl__sub,
#MainContent .xsl__desc,
#MainContent .icl__sub {
color: #858585;
}
#MainContent .xsl__add-label,
#MainContent .xsl__add-icon,
#MainContent .ptab__tab-icon,
#MainContent .ptab__tab-label {
color: var(--template-accent-black);
}
#MainContent .ptab__check-sub {
color: #11111199;
}

#MainContent .ptab__tab {
background: var(--template-bg-v2) !important;
}
#MainContent .ptab__tab.is-active{
background: var(--template-bg-white) !important;
}

#MainContent .ptab__text p,
#MainContent .ptab__pill {
color: var(--template-accent-black) !important;
}


@media screen and (max-width: 749px) {
#MainContent .xsl__save {
color: #ffffff !important;
}
#MainContent .xsl__price {
color: var(--template-accent-black) !important;
}
.gut-harmony-benefits__content{
position: relative;
}
.gut-harmony-benefits__content:after{
position: absolute;
display: block;
content: "";
width: 100%;
height: 1px;
background: #C2C2C2;
margin: 0 auto;
bottom: -6%;
}
#advertorial-section{
position: relative;
}
#advertorial-section:before{
position: absolute;
content: "";
width: 100%;
height: 1px;
background: #C2C2C2;
bottom: 0;
left: 0;
right: 0;
}

}
{% endif %}
{% endstyle %}