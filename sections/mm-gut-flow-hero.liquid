{% comment %}
Section: Gut Flow Hero

Features:
- Desktop + mobile hero images
- Adjustable image/content column widths
- Reviews badge
- Rich text heading with accent color for <strong>
- Description
- CTA button
- Trust / guarantee line
- Fully configurable colors, typography, spacing
- Responsive controls
{% endcomment %}

{%- liquid
    assign section_class = 'gut-flow-hero-' | append: section.id
-%}

{% style %}
    .{{ section_class }} {
    --gfh-bg: {{ section.settings.background_color }};
    --gfh-content-bg: {{ section.settings.content_background_color }};

    --gfh-heading: {{ section.settings.heading_color }};
    --gfh-heading-accent: {{ section.settings.heading_accent_color }};
    --gfh-text: {{ section.settings.text_color }};

    --gfh-review-text: {{ section.settings.review_text_color }};
    --gfh-review-stars: {{ section.settings.review_stars_color }};

    --gfh-button-bg: {{ section.settings.button_background }};
    --gfh-button-bg-hover: {{ section.settings.button_background_hover }};
    --gfh-button-text: {{ section.settings.button_text_color }};
    --gfh-button-border: {{ section.settings.button_border_color }};

    --gfh-trust-text: {{ section.settings.trust_text_color }};
    --gfh-trust-icon: {{ section.settings.trust_icon_color }};

    --gfh-image-width: {{ section.settings.image_width }}%;
    --gfh-content-width: {{ 100 | minus: section.settings.image_width }}%;

    --gfh-max-width: {{ section.settings.max_width }}px;

    --gfh-padding-top: {{ section.settings.padding_top }}px;
    --gfh-padding-bottom: {{ section.settings.padding_bottom }}px;

    --gfh-content-padding-x: {{ section.settings.content_padding_horizontal }}px;
    --gfh-content-padding-y: {{ section.settings.content_padding_vertical }}px;

    background: var(--gfh-bg);
    padding-top: var(--gfh-padding-top);
    padding-bottom: var(--gfh-padding-bottom);
    }

    .{{ section_class }} *,
    .{{ section_class }} *::before,
    .{{ section_class }} *::after {
    box-sizing: border-box;
    }

    .{{ section_class }} .gfh__container {
    display: flex;
    width: 100%;
    max-width: var(--gfh-max-width);
    margin: 0 auto;
    overflow: hidden;

    {% if section.settings.enable_border_radius %}
        border-radius: {{ section.settings.border_radius }}px;
    {% endif %}
    }

    /* =========================
    IMAGE
    ========================= */

    .{{ section_class }} .gfh__media {
    position: relative;
    width: var(--gfh-image-width);
    flex: 0 0 var(--gfh-image-width);
    min-height: {{ section.settings.desktop_min_height }}px;
    overflow: hidden;
    }

    .{{ section_class }} .gfh__picture {
    display: block;
    width: 100%;
    height: 100%;
    }

    .{{ section_class }} .gfh__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: {{ section.settings.desktop_min_height }}px;
    object-fit: {{ section.settings.image_fit }};
    object-position:
    {{ section.settings.image_position_horizontal }}%
    {{ section.settings.image_position_vertical }}%;
    }

    .{{ section_class }} .gfh__placeholder {
    width: 100%;
    height: 100%;
    min-height: {{ section.settings.desktop_min_height }}px;
    background: #eeeeee;
    }

    .{{ section_class }} .gfh__placeholder svg {
    width: 100%;
    height: 100%;
    }


    /* =========================
    PROMO OVERLAY
    ========================= */

    .{{ section_class }} .gfh__promo {
    position: absolute;
    z-index: 3;
    left: {{ section.settings.promo_desktop_x }}%;
    top: {{ section.settings.promo_desktop_y }}%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: {{ section.settings.promo_gap }}px;
    pointer-events: none;
    }

    .{{ section_class }} .gfh__promo-product {
    width: {{ section.settings.promo_product_width }}px;
    flex: 0 0 {{ section.settings.promo_product_width }}px;
    }

    .{{ section_class }} .gfh__promo-product img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    }

    .{{ section_class }} .gfh__promo-circle {
    width: {{ section.settings.promo_circle_size }}px;
    height: {{ section.settings.promo_circle_size }}px;
    flex: 0 0 {{ section.settings.promo_circle_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: {{ section.settings.promo_circle_padding }}px;
    background: {{ section.settings.promo_circle_background }};
    color: {{ section.settings.promo_circle_text_color }};
    border: {{ section.settings.promo_circle_border_width }}px solid {{ section.settings.promo_circle_border_color }};
    }

    .{{ section_class }} .gfh__promo-circle-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1;
    }

    .{{ section_class }} .gfh__promo-eyebrow {
    display: block;
    font-size: {{ section.settings.promo_eyebrow_size }}px;
    font-weight: {{ section.settings.promo_eyebrow_weight }};
    line-height: 1.05;
    margin-bottom: {{ section.settings.promo_eyebrow_spacing }}px;
    }

    .{{ section_class }} .gfh__promo-main {
    display: block;
    font-size: {{ section.settings.promo_main_size }}px;
    font-weight: {{ section.settings.promo_main_weight }};
    line-height: {{ section.settings.promo_main_line_height | divided_by: 10.0 }};
    }

    .{{ section_class }} .gfh__promo-sub {
    display: block;
    font-size: {{ section.settings.promo_sub_size }}px;
    font-weight: {{ section.settings.promo_sub_weight }};
    line-height: 1.05;
    margin-top: {{ section.settings.promo_sub_spacing }}px;
    }

    /* =========================
    CONTENT
    ========================= */

    .{{ section_class }} .gfh__content {
    width: var(--gfh-content-width);
    flex: 0 0 var(--gfh-content-width);

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--gfh-content-bg);

    padding:
    var(--gfh-content-padding-y)
    var(--gfh-content-padding-x);
    }

    .{{ section_class }} .gfh__content-inner {
    width: 100%;
    max-width: {{ section.settings.content_max_width }}px;

    text-align: {{ section.settings.content_alignment }};
    }

    /* =========================
    REVIEWS
    ========================= */

    .{{ section_class }} .gfh__reviews {
    display: flex;
    align-items: center;

    {% if section.settings.content_alignment == 'center' %}
        justify-content: center;
    {% elsif section.settings.content_alignment == 'right' %}
        justify-content: flex-end;
    {% else %}
        justify-content: flex-start;
    {% endif %}

    gap: {{ section.settings.review_gap }}px;

    margin-bottom: {{ section.settings.review_margin_bottom }}px;

    color: var(--gfh-review-text);

    font-size: {{ section.settings.review_font_size }}px;
    font-weight: {{ section.settings.review_font_weight }};
    line-height: {{ section.settings.review_line_height | divided_by: 10.0 }};
    }

    .{{ section_class }} .gfh__stars {
    display: flex;
    align-items: center;
    gap: {{ section.settings.star_gap }}px;
    color: var(--gfh-review-stars);
    flex-shrink: 0;
    }

    .{{ section_class }} .gfh__star {
    width: {{ section.settings.star_size }}px;
    height: {{ section.settings.star_size }}px;
    display: block;
    fill: currentColor;
    }

    /* =========================
    HEADING
    ========================= */

    .{{ section_class }} .gfh__heading {
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px;

    color: var(--gfh-heading);

    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: {{ section.settings.heading_line_height | divided_by: 10.0 }};
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;

    {% if section.settings.heading_uppercase %}
        text-transform: uppercase;
    {% endif %}
    }

    .{{ section_class }} .gfh__heading strong,
    .{{ section_class }} .gfh__heading b {
    color: var(--gfh-heading-accent);
    font-weight: inherit;
    }

    /* =========================
    DESCRIPTION
    ========================= */

    .{{ section_class }} .gfh__description {
    margin: 0 auto {{ section.settings.description_margin_bottom }}px;

    color: var(--gfh-text);

    font-size: {{ section.settings.description_font_size }}px;
    font-weight: {{ section.settings.description_font_weight }};
    line-height: {{ section.settings.description_line_height | divided_by: 10.0 }};

    {% if section.settings.content_alignment == 'left' %}
        margin-left: 0;
        margin-right: 0;
    {% elsif section.settings.content_alignment == 'right' %}
        margin-left: auto;
        margin-right: 0;
    {% endif %}

    max-width: {{ section.settings.description_max_width }}px;
    }

    .{{ section_class }} .gfh__description p {
    margin: 0;
    }

    .{{ section_class }} .gfh__description p + p {
    margin-top: 10px;
    }

    /* =========================
    BUTTON
    ========================= */

    .{{ section_class }} .gfh__button-wrap {
    display: flex;

    {% if section.settings.content_alignment == 'center' %}
        justify-content: center;
    {% elsif section.settings.content_alignment == 'right' %}
        justify-content: flex-end;
    {% else %}
        justify-content: flex-start;
    {% endif %}

    margin-bottom: {{ section.settings.button_margin_bottom }}px;
    }

    .{{ section_class }} .gfh__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width:
    {% if section.settings.button_full_width %}
        100%
    {% else %}
        auto
    {% endif %};

    min-width: {{ section.settings.button_min_width }}px;
    min-height: {{ section.settings.button_height }}px;

    padding:
    {{ section.settings.button_padding_vertical }}px
    {{ section.settings.button_padding_horizontal }}px;

    background: var(--gfh-button-bg);
    color: var(--gfh-button-text);

    border:
    {{ section.settings.button_border_width }}px
    solid
    var(--gfh-button-border);

    border-radius: {{ section.settings.button_border_radius }}px;

    text-decoration: none;

    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    line-height: 1.2;

    transition:
    background-color 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;

    cursor: pointer;
    }

    .{{ section_class }} .gfh__button:hover {
    background: var(--gfh-button-bg-hover);

    {% if section.settings.button_hover_lift %}
        transform: translateY(-2px);
    {% endif %}
    }

    /* =========================
    TRUST LINE
    ========================= */

    .{{ section_class }} .gfh__trust {
    display: flex;
    align-items: center;

    {% if section.settings.content_alignment == 'center' %}
        justify-content: center;
    {% elsif section.settings.content_alignment == 'right' %}
        justify-content: flex-end;
    {% else %}
        justify-content: flex-start;
    {% endif %}

    gap: {{ section.settings.trust_gap }}px;

    color: var(--gfh-trust-text);

    font-size: {{ section.settings.trust_font_size }}px;
    font-weight: {{ section.settings.trust_font_weight }};
    line-height: {{ section.settings.trust_line_height | divided_by: 10.0 }};
    }

    .{{ section_class }} .gfh__trust-icon {
    width: {{ section.settings.trust_icon_size }}px;
    height: {{ section.settings.trust_icon_size }}px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 {{ section.settings.trust_icon_size }}px;

    color: var(--gfh-trust-icon);
    }

    .{{ section_class }} .gfh__trust-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
    }

    .{{ section_class }} .gfh__trust-custom-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    }


    /* =========================
    ADVANCED SPACING / TYPOGRAPHY
    ========================= */

    .{{ section_class }} .gfh__container {
    margin-top: {{ section.settings.container_margin_top }}px;
    margin-right: auto;
    margin-bottom: {{ section.settings.container_margin_bottom }}px;
    margin-left: auto;
    }

    .{{ section_class }} .gfh__media {
    margin:
    {{ section.settings.media_margin_top }}px
    {{ section.settings.media_margin_right }}px
    {{ section.settings.media_margin_bottom }}px
    {{ section.settings.media_margin_left }}px;
    }

    .{{ section_class }} .gfh__content {
    margin:
    {{ section.settings.content_margin_top }}px
    {{ section.settings.content_margin_right }}px
    {{ section.settings.content_margin_bottom }}px
    {{ section.settings.content_margin_left }}px;
    }

    .{{ section_class }} .gfh__reviews {
    margin-top: {{ section.settings.review_margin_top }}px;
    margin-right: {{ section.settings.review_margin_right }}px;
    margin-left: {{ section.settings.review_margin_left }}px;
    }

    .{{ section_class }} .gfh__heading {
    margin-top: {{ section.settings.heading_margin_top }}px;
    margin-right: {{ section.settings.heading_margin_right }}px;
    margin-left: {{ section.settings.heading_margin_left }}px;
    }

    .{{ section_class }} .gfh__description {
    margin-top: {{ section.settings.description_margin_top }}px;
    }

    .{{ section_class }} .gfh__button-wrap {
    margin-top: {{ section.settings.button_margin_top }}px;
    margin-right: {{ section.settings.button_margin_right }}px;
    margin-left: {{ section.settings.button_margin_left }}px;
    }

    .{{ section_class }} .gfh__trust {
    margin:
    {{ section.settings.trust_margin_top }}px
    {{ section.settings.trust_margin_right }}px
    {{ section.settings.trust_margin_bottom }}px
    {{ section.settings.trust_margin_left }}px;
    }

    .{{ section_class }} .gfh__review-text {
    color: {{ section.settings.review_text_color }};
    }

    .{{ section_class }} .gfh__heading {
    font-family: {{ section.settings.heading_font_family }};
    }

    .{{ section_class }} .gfh__description {
    font-family: {{ section.settings.description_font_family }};
    }

    .{{ section_class }} .gfh__review-text {
    font-family: {{ section.settings.review_font_family }};
    }

    .{{ section_class }} .gfh__button {
    font-family: {{ section.settings.button_font_family }};
    letter-spacing: {{ section.settings.button_letter_spacing | divided_by: 100.0 }}em;
    text-transform: {{ section.settings.button_text_transform }};
    }

    .{{ section_class }} .gfh__trust {
    font-family: {{ section.settings.trust_font_family }};
    }

    .{{ section_class }} .gfh__description a {
    color: {{ section.settings.description_link_color }};
    }

    .{{ section_class }} .gfh__description strong,
    .{{ section_class }} .gfh__description b {
    color: {{ section.settings.description_strong_color }};
    }

    /* =========================
    MOBILE
    ========================= */


    @media screen and (max-width: 749px) {

    .{{ section_class }} {
    padding-left: {{ section.settings.mobile_section_padding_left }}px;
    padding-right: {{ section.settings.mobile_section_padding_right }}px;
    }

    .{{ section_class }} .gfh__container {
    width: {{ section.settings.mobile_container_width }}%;
    max-width: {{ section.settings.mobile_container_max_width }}px;
    margin-top: {{ section.settings.mobile_container_margin_top }}px;
    margin-bottom: {{ section.settings.mobile_container_margin_bottom }}px;
    overflow: visible;
    }

    {% if section.settings.mobile_media_full_bleed %}
        .{{ section_class }} .gfh__media {
        width: calc(100% + {{ section.settings.mobile_media_bleed_left }}px + {{ section.settings.mobile_media_bleed_right }}px);
        margin-left: -{{ section.settings.mobile_media_bleed_left }}px;
        margin-right: -{{ section.settings.mobile_media_bleed_right }}px;
        }
    {% else %}
        .{{ section_class }} .gfh__media {
        width: {{ section.settings.mobile_media_width }}%;
        margin-left: auto;
        margin-right: auto;
        }
    {% endif %}

    .{{ section_class }} .gfh__media {
    margin-top: {{ section.settings.mobile_media_margin_top }}px;
    margin-bottom: {{ section.settings.mobile_media_margin_bottom }}px;
    }

    .{{ section_class }} .gfh__content {
    margin:
    {{ section.settings.mobile_content_margin_top }}px
    {{ section.settings.mobile_content_margin_right }}px
    {{ section.settings.mobile_content_margin_bottom }}px
    {{ section.settings.mobile_content_margin_left }}px;
    }

    .{{ section_class }} .gfh__reviews {
    margin-top: {{ section.settings.mobile_review_margin_top }}px;
    margin-right: {{ section.settings.mobile_review_margin_right }}px;
    margin-left: {{ section.settings.mobile_review_margin_left }}px;
    }

    .{{ section_class }} .gfh__heading {
    margin-top: {{ section.settings.mobile_heading_margin_top }}px;
    margin-right: {{ section.settings.mobile_heading_margin_right }}px;
    margin-left: {{ section.settings.mobile_heading_margin_left }}px;
    letter-spacing: {{ section.settings.mobile_heading_letter_spacing | divided_by: 100.0 }}em;
    }

    .{{ section_class }} .gfh__description {
    margin-top: {{ section.settings.mobile_description_margin_top }}px;
    }

    .{{ section_class }} .gfh__button-wrap {
    margin-top: {{ section.settings.mobile_button_margin_top }}px;
    margin-right: {{ section.settings.mobile_button_margin_right }}px;
    margin-left: {{ section.settings.mobile_button_margin_left }}px;
    }

    .{{ section_class }} .gfh__trust {
    margin:
    {{ section.settings.mobile_trust_margin_top }}px
    {{ section.settings.mobile_trust_margin_right }}px
    {{ section.settings.mobile_trust_margin_bottom }}px
    {{ section.settings.mobile_trust_margin_left }}px;
    }


    .{{ section_class }} .gfh__promo {
    left: {{ section.settings.promo_mobile_x }}%;
    top: {{ section.settings.promo_mobile_y }}%;
    gap: {{ section.settings.promo_mobile_gap }}px;
    }

    .{{ section_class }} .gfh__promo-product {
    width: {{ section.settings.promo_mobile_product_width }}px;
    flex-basis: {{ section.settings.promo_mobile_product_width }}px;
    }

    .{{ section_class }} .gfh__promo-circle {
    width: {{ section.settings.promo_mobile_circle_size }}px;
    height: {{ section.settings.promo_mobile_circle_size }}px;
    flex-basis: {{ section.settings.promo_mobile_circle_size }}px;
    padding: {{ section.settings.promo_mobile_circle_padding }}px;
    }

    .{{ section_class }} .gfh__promo-eyebrow {
    font-size: {{ section.settings.promo_mobile_eyebrow_size }}px;
    margin-bottom: {{ section.settings.promo_mobile_eyebrow_spacing }}px;
    }

    .{{ section_class }} .gfh__promo-main {
    font-size: {{ section.settings.promo_mobile_main_size }}px;
    }

    .{{ section_class }} .gfh__promo-sub {
    font-size: {{ section.settings.promo_mobile_sub_size }}px;
    margin-top: {{ section.settings.promo_mobile_sub_spacing }}px;
    }

    .{{ section_class }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .{{ section_class }} .gfh__container {
    flex-direction:
    {% if section.settings.mobile_image_position == 'bottom' %}
        column-reverse
    {% else %}
        column
    {% endif %};

    {% if section.settings.enable_border_radius %}
        border-radius: {{ section.settings.mobile_border_radius }}px;
    {% endif %}
    }

    .{{ section_class }} .gfh__media,
    .{{ section_class }} .gfh__content {
    width: 100%;
    flex: 0 0 auto;
    }

    .{{ section_class }} .gfh__media {
    min-height: {{ section.settings.mobile_image_height }}px;
    height: {{ section.settings.mobile_image_height }}px;
    }

    .{{ section_class }} .gfh__image {
    min-height: 0;
    height: {{ section.settings.mobile_image_height }}px;

    object-position:
    {{ section.settings.mobile_image_position_horizontal }}%
    {{ section.settings.mobile_image_position_vertical }}%;
    }

    .{{ section_class }} .gfh__content {
    padding:
    {{ section.settings.mobile_content_padding_vertical }}px
    {{ section.settings.mobile_content_padding_horizontal }}px;
    }

    .{{ section_class }} .gfh__content-inner {
    max-width: 100%;
    text-align: {{ section.settings.mobile_content_alignment }};
    }

    .{{ section_class }} .gfh__reviews {
    {% if section.settings.mobile_content_alignment == 'center' %}
        justify-content: center;
    {% elsif section.settings.mobile_content_alignment == 'right' %}
        justify-content: flex-end;
    {% else %}
        justify-content: flex-start;
    {% endif %}

    margin-bottom: {{ section.settings.mobile_review_margin_bottom }}px;

    font-size: {{ section.settings.mobile_review_font_size }}px;
    }

    .{{ section_class }} .gfh__star {
    width: {{ section.settings.mobile_star_size }}px;
    height: {{ section.settings.mobile_star_size }}px;
    }

    .{{ section_class }} .gfh__heading {
    margin-bottom: {{ section.settings.mobile_heading_margin_bottom }}px;

    font-size: {{ section.settings.mobile_heading_font_size }}px;
    line-height: {{ section.settings.mobile_heading_line_height | divided_by: 10.0 }};
    }

    .{{ section_class }} .gfh__description {
    max-width: 100%;

    margin-bottom: {{ section.settings.mobile_description_margin_bottom }}px;

    font-size: {{ section.settings.mobile_description_font_size }}px;
    line-height: {{ section.settings.mobile_description_line_height | divided_by: 10.0 }};

    {% if section.settings.mobile_content_alignment == 'left' %}
        margin-left: 0;
        margin-right: 0;
    {% elsif section.settings.mobile_content_alignment == 'right' %}
        margin-left: auto;
        margin-right: 0;
    {% else %}
        margin-left: auto;
        margin-right: auto;
    {% endif %}
    }

    .{{ section_class }} .gfh__button-wrap {
    {% if section.settings.mobile_content_alignment == 'center' %}
        justify-content: center;
    {% elsif section.settings.mobile_content_alignment == 'right' %}
        justify-content: flex-end;
    {% else %}
        justify-content: flex-start;
    {% endif %}

    margin-bottom: {{ section.settings.mobile_button_margin_bottom }}px;
    }

    .{{ section_class }} .gfh__button {
    width:
    {% if section.settings.mobile_button_full_width %}
        100%
    {% else %}
        auto
    {% endif %};

    min-width: {{ section.settings.mobile_button_min_width }}px;
    min-height: {{ section.settings.mobile_button_height }}px;

    padding:
    {{ section.settings.mobile_button_padding_vertical }}px
    {{ section.settings.mobile_button_padding_horizontal }}px;

    font-size: {{ section.settings.mobile_button_font_size }}px;
    }

    .{{ section_class }} .gfh__trust {
    {% if section.settings.mobile_content_alignment == 'center' %}
        justify-content: center;
    {% elsif section.settings.mobile_content_alignment == 'right' %}
        justify-content: flex-end;
    {% else %}
        justify-content: flex-start;
    {% endif %}

    font-size: {{ section.settings.mobile_trust_font_size }}px;
    }

    .{{ section_class }} .gfh__trust-icon {
    width: {{ section.settings.mobile_trust_icon_size }}px;
    height: {{ section.settings.mobile_trust_icon_size }}px;
    flex-basis: {{ section.settings.mobile_trust_icon_size }}px;
    }
    }
{% endstyle %}


<section
        class="{{ section_class }} gut-flow-hero"
        data-section-id="{{ section.id }}"
>
    <div class="gfh__container">

        {%- if section.settings.show_image -%}
            <div class="gfh__media">
                {%- if section.settings.image != blank -%}
                    <picture class="gfh__picture">

                        {%- if section.settings.mobile_image != blank -%}
                            <source
                                    media="(max-width: 749px)"
                                    sizes="100vw"
                                    srcset="
{{ section.settings.mobile_image | image_url: width: 360 }} 360w,
{{ section.settings.mobile_image | image_url: width: 480 }} 480w,
{{ section.settings.mobile_image | image_url: width: 576 }} 576w,
{{ section.settings.mobile_image | image_url: width: 640 }} 640w,
{{ section.settings.mobile_image | image_url: width: 750 }} 750w,
{{ section.settings.mobile_image | image_url: width: 828 }} 828w
"
                            >
                        {%- endif -%}

                        {{
                        section.settings.image
                        | image_url: width: 1400
                        | image_tag:
                        class: 'gfh__image',
                        widths: '480, 640, 750, 900, 1100, 1200, 1400',
                        sizes: '(min-width: 1600px) 768px, (min-width: 750px) 48vw, 100vw',
                        loading: 'eager',
                        fetchpriority: 'high',
                        decoding: 'async'
                        }}
                    </picture>
                {%- else -%}
                    <div class="gfh__placeholder">
                        {{ 'lifestyle-1' | placeholder_svg_tag }}
                    </div>
                {%- endif -%}

                {%- if section.settings.show_promo_overlay -%}
                    <div class="gfh__promo">
                        {%- if section.settings.promo_product_image != blank -%}
                            <div class="gfh__promo-product">
                                {{
                                section.settings.promo_product_image
                                | image_url: width: 360
                                | image_tag:
                                loading: 'lazy',
                                fetchpriority: 'low',
                                decoding: 'async',
                                widths: '80, 120, 160, 180, 240, 320, 360',
                                sizes: '(max-width: 749px) 80px, 120px',
                                alt: section.settings.promo_product_image.alt
                                }}
                            </div>
                        {%- endif -%}

                        {%- if section.settings.show_promo_circle -%}
                            <div class="gfh__promo-circle">
                                <div class="gfh__promo-circle-inner">
                                    {%- if section.settings.promo_eyebrow != blank -%}
                                        <span class="gfh__promo-eyebrow">{{ section.settings.promo_eyebrow }}</span>
                                    {%- endif -%}

                                    {%- if section.settings.promo_main_text != blank -%}
                                        <span class="gfh__promo-main">{{ section.settings.promo_main_text | newline_to_br }}</span>
                                    {%- endif -%}

                                    {%- if section.settings.promo_sub_text != blank -%}
                                        <span class="gfh__promo-sub">{{ section.settings.promo_sub_text }}</span>
                                    {%- endif -%}
                                </div>
                            </div>
                        {%- endif -%}
                    </div>
                {%- endif -%}
            </div>
        {%- endif -%}


        <div class="gfh__content">
            <div class="gfh__content-inner">

                {%- if section.settings.show_reviews -%}
                    <div class="gfh__reviews">

                        {%- if section.settings.show_stars -%}
                            <div class="gfh__stars" aria-hidden="true">
                                {%- for i in (1..5) -%}
