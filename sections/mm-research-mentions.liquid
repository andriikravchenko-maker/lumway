{% comment %}
  Section: Research Mentions

  Desktop:
  - Heading and subtitle
  - Cards displayed in a grid

  Mobile:
  - One card per slide
  - Native CSS scroll snap
  - Navigation dots
{% endcomment %}

{%- liquid
  assign section_heading = section.settings.heading
  assign section_subheading = section.settings.subheading
-%}

{% style %}
        .section-{{ section.id }} {
          --rm-background: {{ section.settings.background_color }};
          --rm-heading-color: {{ section.settings.heading_color }};
          --rm-subheading-color: {{ section.settings.subheading_color }};
          --rm-card-background: {{ section.settings.card_background }};
          --rm-card-text-color: {{ section.settings.card_text_color }};
          --rm-card-border-color: {{ section.settings.card_border_color }};
          --rm-dot-color: {{ section.settings.dot_color }};
          --rm-dot-active-color: {{ section.settings.dot_active_color }};

          --rm-heading-size: {{ section.settings.heading_size }}px;
          --rm-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;

          --rm-subheading-size: {{ section.settings.subheading_size }}px;
          --rm-subheading-size-mobile: {{ section.settings.subheading_size_mobile }}px;

          --rm-card-text-size: {{ section.settings.card_text_size }}px;
          --rm-card-text-size-mobile: {{ section.settings.card_text_size_mobile }}px;

          --rm-card-radius: {{ section.settings.card_radius }}px;
          --rm-card-gap: {{ section.settings.card_gap }}px;
          --rm-content-width: {{ section.settings.content_width }}px;

          --rm-padding-top: {{ section.settings.padding_top }}px;
          --rm-padding-bottom: {{ section.settings.padding_bottom }}px;
          --rm-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
          --rm-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
        }

   .research-mentions__bottom-text {
    max-width: {{ section.settings.bottom_text_max_width }}px;
    margin-left: auto;
    margin-right: auto;

    margin-top: {{ section.settings.bottom_text_margin_top }}px;

    color: {{ section.settings.bottom_text_color }};

    font-size: {{ section.settings.bottom_text_size }}px;
    font-weight: {{ section.settings.bottom_text_weight }};

    text-align: {{ section.settings.bottom_text_alignment }};
  }


  .research-mentions__bottom-text p {
    margin: 0;
  }


  @media screen and (max-width: 749px) {

    .research-mentions__bottom-text {

      margin-top: {{ section.settings.bottom_text_margin_top_mobile }}px;

      font-size: {{ section.settings.bottom_text_size_mobile }}px;

      font-weight: {{ section.settings.bottom_text_weight_mobile }};

      text-align: {{ section.settings.bottom_text_alignment_mobile }};
    }

  }
        .section-{{ section.id }} {
          overflow: hidden;
          padding-block:
            var(--rm-padding-top-mobile)
            var(--rm-padding-bottom-mobile);
          background: var(--rm-background);
        }

        .section-{{ section.id }} .research-mentions__inner {
          width: min(100%, var(--rm-content-width));
          margin-inline: auto;
          padding-inline: 24px;
          box-sizing: border-box;
        }

        .section-{{ section.id }} .research-mentions__header {
          max-width: auto;
          margin: 0 auto 40px;
          text-align: center;
        }

        .section-{{ section.id }} .research-mentions__heading {
          margin: 0;

          color: var(--rm-heading-color) !important;
          font-family: 'Inter Tight', system-ui, sans-serif !important;
          font-size: var(--rm-heading-size-mobile);
          font-weight: 700 !important;
          line-height: 1.08;
          letter-spacing: -0.04em;
        }

        .section-{{ section.id }} .research-mentions__subheading {
          margin-top: 12px;

          color: var(--rm-subheading-color);
          font-family: 'Inter Tight', system-ui, sans-serif !important;
          font-size: var(--rm-subheading-size-mobile);
          font-weight: 600 !important;
          line-height: 1.25;
          letter-spacing: -0.03em;
        }

        .section-{{ section.id }} .research-mentions__subheading p {
          margin: 0;
          color: inherit !important;
          font: inherit !important;
        }

        .section-{{ section.id }} .research-mentions__viewport {
          width: 100%;
        }

        .section-{{ section.id }} .research-mentions__track {
          display: flex;
          gap: 16px;

          margin: 0;
          padding: 0;

          overflow-x: auto;
          overscroll-behavior-inline: contain;
          scroll-behavior: smooth;
          scroll-snap-type: x mandatory;
          scrollbar-width: none;

          list-style: none;
        }

        .section-{{ section.id }} .research-mentions__track::-webkit-scrollbar {
          display: none;
        }

        .section-{{ section.id }} .research-mentions__slide {
          flex: 0 0 100%;
          min-width: 0;
          scroll-snap-align: center;
          scroll-snap-stop: always;
        }

      .section-{{ section.id }} .research-mentions__card {
        display: grid;
        grid-template-rows:
          minmax(74px, auto)
          minmax(58px, auto);
        align-content: center;
        justify-items: center;
        row-gap: 10px;

        min-height: 201px;
        padding: 28px;
        box-sizing: border-box;

        background: var(--rm-card-background);
        border: 1px solid var(--rm-card-border-color);
        border-radius: var(--rm-card-radius);

        text-align: center;
      }

      .section-{{ section.id }} .research-mentions__logo-wrap {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 100%;
        height: 74px;
        margin: 0;
      }

        .section-{{ section.id }} .research-mentions__logo {
          display: block;
          width: auto;
          max-width: min(100%, var(--rm-logo-width));
          max-height: var(--rm-logo-height);
          object-fit: contain;
        }

        .section-{{ section.id }} .research-mentions__logo-text {
          color: var(--rm-card-text-color) !important;
          font-family: 'Inter Tight', system-ui, sans-serif !important;
          font-size: var(--rm-logo-text-size);
          font-weight: 800 !important;
          line-height: 1;
          letter-spacing: -0.05em;
          text-transform: uppercase;
        }

      .section-{{ section.id }} .research-mentions__quote {
        display: flex;
        align-items: flex-start;
        justify-content: center;

        width: 100%;
        max-width: 320px;
        min-height: 58px;
        margin: 0;
        padding: 0;

        color: var(--rm-card-text-color);
        font-family: 'Inter Tight', system-ui, sans-serif !important;
        font-size: var(--rm-card-text-size-mobile);
        font-weight: 400 !important;
        line-height: 1.35;
        letter-spacing: -0.025em;
        text-align: center;
      }

      .section-{{ section.id }} .research-mentions__quote p {
        width: 100%;
        margin: 0;

        color: inherit !important;
        font: inherit !important;
      }

        .section-{{ section.id }} .research-mentions__dots {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 12px;

          margin-top: 24px;
        }

        .section-{{ section.id }} .research-mentions__dot {
          width: 13px;
          height: 13px;
          padding: 0;

          border: 0;
          border-radius: 50%;
          background: var(--rm-dot-color);

          cursor: pointer;
          transition:
            background-color 0.2s ease,
            transform 0.2s ease;
        }

        .section-{{ section.id }} .research-mentions__dot.is-active {
          background: var(--rm-dot-active-color);
          transform: scale(1.08);
        }

        .section-{{ section.id }} .research-mentions__dot:focus-visible {
          outline: 2px solid var(--rm-dot-active-color);
          outline-offset: 4px;
        }

        @media screen and (min-width: 750px) {
          .section-{{ section.id }} .research-mentions__slide {
            flex-basis: calc((100% - var(--rm-card-gap)) / 2);
          }


        }

       @media screen and (max-width: 600px) {
        .section-{{ section.id }} .research-mentions__card {
          min-height: 170px;
          padding: 24px 20px;

          grid-template-rows:
            64px
            minmax(58px, auto);
        }

        .section-{{ section.id }} .research-mentions__logo-wrap {
          height: 64px;
        }

        .section-{{ section.id }} .research-mentions__header {
          margin: 0 auto 24px;
        }
      }

        @media screen and (min-width: 990px) {

          .section-{{ section.id }} {
            padding-block:
              var(--rm-padding-top)
              var(--rm-padding-bottom);
          }

          .section-{{ section.id }} .research-mentions__inner {
            padding-inline: 40px;
          }



          .section-{{ section.id }} .research-mentions__heading {
            font-size: var(--rm-heading-size);
          }

          .section-{{ section.id }} .research-mentions__subheading {
            font-size: var(--rm-subheading-size);
          }

          .section-{{ section.id }} .research-mentions__track {
            display: grid;
            grid-template-columns: repeat(
              var(--rm-desktop-columns),
              minmax(0, 1fr)
            );
            gap: var(--rm-card-gap);

            overflow: visible;
            scroll-snap-type: none;
          }

          .section-{{ section.id }} .research-mentions__slide {
            min-width: 0;
          }

          .section-{{ section.id }} .research-mentions__card {
        height: {{ section.settings.card_height }}px;
        min-height: 0;

        grid-template-rows:
          minmax(74px, auto)
          minmax(58px, 1fr);

        padding:
          {{ section.settings.card_padding_vertical }}px
          {{ section.settings.card_padding_horizontal }}px;
      }

          .section-{{ section.id }} .research-mentions__quote {
            font-size: var(--rm-card-text-size);
          }

          .section-{{ section.id }} .research-mentions__dots {
            display: none;
          }
        }

        @media (prefers-reduced-motion: reduce) {
          .section-{{ section.id }} .research-mentions__track {
            scroll-behavior: auto;
          }

          .section-{{ section.id }} .research-mentions__dot {
            transition: none;
          }
        }
{% endstyle %}

<section
  id="research-mentions-{{ section.id }}"
  class="research-mentions section-{{ section.id }}"
  data-research-mentions
>
  <div class="research-mentions__inner">
    {%- if section_heading != blank or section_subheading != blank -%}
      <header class="research-mentions__header">
        {%- if section_heading != blank -%}
          <h2 class="research-mentions__heading">
            {{ section_heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section_subheading != blank -%}
          <div class="research-mentions__subheading">
            {{ section_subheading }}
          </div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="research-mentions__viewport">
        <ul
          class="research-mentions__track"
          data-research-track
          style="--rm-desktop-columns: {{ section.settings.desktop_columns }};"
        >
          {%- for block in section.blocks -%}
            <li
              class="research-mentions__slide"
              data-research-slide
              {{ block.shopify_attributes }}
            >
              <article
                class="research-mentions__card"
                style="
                  --rm-logo-width: {{ block.settings.logo_width }}px;
                  --rm-logo-height: {{ block.settings.logo_height }}px;
                  --rm-logo-text-size: {{ block.settings.logo_text_size }}px;
                "
              >
                {%- if block.settings.logo != blank or block.settings.logo_text != blank -%}
                  <div class="research-mentions__logo-wrap">
                    {%- if block.settings.logo != blank -%}
                      {{
                        block.settings.logo
                        | image_url: width: 600
                        | image_tag:
                          loading: 'lazy',
                          widths: '160, 240, 320, 480, 600',
                          class: 'research-mentions__logo',
                          alt: block.settings.logo.alt
                      }}
                    {%- else -%}
                      <span class="research-mentions__logo-text">
                        {{ block.settings.logo_text | escape }}
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.quote != blank -%}
                  <blockquote class="research-mentions__quote">
                    {{ block.settings.quote }}
                  </blockquote>
                {%- endif -%}
              </article>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- if section.blocks.size > 1 -%}
        <div
          class="research-mentions__dots"
          data-research-dots
          aria-label="Slider navigation"
        >
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="research-mentions__dot{% if forloop.first %} is-active{% endif %}"
              data-research-dot
              data-slide-index="{{ forloop.index0 }}"
              aria-label="Show slide {{ forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {% if section.settings.show_bottom_text and section.settings.bottom_text != blank %}
      <div class="research-mentions__bottom-text">
        {{ section.settings.bottom_text }}
      </div>
    {% endif %}
  </div>
</section>

<script>
  (() => {
    const section = document.querySelector('#research-mentions-{{ section.id }}');

    if (!section || section.dataset.sliderInitialized === 'true') return;

    const track = section.querySelector('[data-research-track]');
    const slides = Array.from(section.querySelectorAll('[data-research-slide]'));
    const dots = Array.from(section.querySelectorAll('[data-research-dot]'));

    if (!track || slides.length < 2 || dots.length === 0) return;

    section.dataset.sliderInitialized = 'true';

    const setActiveDot = (index) => {
      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === index;

        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
    };

    const getClosestSlideIndex = () => {
      const trackRect = track.getBoundingClientRect();
      const trackCenter = trackRect.left + trackRect.width / 2;

      let closestIndex = 0;
      let closestDistance = Infinity;

      slides.forEach((slide, index) => {
        const slideRect = slide.getBoundingClientRect();
        const slideCenter = slideRect.left + slideRect.width / 2;
        const distance = Math.abs(slideCenter - trackCenter);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    };

    let scrollFrame = null;

    track.addEventListener(
      'scroll',
      () => {
        if (scrollFrame) {
          cancelAnimationFrame(scrollFrame);
        }

        scrollFrame = requestAnimationFrame(() => {
          setActiveDot(getClosestSlideIndex());
        });
      },
      { passive: true }
    );

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.dataset.slideIndex);
        const slide = slides[index];

        if (!slide) return;

        slide.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest',
          inline: 'center',
        });

        setActiveDot(index);
      });
    });
  })();
</script>

