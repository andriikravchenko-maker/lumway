    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Animation duration",
      "min": 400,
      "max": 2400,
      "step": 100,
      "unit": "ms",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Layout"
    },
