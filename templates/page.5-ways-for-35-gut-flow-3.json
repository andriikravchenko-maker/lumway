            "line_height": 1.2,
            "margin_bottom": 24
          }
        },
        "text_KYVE8X": {
          "type": "text",
          "settings": {
            "text": "<p><strong>I still enjoy dinner out. I still eat dessert. My meals aren’t perfect every day.</strong><br/>But I no longer respond to every bloated evening by punishing myself with another restrictive diet.<br/><br/>I understand the difference between gaining body fat and temporarily feeling heavy because my digestion is off. And I know that <strong>feeling better</strong> in my clothes <strong>isn’t always about becoming smaller. </strong><br/><br/>Sometimes it begins with supporting the body you already have.</p>",
            "color": "#111111",
            "font_size": 18,
            "font_size_mobile": 16,
            "font_weight": "400",
            "line_height": 1.4,
            "margin_bottom": 24
          }
        },
        "quote_callout_789Kmg": {
          "type": "quote_callout",
          "settings": {
            "text": "<p>That's why Gut Flow earned a permanent place in my daily routine. It made supporting my gut feel simple enough to stay consistent with and that changed far more than another restrictive diet ever did.</p>",
            "background_color": "#f9f9f9",
            "text_color": "#5b0d1e",
            "border_color": "#5b0d1e",
            "border_width": 2,
