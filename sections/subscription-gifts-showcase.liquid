{%- comment -%}
Subscription Gifts Showcase

Select the main subscription product in the section settings.
Gift cards are generated from:
product.metafields.custom.subscription_gifts

Each metaobject is matched to the product selling plan by:
gift.selling_plan_id == selling_plan.id

All visible marketing text can be overridden in section settings.
Per-card title/button/free-label overrides fall back to Recharge/product data when left blank.
{%- endcomment -%}

{%- liquid
  assign selected_product = section.settings.product
  assign subscription_gifts = selected_product.metafields.custom.subscription_gifts.value

  assign heading = section.settings.heading | default: 'Free Gifts With Subscription'
  assign button_label = section.settings.button_label | default: 'Choose the plan'
  assign free_label = section.settings.free_label | default: 'Free'
  assign featured_badge_label = section.settings.featured_badge | default: 'Most popular'

  assign featured_position = section.settings.featured_position | default: '2' | plus: 0

  assign base_compare = selected_product.variants.first.compare_at_price
  if base_compare == blank or base_compare <= 0
    assign base_compare = selected_product.variants.first.price
  endif
-%}

{%- if selected_product != blank and subscription_gifts != blank -%}
  <section
          id="SubscriptionGiftsShowcase-{{ section.id }}"
          class="subscription-showcase"
          style="
                  --sgs-section-bg: {{ section.settings.section_bg }};
                  --sgs-heading-color: {{ section.settings.heading_color }};
                  --sgs-plan-title-color: {{ section.settings.plan_title_color }};
                  --sgs-text-color: {{ section.settings.text_color }};
                  --sgs-card-bg: {{ section.settings.card_bg }};
                  --sgs-featured-bg: {{ section.settings.featured_card_bg }};
                  --sgs-button-bg: {{ section.settings.button_bg }};
                  --sgs-button-color: {{ section.settings.button_color }};
                  --sgs-button-secondary-bg: {{ section.settings.button_secondary_bg }};
                  --sgs-button-secondary-color: {{ section.settings.button_secondary_color }};

                  --sgs-button-secondary-hover-bg: {{ section.settings.button_secondary_hover_bg }};
                  --sgs-button-secondary-hover-color: {{ section.settings.button_secondary_hover_color }};

                  --sgs-button-hover-bg: {{ section.settings.button_hover_bg }};
                  --sgs-button-hover-color: {{ section.settings.button_hover_color }};

                  --sgs-price-bg: {{ section.settings.price_badge_bg }};
                  --sgs-price-color: {{ section.settings.price_badge_color }};
                  --sgs-badge-bg: {{ section.settings.featured_badge_bg }};
                  --sgs-badge-color: {{ section.settings.featured_badge_color }};

                  --sgs-heading-size: {{ section.settings.heading_size }}px;
                  --sgs-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
                  --sgs-heading-line-height: {{ section.settings.heading_line_height }}%;
                  --sgs-heading-max-width: {{ section.settings.heading_max_width }}px;

                  --sgs-grid-gap: {{ section.settings.grid_gap }}px;
                  --sgs-grid-gap-mobile: {{ section.settings.grid_gap_mobile }}px;

                  --sgs-card-min-height: {{ section.settings.card_min_height }}px;
                  --sgs-card-min-height-mobile: {{ section.settings.card_min_height_mobile }}px;
                  --sgs-card-radius: {{ section.settings.card_radius }}px;
                  --sgs-card-radius-mobile: {{ section.settings.card_radius_mobile }}px;

                  --sgs-card-padding-top: {{ section.settings.card_padding_top }}px;
                  --sgs-card-padding-x: {{ section.settings.card_padding_x }}px;
                  --sgs-card-padding-bottom: {{ section.settings.card_padding_bottom }}px;

                  --sgs-card-padding-top-mobile: {{ section.settings.card_padding_top_mobile }}px;
                  --sgs-card-padding-x-mobile: {{ section.settings.card_padding_x_mobile }}px;
                  --sgs-card-padding-bottom-mobile: {{ section.settings.card_padding_bottom_mobile }}px;

                  --sgs-featured-badge-top: {{ section.settings.featured_badge_top }}px;
                  --sgs-featured-badge-font-size: {{ section.settings.featured_badge_font_size }}px;
                  --sgs-featured-badge-padding-y: {{ section.settings.featured_badge_padding_y }}px;
                  --sgs-featured-badge-padding-x: {{ section.settings.featured_badge_padding_x }}px;

                  --sgs-plan-title-size: {{ section.settings.plan_title_size }}px;
                  --sgs-plan-title-size-mobile: {{ section.settings.plan_title_size_mobile }}px;
                  --sgs-plan-title-line-height: {{ section.settings.plan_title_line_height }}%;
                  --sgs-plan-title-bottom: {{ section.settings.plan_title_bottom_spacing }}px;

                  --sgs-gift-title-size: {{ section.settings.gift_title_size }}px;
                  --sgs-gift-title-size-mobile: {{ section.settings.gift_title_size_mobile }}px;
                  --sgs-gift-title-line-height: {{ section.settings.gift_title_line_height }}%;

                  --sgs-value-top: {{ section.settings.value_top_spacing }}px;
                  --sgs-value-font-size: {{ section.settings.value_font_size }}px;
