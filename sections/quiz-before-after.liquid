      "default": "Gut problems are a drag, your days don't have to be."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ]
    },
    { "type": "textarea", "id": "before_title", "label": "Before card title", "default": "Life before\nGut Flow" },
    { "type": "textarea", "id": "after_title", "label": "After card title", "default": "Life after\nGut Flow" },
    { "type": "image_picker", "id": "illustration", "label": "Illustration" },
    {
      "type": "text",
      "id": "illustration_alt",
      "label": "Illustration alt text",
      "default": "Gut Flow lifestyle illustration"
    },
    { "type": "header", "content": "Icons" },
    { "type": "html", "id": "before_icon_svg", "label": "Before — Custom SVG" },
    { "type": "image_picker", "id": "before_icon", "label": "Before — Image" },
    { "type": "html", "id": "after_icon_svg", "label": "After — Custom SVG" },
    { "type": "image_picker", "id": "after_icon", "label": "After — Image" },
    { "type": "color", "id": "before_icon_color", "label": "Before icon color", "default": "#E34E55" },
    { "type": "color", "id": "after_icon_color", "label": "After icon color", "default": "#28795B" },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "Icon / text gap",
      "min": 4,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    { "type": "header", "content": "Colors" },
