        "text_EbLQTy": {
          "type": "text",
          "settings": {
            "text": "<p>Instead, I noticed smaller, more believable changes first:</p>",
            "color": "#111111",
            "font_size": 18,
            "font_size_mobile": 16,
            "font_weight": "400",
            "line_height": 1.4,
            "margin_bottom": 16
