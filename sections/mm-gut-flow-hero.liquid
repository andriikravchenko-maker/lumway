{{ section.settings.review_text }}
</span>
                        {%- endif -%}

                    </div>
                {%- endif -%}


                {%- if section.settings.heading != blank -%}
                    <h1 class="gfh__heading">
                        {{ section.settings.heading }}
                    </h1>
                {%- endif -%}


                {%- if section.settings.description != blank -%}
                    <div class="gfh__description rte">
                        {{ section.settings.description }}
                    </div>
                {%- endif -%}


                {%- if section.settings.button_label != blank -%}
                    <div class="gfh__button-wrap">
                        {%- if section.settings.button_action == 'scroll' -%}
                            <button
                                    type="button"
                                    class="gfh__button"
                                    data-gfh-scroll-button
                                    data-scroll-selector="{{ section.settings.button_target_selector | escape }}"
                                    data-scroll-offset-desktop="{{ section.settings.button_scroll_offset }}"
                                    data-scroll-offset-mobile="{{ section.settings.mobile_button_scroll_offset }}"
                                    data-scroll-behavior="{{ section.settings.button_scroll_behavior }}"
                                    aria-label="{{ section.settings.button_label | escape }}"
                            >
                                {{ section.settings.button_label }}
                            </button>
                        {%- else -%}
                            <a
                                    class="gfh__button"
                                    {% if section.settings.button_link != blank %}
                                        href="{{ section.settings.button_link }}"
                                    {% else %}
                                        role="link"
                                        aria-disabled="true"
                                    {% endif %}
                            >
                                {{ section.settings.button_label }}
                            </a>
                        {%- endif -%}
                    </div>
                {%- endif -%}


                {%- if section.settings.show_trust_line and section.settings.trust_text != blank -%}
                    <div class="gfh__trust">

                        {%- if section.settings.show_trust_icon -%}
                            <span class="gfh__trust-icon" aria-hidden="true">

{%- if section.settings.trust_icon != blank -%}
    {{
    section.settings.trust_icon
    | image_url: width: 80
    | image_tag:
    class: 'gfh__trust-custom-icon',
    loading: 'lazy'
    }}
{%- else -%}

    <svg viewBox="0 0 24 24">
<path d="M12 2.25l2.17 2.06 2.96-.42.52 2.94 2.65 1.39-1.31 2.69 1.31 2.69-2.65 1.39-.52 2.94-2.96-.42L12 19.57l-2.17-2.06-2.96.42-.52-2.94-2.65-1.39 1.31-2.69L3.7 8.22l2.65-1.39.52-2.94 2.96.42L12 2.25zm3.45 7.04a.75.75 0 00-1.06 0l-3.2 3.2-1.58-1.58a.75.75 0 10-1.06 1.06l2.11 2.11a.75.75 0 001.06 0l3.73-3.73a.75.75 0 000-1.06z"/>
