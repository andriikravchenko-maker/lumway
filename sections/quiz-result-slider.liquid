{%- comment -%}
Offer slide: the product buy box, rendered from the same snippets as the PDP (product-details-lum),
configured with the Offer blocks. Continue on this slide submits the buy box form (product + subscription
gifts) and the add-to-cart snippet opens the checkout (block setting after_add = checkout).
{%- endcomment -%}
{% if offer_enabled %}
{%- assign qo_has_form = false -%}
{%- for block in section.blocks -%}
{%- if block.type == 'add_to_cart' -%}{%- assign qo_has_form = true -%}{%- endif -%}
{%- endfor -%}
<div
class="quiz-result-slider__slide quiz-result-slider__slide--offer"
data-quiz-slide="4"
data-quiz-offer
hidden
>
<div class="quiz-result-slider__container quiz-result-slider__container--offer">
<div class="quiz-offer">
<div class="quiz-offer__media">
{%- render 'product-gallery-lum', product: checkout_product -%}
</div>
<div class="quiz-offer__info">
{%- if request.design_mode and qo_has_form == false -%}
<div style="padding:16px;border:1px dashed #ccc;border-radius:8px;color:#666;font:14px sans-serif;text-align:center">Offer slide: add the "Offer: Add to cart" block, it renders the product form that Continue submits.</div>
{%- endif -%}
{%- assign qo_combo_open = false -%}
{%- for block in section.blocks -%}
{%- assign qo_next_type = '' -%}
{%- assign qo_next_index = forloop.index0 | plus: 1 -%}
{%- if qo_next_index < section.blocks.size -%}
{%- assign qo_next_type = section.blocks[qo_next_index].type -%}
{%- endif -%}
{%- case block.type -%}
{%- when 'rating' -%}
<div class="pdl-rating" {{ block.shopify_attributes }}>
{%- if block.settings.stars > 0 -%}
<span class="pdl-rating__stars" aria-hidden="true">
{%- for i in (1..block.settings.stars) -%}
<span class="pdl-rating__star">{{ 'lum-icon-star.svg' | inline_asset_content }}</span>
{%- endfor -%}
</span>
{%- endif -%}
{%- if block.settings.text != blank -%}
<span class="pdl-rating__text">{{ block.settings.text | escape }}</span>
{%- endif -%}
</div>
{%- when 'title' -%}
{%- assign qo_heading = block.settings.heading | default: checkout_product.title -%}
<h2 class="pdl-title" style="--pdl-title-color: {{ block.settings.text_color }}; --pdl-title-weight: {{ block.settings.font_weight }};" {{ block.shopify_attributes }}>{{ qo_heading | escape }}</h2>
{%- when 'subtitle' -%}
{%- if block.settings.text != blank -%}
<div class="pdl-subtitle" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
{%- endif -%}
{%- when 'labels' -%}
<ul class="pdl-labels" {{ block.shopify_attributes }}>
{%- for i in (1..6) -%}
{%- assign sk = 'chip_' | append: i | append: '_show' -%}
{%- assign tk = 'chip_' | append: i | append: '_text' -%}
{%- if block.settings[sk] and block.settings[tk] != blank -%}
<li class="pdl-chip">
<span class="pdl-chip__icon">{{ 'lum-icon-tick.svg' | inline_asset_content }}</span
><span class="pdl-chip__text">{{ block.settings[tk] | escape }}</span>
</li>
{%- endif -%}
{%- endfor -%}
</ul>
{%- when 'mm_bundle_select' -%}
{%- if qo_next_type == 'mm_purchase_plan' -%}
{%- assign qo_combo_open = true -%}
<div class="pdl__combo">
{%- endif -%}
{%- render 'mm-bundle-select-lum', block: block, product: checkout_product -%}
{%- when 'mm_purchase_plan' -%}
{%- render 'mm-purchase-plan-lum', block: block, product: checkout_product -%}
{%- if qo_combo_open -%}
</div>
{%- assign qo_combo_open = false -%}
{%- endif -%}
{%- when 'add_to_cart' -%}
{%- render 'mm-add-to-cart-lum-speed', block: block, product: checkout_product -%}
{%- when 'info_cards' -%}
{%- render 'info-cards-lum', block: block -%}
{%- endcase -%}
{%- endfor -%}
</div>
</div>
</div>
</div>
{% endif %}

</div>


</div>

<div class="quiz-result-slider__footer">

{% if section.settings.show_back_button %}
<button
type="button"
class="quiz-result-slider__back"
data-quiz-back
>
<span aria-hidden="true">←</span>
<span>{{ section.settings.back_label }}</span>
</button>
{% endif %}

<button
type="button"
class="quiz-result-slider__continue"
data-quiz-continue
{% if checkout_variant == blank %}
disabled
{% elsif offer_enabled == false and section.settings.checkout_plan_index != 'one_time' and checkout_selling_plan == blank %}
disabled
{% endif %}
>
<span data-continue-label>
{{ section.settings.continue_label }}
</span>
</button>
</div>

{% if request.design_mode and checkout_product %}
<div style="display:none;" data-quiz-checkout-debug>
Selected product: {{ checkout_product.title }}
Selected variant: {{ checkout_variant.title }} ({{ checkout_variant.id }})
{% if checkout_selling_plan %}
Selected selling plan: {{ checkout_selling_plan.name }} ({{ checkout_selling_plan.id }})
{% else %}
Selected selling plan: One-time / none
{% endif %}
</div>
{% endif %}

</div>

</section>


<style>

#QuizResultSlider-{{ section.id }} {
background: var(--qrs-bg);
color: var(--qrs-text);
font-family: "Fraunces", Georgia, sans-serif;
}

#QuizResultSlider-{{ section.id }} * {
box-sizing: border-box;
}

#QuizResultSlider-{{ section.id }} .quiz-result-slider__content[hidden] {
display: none !important;
}

/* While the loader is active, never render the result viewport or sticky footer. */
#QuizResultSlider-{{ section.id }}.is-loading .quiz-result-slider__viewport,
#QuizResultSlider-{{ section.id }}.is-loading .quiz-result-slider__footer {
display: none !important;
}

#QuizResultSlider-{{ section.id }} .quiz-result-loader {
display: grid;
width: 100%;
min-height: 100svh;
place-items: center;
padding: 60px 24px;
background: {{ section.settings.loader_background }};
color: {{ section.settings.loader_text_color }};
text-align: center;
}
#QuizResultSlider-{{ section.id }} .quiz-result-loader__inner { width: min(100%, 650px); }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__stars { color: {{ section.settings.loader_star_color }}; font-family: Arial,sans-serif; font-size: {{ section.settings.loader_star_size_desktop }}px; letter-spacing: 3px; line-height: 1; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__review-title { margin: 22px auto 18px; max-width: 620px; color: inherit; font-family: 'Fraunces',Georgia,serif; font-size: {{ section.settings.loader_title_size_desktop }}px; line-height: 1.12; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__review-text { margin-inline:auto; max-width:620px; font-family:Arial,Helvetica,sans-serif; font-size: {{ section.settings.loader_body_size_desktop }}px; line-height:1.55; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__review-text p { margin:0; }
#QuizResultSlider-{{ section.id }} .quiz-result-loader__customer { display:flex; justify-content:center; flex-wrap:wrap; gap:7px; margin-top:20px; font-family:Arial,Helvetica,sans-serif; font-size: {{ section.settings.loader_customer_size_desktop }}px; }
